package tool

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"

    "github.com/martianoff/galop/diag"
    "github.com/martianoff/galop/g4"
)

// importCase is a set of grammar files and the galop command line to run on them.
struct importCase(Files Array[Tuple[string, string]], Line string)

// outputOf runs c's command line on c's files and gives what it printed,
// stdout then stderr.
func outputOf(c importCase) string {
    val m = newMemory()
    m.files = c.Files.FoldLeft(m.files, (acc, f) => acc.Put(f.V1, f.V2))
    val out = run(m, ArrayOf(fakeGo), c.Line)
    out.Stdout + out.Stderr
}

val lexL = ("L.g4", "lexer grammar L;\nA: 'x';\nB: 'b';\nWS: ' ' -> skip;\n")

// The messages and positions are ANTLR 4.13.1's for the same files, except
// that a diagnostic in an imported rule always names the imported file (see
// docs/DESIGN.md, Grammar imports).
func TestImports(t T) T = RunCases[importCase, string](t,
    (sub, in, want) => Eq(sub, outputOf(in), want),
    Case[importCase, string](
        Name = "the root's rule wins over the imported one",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport L;\ns: A B EOF;\nA: 'a';\n"), lexL), "-check R.g4"),
        Expected = "R.g4: ok (grammar R: 1 parser rules, 3 lexer rules)\n",
    ),
    Case[importCase, string](
        Name = "found next to the importing grammar",
        Input = importCase(ArrayOf(("g/R.g4", "grammar R;\nimport L;\ns: A EOF;\n"), ("g/L.g4", "lexer grammar L;\nA: 'a';\n")), "-check g/R.g4"),
        Expected = "g/R.g4: ok (grammar R: 1 parser rules, 1 lexer rules)\n",
    ),
    Case[importCase, string](
        Name = "found in the -lib directory",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport L;\ns: A EOF;\n"), ("lib/L.g4", "lexer grammar L;\nA: 'a';\n")), "-check -lib lib R.g4"),
        Expected = "R.g4: ok (grammar R: 1 parser rules, 1 lexer rules)\n",
    ),
    Case[importCase, string](
        Name = "an alias loads the named grammar",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport Short = L;\ns: A B EOF;\n"), lexL), "-check R.g4"),
        Expected = "R.g4: ok (grammar R: 1 parser rules, 3 lexer rules)\n",
    ),
    // ANTLR prints R.g4:3:3 here: the root's file with Q.g4's position.
    Case[importCase, string](
        Name = "imports of imports, a circular one ignored",
        Input = importCase(ArrayOf(
            ("R.g4", "grammar R;\nimport P;\ns: t EOF;\n"),
            ("P.g4", "parser grammar P;\nimport Q;\nt: u;\n"),
            ("Q.g4", "parser grammar Q;\nimport P;\nu: A;\n"),
        ), "-check R.g4"),
        Expected = "R.g4: ok (grammar R: 3 parser rules, 0 lexer rules)\n" +
            "warning(125): Q.g4:3:3: implicit definition of token A in parser\n",
    ),
    // ANTLR prints R.g4:3:0: the root's file with E.g4's position.
    Case[importCase, string](
        Name = "a compile error in an imported rule names its file",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport E;\ns: e EOF;\nA: 'a';\n"), ("E.g4", "parser grammar E;\n\ne: e '+' e;\n")), "-check R.g4"),
        Expected = "error(147): E.g4:3:0: left recursive rule e must contain an alternative which is not left recursive\n",
    ),
    Case[importCase, string](
        Name = "missing",
        Input = importCase(ArrayOf(("M.g4", "grammar M;\nimport Nope;\ns: A EOF;\nA: 'a';\n")), "-check M.g4"),
        Expected = "error(110): M.g4:2:7: can't find or load grammar Nope\n",
    ),
    Case[importCase, string](
        Name = "a lexer cannot import a parser",
        Input = importCase(ArrayOf(("X.g4", "lexer grammar X;\nimport P;\nA: 'a';\n"), ("P.g4", "parser grammar P;\ns: A;\n")), "-check X.g4"),
        Expected = "error(111): X.g4:2:7: lexer grammar X cannot import parser grammar P\n" +
            "error(53): P.g4:2:0: parser rule s not allowed in lexer\n",
    ),
    Case[importCase, string](
        Name = "importing the lexer the grammar generates",
        Input = importCase(ArrayOf(("Q.g4", "grammar Q;\nimport QLexer;\ns: A EOF;\n"), ("QLexer.g4", "lexer grammar QLexer;\nA: 'a';\n")), "-check Q.g4"),
        Expected = "error(113): Q.g4:2:7: combined grammar Q and imported lexer grammar QLexer both generate QLexer\n",
    ),
    Case[importCase, string](
        Name = "options in an imported grammar",
        Input = importCase(ArrayOf(("O.g4", "grammar O;\nimport OL;\ns: A EOF;\n"), ("OL.g4", "lexer grammar OL;\noptions { superClass = Base; }\nA: 'a';\n")), "-check O.g4"),
        Expected = "O.g4: ok (grammar O: 1 parser rules, 1 lexer rules)\n" +
            "warning(109): OL.g4:2:0: options ignored in imported grammar OL\n",
    ),
    Case[importCase, string](
        Name = "a problem in an imported rule names its file",
        Input = importCase(ArrayOf(("U.g4", "grammar U;\nimport UP;\nA: 'a';\n"), ("UP.g4", "parser grammar UP;\ns: t A;\n")), "-check U.g4"),
        Expected = "error(56): UP.g4:2:3: reference to undefined rule: t\n",
    ),
    Case[importCase, string](
        Name = "an imported grammar with a syntax error",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport L;\ns: A EOF;\n"), ("L.g4", "lexer grammar L;\nA 'a';\n")), "-check R.g4"),
        Expected = "error(50): L.g4:2:2: syntax error: expected ':', found 'a'\n",
    ),
    Case[importCase, string](
        // ANTLR's -depend never loads imported grammars, so it lists none.
        Name = "-depend lists no imported files, as ANTLR's",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport L;\ns: A B EOF;\n"), lexL), "-depend R.g4"),
        Expected = "r_galop_lexer.go : R.g4\n",
    ),
    Case[importCase, string](
        Name = "each import of a missing grammar is reported",
        Input = importCase(ArrayOf(
            ("R.g4", "grammar R;\nimport A, B;\ns: x y EOF;\nT: [t];\n"),
            ("A.g4", "parser grammar A;\nimport Missing;\nx: T;\n"),
            ("B.g4", "parser grammar B;\nimport Missing;\ny: T;\n"),
        ), "-check R.g4"),
        Expected = "error(110): A.g4:2:7: can't find or load grammar Missing\n" +
            "error(110): B.g4:2:7: can't find or load grammar Missing\n",
    ),
    Case[importCase, string](
        Name = "a grammar imported directly and through another is checked",
        Input = importCase(ArrayOf(
            ("X.g4", "lexer grammar X;\nimport L1, P;\nA: 'a';\n"),
            ("L1.g4", "lexer grammar L1;\nimport P;\nB: 'b';\n"),
            ("P.g4", "parser grammar P;\nr: A;\n"),
        ), "-check X.g4"),
        Expected = "error(111): X.g4:2:11: lexer grammar X cannot import parser grammar P\n" +
            "error(53): P.g4:2:0: parser rule r not allowed in lexer\n",
    ),
    // ANTLR names the imported grammar where a file name goes.
    Case[importCase, string](
        Name = "an imported grammar that cannot be read",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport Unreadable;\ns: A EOF;\nA: 'a';\n"), ("Unreadable.g4", "lexer grammar Unreadable;\nB: 'b';\n")), "-check R.g4"),
        Expected = "error(11): Unreadable:2:7: error reading imported grammar Unreadable referenced in R\n",
    ),
    Case[importCase, string](
        Name = "a comment in the import statement",
        Input = importCase(ArrayOf(("Q.g4", "grammar Q;\nimport /* Bob's lexer */ L;\ns: A EOF;\n"), ("L.g4", "lexer grammar L;\nA: 'a';\n")), "-check Q.g4"),
        Expected = "Q.g4: ok (grammar Q: 1 parser rules, 1 lexer rules)\n",
    ),
    Case[importCase, string](
        Name = "a rule an imported grammar repeats is taken once",
        Input = importCase(ArrayOf(("D.g4", "grammar D;\nimport DL;\ns: A EOF;\n"), ("DL.g4", "lexer grammar DL;\nA: 'a';\nA: 'b';\n")), "-check D.g4"),
        Expected = "D.g4: ok (grammar D: 1 parser rules, 1 lexer rules)\n",
    ),
    Case[importCase, string](
        Name = "options a -D option makes the same",
        Input = importCase(ArrayOf(("O.g4", "grammar O;\nimport OL;\ns: A EOF;\n"), ("OL.g4", "lexer grammar OL;\noptions { language = Go; }\nA: 'a';\n")), "-check -Dlanguage=Go O.g4"),
        Expected = "O.g4: ok (grammar O: 1 parser rules, 1 lexer rules)\n",
    ),
    Case[importCase, string](
        Name = "options that differ only in quotes",
        Input = importCase(ArrayOf(("O.g4", "grammar O;\noptions { superClass = 'Base'; }\nimport OL;\ns: A EOF;\n"), ("OL.g4", "lexer grammar OL;\noptions { superClass = Base; }\nA: 'a';\n")), "-check O.g4"),
        Expected = "O.g4: ok (grammar O: 1 parser rules, 1 lexer rules)\n",
    ),
    // ANTLR's default language is Java, so the imported Go differs.
    Case[importCase, string](
        Name = "an option against ANTLR's default",
        Input = importCase(ArrayOf(("O.g4", "grammar O;\nimport OL;\ns: A EOF;\n"), ("OL.g4", "lexer grammar OL;\noptions { language = Go; }\nA: 'a';\n")), "-check O.g4"),
        Expected = "O.g4: ok (grammar O: 1 parser rules, 1 lexer rules)\n" +
            "warning(109): OL.g4:2:0: options ignored in imported grammar OL\n",
    ),
    Case[importCase, string](
        Name = "-depend does not need the imported grammars",
        Input = importCase(ArrayOf(("M.g4", "grammar M;\nimport Nope;\ns: A EOF;\nA: [a];\n")), "-depend M.g4"),
        Expected = "m_galop_lexer.go : M.g4\n",
    ),
    Case[importCase, string](
        Name = "-format prints the grammar as written",
        Input = importCase(ArrayOf(("R.g4", "grammar R;\nimport L;\ns: A B EOF;\n"), lexL), "-format R.g4"),
        Expected = "grammar R;\n\nimport L;\n\ns: A B EOF;\n",
    ),
)

// TestMergeImportsCombinesNamedActions checks ANTLR's merge of named actions:
// the same action in the root and an imported grammar becomes one, the root's
// text first.
func TestMergeImportsCombinesNamedActions(t T) T {
    val root = g4.Parse("grammar R;\n@members { a }\ns: A;\nA: 'a';\n")
    val del = g4.Parse("parser grammar D;\n@parser::members { b }\n@header { h }\nt: A;\n")
    (root, del) match {
        case (Right(r), Right(d)) => {
            val (merged, problems) = mergeImports(r, Imported(ArrayOf(g4.InFile(d, "D.g4")), EmptyArray[diag.Diagnostic]()), EmptyArray[g4.OptionEntry]())
            val t1 = Eq(t, problems.Size(), 0)
            val t2 = Eq(t1, merged.Actions.Map((a) => a.Name + "=" + a.Body), ArrayOf("members= a \n b ", "header= h "))
            Eq(t2, merged.Rules.Map(_.Name), ArrayOf("s", "A", "t"))
        }
        case _ => Fail(t, "the grammars did not parse")
    }
}


// TestMergeImportsActionsOnlyJoinTheRoots checks that only an action the root
// grammar has collects the imported ones' text: two imported grammars with the
// same action the root lacks both keep theirs, as in ANTLR (which then reports
// error 94).
func TestMergeImportsActionsOnlyJoinTheRoots(t T) T {
    val grammars = ArrayOf(
        "grammar R;\n@header { r }\ns: A;\nA: 'a';\n",
        "parser grammar D1;\n@header { d1 }\n@members { a }\nx: A;\n",
        "parser grammar D2;\n@header { d2 }\n@members { b }\ny: A;\n",
    ).Map(g4.Parse)
    grammars match {
        case Array(Right(r), Right(d1), Right(d2)) => {
            val (merged, _) = mergeImports(r, Imported(ArrayOf(d1, d2), EmptyArray[diag.Diagnostic]()), EmptyArray[g4.OptionEntry]())
            Eq(t, merged.Actions.Map((a) => a.Name + "=" + a.Body), ArrayOf("header= r \n d1 \n d2 ", "members= a ", "members= b "))
        }
        case _ => Fail(t, "the grammars did not parse")
    }
}
