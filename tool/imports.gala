package tool

import (
    "path/filepath"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/diag"
    "github.com/martianoff/galop/g4"
)

// Grammar imports, as ANTLR 4.13.1 resolves them (Grammar.loadImportedGrammars,
// Tool.loadImportedGrammar, GrammarTransformPipeline.integrateImportedGrammars,
// BasicSemanticChecks.checkImport).
//
// Loading reads files, so it runs on the main goroutine before the front end
// (see Run); it gives plain data, Imported, that the front end merges.

// Imported is what loading found for one root grammar: every grammar it
// imports, directly or through another, in ANTLR's order
// (getAllImportedGrammars: each direct import, then its own, first occurrence
// of a file kept), each with its positions in its own file (g4.InFile, so its
// file is Pos.File), and the problems found reading them. Unreadable is set
// when an imported grammar has a syntax error: ANTLR stops there, after
// reporting it.
struct Imported(Delegates Array[g4.Grammar], Problems Array[diag.Diagnostic], Unreadable bool = false)

// NoImports is the result for a grammar without imports.
val NoImports = Imported(EmptyArray[g4.Grammar](), EmptyArray[diag.Diagnostic]())

// loader holds what ANTLR's Tool keeps while loading: the grammars read so far,
// by name, and the names of grammars whose imports were followed.
type loader struct {
    files Files
    libDir Option[string]
    var cache HashMap[string, g4.Grammar]
    var visited HashSet[string]
    var problems Array[diag.Diagnostic]
    var unreadable bool
}

// LoadImports reads the grammars root (the grammar in file path) imports.
func LoadImports(root g4.Grammar, path string, libDir Option[string], files Files) Imported {
    if root.Imports.IsEmpty() {
        return NoImports
    }
    val l = &loader{files: files, libDir: libDir, cache: EmptyHashMap[string, g4.Grammar](), visited: EmptyHashSet[string](), problems: EmptyArray[diag.Diagnostic](), unreadable: false}
    val all = l.load(root, path)
    // ANTLR keys the list by file, keeping each file's first place.
    val unique = all.FoldLeft(EmptyArray[g4.Grammar](), (acc, d) => if (acc.Exists((x) => x.Pos.File == d.Pos.File)) acc else acc.Append(d))
    Imported(unique, l.problems, l.unreadable)
}

// load reads g's imports and theirs, in ANTLR's order: each direct import,
// then the grammars it imports. path is g's file.
func (l Ptr[loader]) load(g g4.Grammar, path string) Array[g4.Grammar] {
    l.visited = l.visited.Add(g.Name)
    g.Imports.FoldLeft(EmptyArray[g4.Grammar](), (acc, imp) => {
        // A grammar already on the way here is a circular import: ignored.
        if l.visited.Contains(imp.Name) {
            return acc
        }
        l.delegate(imp, path, g.Name) match {
            case Some(d) => acc.Append(d).AppendAll(l.load(d, d.Pos.File))
            case None() => acc
        }
    })
}

// delegate is the grammar imp names, imported by the grammar importer in file
// from: read once, then cached by name as ANTLR's Tool caches it. As in
// ANTLR, only a grammar that loaded is cached, so each import of a missing
// one is reported.
func (l Ptr[loader]) delegate(imp g4.Import, from string, importer string) Option[g4.Grammar] = l.cache.Get(imp.Name) match {
    case Some(found) => Some(found)
    case None() => l.read(imp, from, importer)
}

// read reads and parses the grammar imp names, or reports why it cannot.
func (l Ptr[loader]) read(imp g4.Import, from string, importer string) Option[g4.Grammar] {
    val found = l.locate(imp.Name, from) match {
        case None() => {
            l.problems = l.problems.Append(g4.At(diag.CannotFindImportedGrammar.New(imp.Name), imp.Pos))
            None[g4.Grammar]()
        }
        case Some(file) => l.files.Read(file) match {
            case Failure(_) => {
                // ANTLR names the imported grammar where a file name goes.
                val at = imp.Pos.Copy(File = imp.Name)
                l.problems = l.problems.Append(g4.At(diag.ErrorReadingImportedGrammar.New(imp.Name, importer), at))
                None[g4.Grammar]()
            }
            case Success(text) => g4.Parse(text) match {
                case Left(d) => {
                    l.problems = l.problems.Append(d.In(file))
                    l.unreadable = true
                    None[g4.Grammar]()
                }
                case Right(g) => Some(g4.InFile(g, file))
            }
        }
    }
    found.ForEach((g) => {
        l.cache = l.cache.Put(imp.Name, g)
    })
    found
}

// locate finds the file of grammar name as ANTLR's Tool.getImportedGrammarFile
// does: name.g4 then name.g, each looked for in the working directory, then
// the importing grammar's directory, then the -lib directory.
func (l Ptr[loader]) locate(name string, from string) Option[string] {
    val dirs = ArrayOf(".", dirOf(from), l.libDir.GetOrElse("."))
    ArrayOf(name + ".g4", name + ".g")
        .FlatMap((file) => dirs.Map((dir) => filepath.ToSlash(filepath.Join(dir, file))))
        .Find((p) => l.files.Kind(p) match {
            case RegularFile() => true
            case _ => false
        })
}

// mergeImports is root with what it imports merged in, as ANTLR's
// integrateImportedGrammars merges it, and ANTLR's import diagnostics: root's
// rules come first and win over a delegate's rule of the same name, and each
// delegate adds its channels, tokens, named actions and remaining rules, in
// order. defines are the -D options.
func mergeImports(root g4.Grammar, imported Imported, defines Array[g4.OptionEntry]) Tuple[g4.Grammar, Array[diag.Diagnostic]] {
    if imported.Delegates.IsEmpty() {
        return (root, imported.Problems)
    }
    val scope = defaultActionScope(root)
    val rootActions = root.Actions.Map((a) => actionKey(a, scope))
    val start = (root, root.Rules.FoldLeft(EmptyHashSet[string](), (acc, r) => acc.Add(r.Name)))
    val (merged, _) = imported.Delegates.FoldLeft(start, (acc, del) => {
        val (g, names) = acc
        // A rule is taken if no rule of its name was taken before, the
        // delegate's own earlier rules included, as ANTLR's rootRuleNames.
        val (rules, taken) = del.Rules.FoldLeft((g.Rules, names), (rn, r) =>
            if (rn.V2.Contains(r.Name)) rn else (rn.V1.Append(r), rn.V2.Add(r.Name)))
        val next = g.Copy(
            Channels = g.Channels.AppendAll(del.Channels.Filter((c) => !g.Channels.Contains(c))),
            Tokens = g.Tokens.AppendAll(del.Tokens),
            Actions = mergeActions(g.Actions, del.Actions, rootActions, scope),
            Rules = rules,
        )
        (next, taken)
    })
    val checks = importChecks(root, imported.Delegates)
        .AppendAll(imported.Delegates.Collect({ case del if optionsDiffer(root, del, defines) =>
            g4.At(diag.OptionsInDelegate.New(del.Name), del.OptionsPos)
        }))
    (merged, imported.Problems.AppendAll(checks))
}

// defaultActionScope is the scope of a named action without one: ANTLR's
// Grammar.getDefaultActionScope.
func defaultActionScope(g g4.Grammar) string = g.Kind match {
    case g4.LexerOnly() => "lexer"
    case _ => "parser"
}

// actionKey is a named action's scope and name, with scope for an action
// written without one.
func actionKey(a g4.NamedAction, scope string) string = a.Scope.GetOrElse(scope) + "::" + a.Name

// mergeActions adds a delegate's named actions to the merged grammar's, as
// ANTLR's integrateImportedGrammars does: an action the root grammar itself
// has (rootActions, its keys) gets the delegate's text after its own on a new
// line; any other is added as it is, even when an earlier delegate has the
// same one (ANTLR then reports error 94, which galop does not check yet).
func mergeActions(into Array[g4.NamedAction], from Array[g4.NamedAction], rootActions Array[string], scope string) Array[g4.NamedAction] =
    from.FoldLeft(into, (acc, a) => {
        val k = actionKey(a, scope)
        if rootActions.Contains(k) {
            return acc.Map((x) => if (actionKey(x, scope) == k && rootActions.Contains(actionKey(x, scope))) x.Copy(Body = x.Body + "\n" + a.Body) else x)
        }
        acc.Append(a)
    })

// optionsDiffer says a delegate sets an option to a value the root does not,
// as ANTLR compares them (GrammarRootAST.getOptionString): a -D option first,
// then the grammar's value without its quotes, then ANTLR's default
// (language is Java). ANTLR then warns that the delegate's options are ignored.
func optionsDiffer(root g4.Grammar, del g4.Grammar, defines Array[g4.OptionEntry]) bool {
    val value = (g g4.Grammar, name string) => defines.FindLast((d) => d.Name == name).Map(_.Value)
        .OrElse(g.Options.FindLast((o) => o.Name == name).Map((o) => unquote(o.Value)))
        .OrElse(if (name == "language") Some("Java") else None[string]())
    del.Options.Exists((o) => value(del, o.Name) != value(root, o.Name))
}

// importChecks are ANTLR's checks of root's own imports (not of its
// delegates' imports): which kinds of grammar may import which (error 111),
// and a combined grammar importing the lexer or parser it generates (113).
func importChecks(root g4.Grammar, delegates Array[g4.Grammar]) Array[diag.Diagnostic] =
    root.Imports.FlatMap((imp) => delegates.Find((d) => d.Name == imp.Name) match {
        case None() => EmptyArray[diag.Diagnostic]()
        case Some(del) => {
            val invalid = if (validImport(root.Kind, del.Kind)) EmptyArray[diag.Diagnostic]()
                else ArrayOf(g4.At(diag.InvalidImport.New(kindName(root.Kind), root.Name, kindName(del.Kind), del.Name), imp.Pos))
            val clash = (root.Kind, del.Name) match {
                case (g4.Combined(), n) if n == root.Name + "Lexer" || n == root.Name + "Parser" =>
                    ArrayOf(g4.At(diag.ImportNameClash.New(kindName(root.Kind), root.Name, kindName(del.Kind), del.Name, recognizerName(del)), imp.Pos))
                case _ => EmptyArray[diag.Diagnostic]()
            }
            invalid.AppendAll(clash)
        }
    })

// validImport is ANTLR's validImportTypes: a lexer grammar can be imported by
// a lexer or combined grammar, a parser grammar by a parser or combined one,
// and a combined grammar by a combined one.
func validImport(importer g4.GrammarKind, delegate g4.GrammarKind) bool = (delegate, importer) match {
    case (g4.LexerOnly(), g4.LexerOnly()) => true
    case (g4.ParserOnly(), g4.ParserOnly()) => true
    case (_, g4.Combined()) => true
    case _ => false
}

// kindName is ANTLR's type string of a grammar: lexer, parser or combined.
func kindName(k g4.GrammarKind) string = k match {
    case g4.LexerOnly() => "lexer"
    case g4.ParserOnly() => "parser"
    case g4.Combined() => "combined"
}

// recognizerName is what ANTLR's getRecognizerName gives for a delegate in
// error 113: its name, with Parser after a combined grammar's. (ANTLR means to
// put the importing grammars' names first, but it asks the root grammar, which
// has no importers, for them.)
func recognizerName(del g4.Grammar) string = del.Kind match {
    case g4.Combined() => del.Name + "Parser"
    case _ => del.Name
}

// WithImports is g, the grammar in file path, with the grammars it imports
// merged in as the front end merges them, or the errors found doing so. It
// is for tools that read a grammar outside Run, such as galop-sample.
func WithImports(g g4.Grammar, path string, libDir Option[string], files Files) Either[Array[diag.Diagnostic], g4.Grammar] {
    val (merged, problems) = mergeImports(g, LoadImports(g, path, libDir, files), EmptyArray[g4.OptionEntry]())
    if (diag.HasErrors(problems)) Left(problems) else Right(merged)
}
