package analysis

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/go_builtins"
    . "martianoff/gala/test"

    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/brackets"
    "github.com/martianoff/galop/grammartest"
    "github.com/martianoff/galop/repair"
)

// analyzed compiles src and analyzes its parser network the way -report and
// code generation do, repair plan included.
func analyzed(src string, maxK int = MaxK) Tuple[atn.ATN, Analysis] {
    val (g, c) = grammartest.Compile(src)
    val a = c.Parser.Get()
    (a, Analyze(a, repair.PlanFor(g, c), false, maxK))
}

// tokens names a token set: `EOF X Y`.
func tokens(a atn.ATN, s atn.IntervalSet) string = s.Values().Map((t) => a.Vocab.Name(t)).MkString(" ")

// show renders a lookahead tree with token names: `{X:{Y:1 Z:2} W:?1,2}`.
func show(a atn.ATN, l Lookahead) string = l match {
    case Predict(alt) => s"$alt"
    case Adaptive(alts) => s"?${alts.MkString(",")}"
    case Automaton(states) => s"dfa(${states.Size()})"
    case Otherwise() => "?"
    case Switch(_, cases) => "{" + cases.Map((c) => tokens(a, c.Tokens) + ":" + show(a, c.Then)).MkString(" ") + "}"
}

func className(c DecisionClass) string = c match {
    case LL1() => "LL(1)"
    case LLk(k) => s"LL($k)"
    case NeedsAdaptive() => "adaptive"
}

// planFor finds the plan of the decision in rule whose source text is text.
func planFor(a atn.ATN, an Analysis, rule string, text string) DecisionPlan =
    an.Plans.Find((p) => a.RuleNames.Get(p.Decision.Rule) == rule && p.Decision.Text == text) match {
        case Some(p) => p
        case None() => go_builtins.Panic(s"no decision '$text' in rule $rule; have: " +
            an.Plans.Map((p) => s"${a.RuleNames.Get(p.Decision.Rule)}: ${p.Decision.Text}").MkString(" / "))
    }

// decision analyzes src and describes one decision as `class tree`.
func decision(src string, rule string, text string, maxK int = MaxK) string {
    val (a, an) = analyzed(src, maxK)
    val p = planFor(a, an, rule, text)
    s"${className(p.Class)} ${show(a, treeOf(a, p.Decision, maxK))}"
}

// treeOf is the static lookahead tree of a decision, which the plan replaces
// with an automaton when part of it is adaptive.
func treeOf(a atn.ATN, dec atn.Decision, maxK int) Lookahead {
    val sites = callSites(a)
    newGrammarInfo(a, sites, startRules(a, sites)).lookaheadTree(dec, maxK).V1
}

val tokensXYZ = `
X : 'x' ; Y : 'y' ; Z : 'z' ; W : 'w' ; Q : 'q' ;
`

func TestFirstFollowNullable(t T) T {
    val (a, an) = analyzed(`grammar F;
s : a b EOF ;
a : X | ;
b : Y a Z | c ;
c : W? ;
` + tokensXYZ)
    val rule = (name string) => a.RuleIndex(name).Get()
    val first = (name string) => tokens(a, an.First.Get(rule(name)))
    val follow = (name string) => tokens(a, an.Follow.Get(rule(name)))
    val nullable = (name string) => an.Nullable.Get(rule(name))
    val t1 = Eq(t, first("s"), "EOF X Y W")
    val t2 = Eq(t1, first("a"), "X")
    val t3 = Eq(t2, first("b"), "Y W")
    val t4 = Eq(t3, ArrayOf("s", "a", "b", "c").Map(nullable), ArrayOf(false, true, true, true))
    // s is the start rule (nothing calls it), so EOF follows it.
    val t5 = Eq(t4, follow("s"), "EOF")
    // a is followed by b (or what follows b, since b is nullable) in s, and by Z in b.
    val t6 = Eq(t5, follow("a"), "EOF Y Z W")
    Eq(t6, follow("c"), "EOF")
}

func TestStaticLookahead(t T) T = RunCases[Tuple[string, string], string](t,
    (sub, in, want) => Eq(sub, decision(`grammar D;
` + in.V1 + tokensXYZ, "s", in.V2), want),
    Case[Tuple[string, string], string](
        Name = "one token decides",
        Input = (`s : X a | Y ; a : Z ;`, "s : X a | Y"),
        Expected = "LL(1) {X:1 Y:2}",
    ),
    Case[Tuple[string, string], string](
        Name = "two tokens decide",
        Input = (`s : X Y | X Z ;`, "s : X Y | X Z"),
        Expected = "LL(2) {X:{Y:1 Z:2}}",
    ),
    Case[Tuple[string, string], string](
        Name = "three tokens decide",
        Input = (`s : X Y Z | X Y W ;`, "s : X Y Z | X Y W"),
        Expected = "LL(3) {X:{Y:{Z:1 W:2}}}",
    ),
    Case[Tuple[string, string], string](
        Name = "past MaxK the decision is adaptive",
        Input = (`s : X Y Z Q | X Y Z W ;`, "s : X Y Z Q | X Y Z W"),
        Expected = "adaptive {X:{Y:{Z:?1,2}}}",
    ),
    Case[Tuple[string, string], string](
        Name = "lookahead continues through rule calls",
        Input = (`s : a Y | a Z ; a : X ;`, "s : a Y | a Z"),
        Expected = "LL(2) {X:{Y:1 Z:2}}",
    ),
    Case[Tuple[string, string], string](
        Name = "greedy loop: enter or exit",
        Input = (`s : (X Y)* X Z ;`, "(X Y)*"),
        Expected = "LL(2) {X:{Y:1 Z:2}}",
    ),
    Case[Tuple[string, string], string](
        Name = "non-greedy loop puts the exit first",
        Input = (`s : (X Y)*? X Z ;`, "(X Y)*?"),
        Expected = "LL(2) {X:{Y:2 Z:1}}",
    ),
    Case[Tuple[string, string], string](
        Name = "plus loop: repeat or exit",
        Input = (`s : (X Y)+ X Z ;`, "(X Y)+"),
        Expected = "LL(2) {X:{Y:1 Z:2}}",
    ),
    Case[Tuple[string, string], string](
        Name = "optional block and its exit",
        Input = (`s : X? X Y ;`, "X?"),
        Expected = "LL(2) {X:{X:1 Y:2}}",
    ),
    Case[Tuple[string, string], string](
        Name = "the exit of a rule's last optional sees EOF",
        Input = (`s : X Y? ;`, "Y?"),
        Expected = "LL(1) {EOF:2 Y:1}",
    ),
)

func TestNullableAlternativeSeesFollow(t T) T =
    Eq(t, decision(`grammar N;
s : a Z | Y a W ;
a : X | ;
` + tokensXYZ, "a", "a : X | "), "LL(1) {X:1 Z W:2}")

func TestExitConflictsThroughGlobalFollow(t T) T =
    // In a, `X?` may be followed by the X that s matches after a, so a lone X
    // is decided by what comes after it: another X means the optional X was
    // taken, EOF means it was not.
    Eq(t, decision(`grammar G;
s : a X EOF ;
a : Y X? ;
` + tokensXYZ, "a", "X?"), "LL(2) {X:{EOF:2 X:1}}")

func TestGlobalFollowCoversEveryCaller(t T) T =
    // a is called from two contexts; the exit of `X?` must account for both:
    // after `Y` in s1 and after nothing in s2 (where EOF ends the start rule).
    Eq(t, decision(`grammar C;
s : W a Y | Z a ;
a : Q X? ;
` + tokensXYZ, "a", "X?"), "LL(1) {EOF Y:2 X:1}")

func TestRecursiveRules(t T) T {
    val src = `grammar R;
s : e EOF ;
e : X e Y | Z ;
p : X p Y Q | X p Y W | Z ;
` + tokensXYZ
    val t1 = Eq(t, decision(src, "e", "e : X e Y | Z"), "LL(1) {X:1 Z:2}")
    // Telling p's first two alternatives apart needs the token after the
    // matching Y, arbitrarily far away: static lookahead cannot do it.
    Eq(t1, decision(src, "p", "p : X p Y Q | X p Y W | Z"), "adaptive {X:{X:{X Z:?1,2} Z:{Y:?1,2}} Z:3}")
}

func TestAmbiguityGoesToTheSmallestAlternative(t T) T {
    val src = `grammar A;
s : a EOF ;
a : X | q ;
q : X (Y X)* ;
` + tokensXYZ
    // After X both alternatives can end a at once and then reach the same
    // configuration, where ANTLR resolves the ambiguity to alternative 1;
    // only Y (the loop in q) needs alternative 2.
    Eq(t, decision(src, "a", "a : X | q"), "LL(2) {X:{EOF:1 Y:2}}")
}

func TestPredicatesMakeADecisionAdaptive(t T) T {
    val (a, an) = analyzed(`grammar P;
s : {p()}? X | X Y ;
` + tokensXYZ)
    val p = an.Plans.Head()
    val t1 = Eq(t, s"${className(p.Class)} ${show(a, p.Lookahead)}", "adaptive ?1,2")
    Eq(t1, Report(a, an), `1 decisions: 0 LL(1), 0 LL(2), 0 LL(3), 1 adaptive

Adaptive decisions:
decision 0 in rule s (block): s : {p()}? X | X Y
  alts 1,2: predicates are evaluated before the first token

Bracket abstraction: skipped (the grammar has actions, predicates or left recursion, so it is never repaired)
`)
}

func TestMaxKIsAParameter(t T) T {
    val src = `grammar K;
s : X Y Z Q | X Y Z W ;
` + tokensXYZ
    Eq(t, decision(src, "s", "s : X Y Z Q | X Y Z W", 4), "LL(4) {X:{Y:{Z:{W:2 Q:1}}}}")
}

func TestReport(t T) T {
    val (a, an) = analyzed(`grammar Rep;
s : (X Y)* X Z t u EOF ;
t : Q W Q Y | Q W Q Z ;
u : X | Y ;
` + tokensXYZ)
    Eq(t, Report(a, an), `3 decisions: 1 LL(1), 1 LL(2), 0 LL(3), 1 adaptive

Decisions that need more than one token:
  LL(2) decision 0 in rule s (star): (X Y)*

Adaptive decisions:
decision 1 in rule t (block): t : Q W Q Y | Q W Q Z
  alts 1,2 both start with: 'q' 'w' 'q'
  SLL automaton: 6 states, 2 of them final

Bracket abstraction: skipped (no decision needs runtime prediction)
`)
}

// The decisions of gala.g4 that static lookahead (up to three tokens) cannot
// settle, by rule.
val galaAdaptive = ArrayOf(
    "declaration", "varDeclaration", "signature", "returnStatement", "ifStatement",
    "forStatement", "simpleStatement", "orExpr", "andExpr", "equalityExpr",
    "relationalExpr", "additiveExpr", "multiplicativeExpr", "unaryExpr", "postfixExpr",
    "postfixExpr", "primaryExpr", "argument", "primary", "keyedElement", "pattern",
)

func TestGalaGrammar(t T) T {
    val (a, an) = analyzed(grammartest.GalaGrammar)
    val report = Report(a, an)
    val adaptive = an.Plans.Filter((p) => p.Class match {
        case NeedsAdaptive() => true
        case _ => false
    }).Map((p) => a.RuleNames.Get(p.Decision.Rule))
    val t1 = HasPrefix(t, report, "107 decisions: 71 LL(1), 13 LL(2), 2 LL(3), 21 adaptive\n")
    Eq(t1, adaptive, galaAdaptive)
}

// builtAutomaton builds the SLL automaton of one decision of src: None when
// it cannot settle every input.
func builtAutomaton(src string, rule string, text string) Tuple[atn.ATN, Option[Lookahead]] {
    val (a, an) = analyzed(src)
    val sites = callSites(a)
    val dec = planFor(a, an, rule, text).Decision
    (a, newGrammarInfo(a, sites, startRules(a, sites)).buildAutomaton(dec))
}

// automatonOf builds the SLL automaton of one decision of src, which must
// settle every input.
func automatonOf(src string, rule string, text string) Tuple[atn.ATN, Array[DFAState]] {
    val (a, built) = builtAutomaton(src, rule, text)
    built match {
        case Some(Automaton(states)) => (a, states)
        case other => go_builtins.Panic(s"no automaton, got $other")
    }
}

// showAutomaton renders an automaton: `0 X:1 | 1 predict 2`.
func showAutomaton(a atn.ATN, states Array[DFAState]) string =
    states.ZipWithIndex().Map((p) => {
        val (st, i) = p
        st.Final match {
            case Some(alt) => s"$i predict $alt"
            case None() => s"$i " + st.Edges.Map((e) => s"${tokens(a, e.Tokens)}:${e.Target}").MkString(" ")
        }
    }).MkString(" | ")

// runAutomaton feeds token names to an automaton until it decides.
func runAutomaton(a atn.ATN, states Array[DFAState], input Array[string]) string = runFrom(a, states, 0, input)

// runFrom runs the automaton from state on the remaining input.
func runFrom(a atn.ATN, states Array[DFAState], state int, rest Array[string]) string {
    val st = states.Get(state)
    st.Final match {
        case Some(alt) => s"predict $alt"
        case None() => rest.HeadOption().FlatMap((name) => a.Vocab.TypeOf(name)) match {
            case Some(tok) => st.Edges.Find(_.Tokens.Contains(tok)) match {
                case Some(e) => runFrom(a, states, e.Target, rest.Drop(1))
                case None() => "syntax error"
            }
            case None() => "out of input"
        }
    }
}

func TestAutomatonLoopsBack(t T) T {
    // Telling a's alternatives apart needs the token after a dotted name of any
    // length: the automaton cycles over `Y X` instead of giving up.
    val (a, states) = automatonOf(`grammar L;
s : a EOF ;
a : X (Y X)* Z | X (Y X)* W ;
` + tokensXYZ, "a", "a : X (Y X)* Z | X (Y X)* W")
    val t1 = Eq(t, showAutomaton(a, states), "0 X:1 | 1 Y:2 Z:3 W:4 | 2 X:1 | 3 predict 1 | 4 predict 2")
    Eq(t1, runAutomaton(a, states, ArrayOf("X", "Y", "X", "Y", "X", "W")), "predict 2")
}

func TestAutomatonGivesUpAtAConflict(t T) T {
    // After `Y Y Q` both alternatives can end s, in different calling contexts
    // of a: SLL prediction stops with a conflict that only full-context
    // prediction settles, so no automaton settles every input.
    val (_, built) = builtAutomaton(`grammar C;
s : W a Y Q | Z a Q ;
a : Y Y | Y ;
` + tokensXYZ, "a", "a : Y Y | Y")
    IsTrue(t, built.IsEmpty())
}

func TestAutomatonGivesUpOnRecursion(t T) T {
    // Every X nests e once more, so the SLL automaton would be infinite.
    val (_, built) = builtAutomaton(`grammar R;
s : e EOF ;
e : X e Y Q | X e Y W | Z ;
` + tokensXYZ, "e", "e : X e Y Q | X e Y W | Z")
    IsTrue(t, built.IsEmpty())
}

func TestOnlyAutomataThatSettleStay(t T) T {
    // The automaton of s loops over X and settles every input, so it stays.
    // Nesting in e makes the automaton of r give up, so r keeps its static
    // tree, whose unsettled leaves are left to runtime prediction.
    val (a, an) = analyzed(`grammar C;
s : a | b ;
a : X* Y ;
b : X* Z ;
r : e Y | e Z ;
e : '(' e ')' | X ;
` + tokensXYZ)
    val t1 = HasPrefix(t, render(planFor(a, an, "s", "s : a | b").Lookahead), "automaton(")
    // The static tree stays; its unsettled leaves ask the runtime, and so does
    // a token past the first that no case expects.
    val r = show(a, planFor(a, an, "r", "r : e Y | e Z").Lookahead)
    val t2 = Contains(t1, r, "T__0 X:?1,2")
    Contains(t2, r, "X:{Y:1 Z:2 :?}")
}

func TestOpenerSitesJumpPastTheCloser(t T) T {
    val a = grammartest.ParserATN(`grammar P;
e : f '(' ID? ')' ID ;
f : ID ;
ID : [a-z]+ ;`)
    val b = brackets.Analyze(a)
    val (first, nullable) = firstSets(a)
    val t1 = Eq(t, b.Sites.Size(), 1)
    // From the state after ')', the only way on is ID.
    val next = b.Sites.Head().After.Map((s) => tokens(a, lookFrom(a, s, first, nullable).Tokens))
    Eq(t1, next, ArrayOf("ID"))
}
