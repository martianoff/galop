package analysis

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/concurrent"

    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/brackets"
)

// Analyze computes FIRST, FOLLOW and nullability per rule and a decision
// plan for every decision of the parser ATN a. Decisions are independent and
// are analyzed concurrently; the plans come back in decision order.
// a: a parser ATN from atn.Compile.
// maxK: the deepest static lookahead to try before a decision is left to adaptive prediction.
// bracketsOff: why runtime prediction must not read bracketed groups as one
// symbol, if it must not (see BracketsOff).
func Analyze(a atn.ATN, maxK int = MaxK, bracketsOff Option[string] = None[string]()) Analysis {
    val sites = callSites(a)
    val starts = startRules(a, sites)
    val (first, nullable) = firstSets(a)
    val follow = followSets(a, sites, starts, first, nullable)
    val g = newGrammarInfo(a, sites, starts)
    val plans = concurrent.Traverse(a.Decisions, (d) => concurrent.Future(g.planDecision(d, maxK))).Get()
    // Brackets matter only to runtime prediction.
    val bracketing = bracketsOff match {
        case Some(why) => brackets.NoBrackets(why)
        case None() =>
            if (plans.Exists((p) => NeedsRuntime(p.Lookahead))) brackets.Analyze(a)
            else brackets.NoBrackets("no decision needs runtime prediction")
    }
    Analysis(plans, first, follow, nullable, bracketing)
}

// BracketsOff says why the parser of rules must predict over tokens only, if
// it must: -Xno-brackets (noBrackets), or grammar code. A first pass over
// bracketed groups that fails is repaired over tokens, and a grammar with
// actions or predicates is never repaired: a failed pass would run its actions
// once more than ANTLR does.
func BracketsOff(rules Array[atn.RuleIR], noBrackets bool) Option[string] =
    if (noBrackets) Some("disabled by -Xno-brackets")
    else if (atn.RunsCode(rules)) Some("the grammar has actions or predicates, so a failed first pass is not repaired")
    else None()
