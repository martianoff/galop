package analysis

import (
    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/atn"
)

// The analysis decides, at generation time, how generated code picks an
// alternative at every decision of a parser ATN. A decision whose
// alternatives differ within the first K tokens (K <= MaxK) becomes a static
// switch on the lookahead. Any other decision is "adaptive": generated code
// asks the runtime to simulate the ATN with the parser's actual call stack,
// which gives exactly the alternative ANTLR's full-context (LL) prediction
// picks. The conflict report lists the adaptive decisions.

// Lookahead is how generated code picks an alternative at one decision.
sealed type Lookahead {
    // Predict picks Alt without looking at more tokens.
    case Predict(Alt int)
    // Switch looks at token LA(Depth) (1-based) and continues with the first
    // case whose Tokens contain it. A token in no case means no alternative
    // can match: a syntax error.
    case Switch(Depth int, Cases Array[LookaheadCase])
    // Adaptive asks the runtime predictor to choose among Alts by simulating
    // the ATN from the decision with the real call stack (ANTLR's LL mode).
    case Adaptive(Alts Array[int])
    // Automaton is ANTLR's SLL lookahead DFA, built ahead of time. State 0
    // reads LA(1); a state without Final reads the next token and follows the
    // edge whose Tokens contain it (no edge: a syntax error). A state with
    // Final consumes nothing more.
    case Automaton(States Array[DFAState])
}

// DFAState is one state of an Automaton.
struct DFAState(Edges Array[DFAEdge], Final Option[DFAFinal])

// DFAEdge leads to state Target on any token in Tokens.
struct DFAEdge(Tokens atn.IntervalSet, Target int)

// DFAFinal ends an Automaton walk.
sealed type DFAFinal {
    // FinalPredict picks Alt.
    case FinalPredict(Alt int)
    // FinalFullLL is an SLL conflict: run full-context prediction from the decision start.
    case FinalFullLL()
}

// LookaheadCase is one branch of a Switch.
struct LookaheadCase(Tokens atn.IntervalSet, Then Lookahead)

// DecisionClass summarizes a decision for the report.
sealed type DecisionClass {
    // LL1: one token of lookahead always decides.
    case LL1()
    // LLk: K tokens of lookahead always decide (1 < K <= MaxK).
    case LLk(K int)
    // NeedsAdaptive: some lookahead prefixes are only decided at runtime.
    case NeedsAdaptive()
}

// Conflict is a lookahead prefix (token types) that the alternatives Alts all
// accept up to the analysis depth, so static lookahead cannot choose.
struct Conflict(Alts Array[int], Example Array[int])

// DecisionPlan is the analysis result for one decision.
struct DecisionPlan(
    Decision atn.Decision,
    Class DecisionClass,
    Lookahead Lookahead,
    Conflicts Array[Conflict],
)

// Analysis is the result for a whole parser ATN.
struct Analysis(
    // Plans is indexed by decision id.
    Plans Array[DecisionPlan],
    // First, Follow and Nullable are indexed by rule. Follow is the global
    // (context-free) FOLLOW set; EOF (-1) is in Follow of the start rules.
    First Array[atn.IntervalSet],
    Follow Array[atn.IntervalSet],
    Nullable Array[bool],
)

// MaxK is the deepest static lookahead the analysis tries by default.
val MaxK = 3
