package analysis

import (
    . "martianoff/gala/collection_immutable"
    m "martianoff/gala/collection_mutable"

    "github.com/martianoff/galop/atn"
)

// The SLL automaton of a decision is ANTLR's SLL prediction DFA, built ahead
// of time by subset construction instead of lazily at runtime.
//
// A DFA state is a set of SLL configurations (ATN state, alternative,
// context) as ANTLR's ATNConfigSet holds them after a closure: one
// configuration per (state, alternative), whose context is the merge of the
// contexts that reached it (see contextTable). ANTLR's SLL prediction starts
// with an empty context whose root is a wildcard: a rule end with an empty
// context follows global FOLLOW, and the empty context absorbs whatever it is
// merged with.
//
// A state other than the start is final, as in ANTLR's execATN in SLL mode:
//
//   - one alternative left: predict it;
//   - otherwise, when PredictionMode.hasSLLConflictTerminatingPrediction holds
//     (every configuration is at the end of a start rule, or some group with
//     the same state and merged context has several alternatives while no
//     state has a single one): a conflict, FinalFullLL(Some(m)) with m the
//     smallest conflicting alternative, which pure SLL mode predicts, while LL
//     mode retries the decision with full context, as ANTLR does;
//   - EOF keeps only the configurations at the end of a start rule.
//
// Nothing reached is a syntax error. Recursion makes the SLL DFA infinite
// (each '(' deepens the stack), so an edge into a state whose stacks are
// deeper than dfaStackLimit, or past dfaStateLimit states, ends in
// FinalFullLL(None): the runtime goes on predicting (SLL, then LL as needed).

// dfaStateLimit bounds the states of one automaton. Measured on gala.g4 with
// the generated Go parser: a limit of 1000 gave a 6.2 MB parser (8.6 s go
// build), 200 gave 1.5 MB and 50 gave 548 KB, with the same corpus results
// and the same cold parse time (25 ms for array.gala), so 50 it is.
val dfaStateLimit = 50

// dfaStackLimit bounds the call stack of the configurations in a state.
val dfaStackLimit = 64

// source is the configuration a move starts from: its ATN state and stack.
// A move straight out of the decision state has a negative group of its own.
struct source(State int, Stack int)

func sourceOf(mv move) source =
    if (mv.Group < 0) source(int(mv.Group) - 1000, emptyStack)
    else source(int(mv.Group % stateSpan) - 1, int(mv.Group / (stateSpan * altSpan * exitSpan)))

// dfaFrontier is the content of a DFA state: the moves of its configurations
// after minimization, keyed canonically.
struct dfaFrontier(Key string, Moves Array[move])

// automatonBuilder holds one decision's DFA under construction.
struct automatonBuilder(
    d decider,
    index Ptr[m.HashMap[string, int]],
    edges Ptr[m.Array[Array[DFAEdge]]],
    finals Ptr[m.Array[Option[DFAFinal]]],
    pending Ptr[m.Array[Array[move]]],
    finalIndex Ptr[m.HashMap[int, int]],
)

// buildAutomaton builds the SLL automaton of dec, or None when the start state
// cannot be computed (a runaway call stack).
func (g grammarInfo) buildAutomaton(dec atn.Decision) Option[Lookahead] {
    val d = newDecider(g, 1, false)
    val seed = decisionSeed(g, dec, d)
    val r = d.closure(seed.Starts, 0)
    if r.Overflow {
        return None()
    }
    val b = automatonBuilder(
        d,
        m.EmptyHashMap[string, int](),
        m.EmptyArray[Array[DFAEdge]](),
        m.EmptyArray[Option[DFAFinal]](),
        m.EmptyArray[Array[move]](),
        m.EmptyHashMap[int, int](),
    )
    b.state(b.frontier(seed.Moves.AppendAll(r.Moves)))
    var next = 0
    // A worklist: each state's edges may add new states.
    for next < b.pending.Size() {
        b.expandState(next)
        next = next + 1
    }
    val states = ArrayTabulate(b.edges.Size(), (i) => DFAState(b.edges.Get(i), b.finals.Get(i)))
    Some(Automaton(states))
}

// frontier merges the configurations the moves start from the way ANTLR's
// SLL ATNConfigSet does, one configuration per (state, alternative) with the
// merged context, and rebuilds the moves from the merged configurations. A
// state has one consuming transition, so its moves differ only in context.
func (b automatonBuilder) frontier(moves Array[move]) dfaFrontier {
    val order = m.EmptyArray[int64]()
    val firstMove = m.EmptyHashMap[int64, move]()
    val context = m.EmptyHashMap[int64, int]()
    moves.ForEach((mv) => {
        val src = sourceOf(mv)
        // Source states are at least -1000 - alt (see sourceOf).
        val k = (int64(src.State) + stateSpan / 2) * altSpan + int64(mv.Next.Alt)
        context.Get(k) match {
            case Some(ctx) => context.Put(k, b.d.stacks.merge(ctx, src.Stack))
            case None() => {
                order.Append(k)
                firstMove.Put(k, mv)
                context.Put(k, src.Stack)
            }
        }
    })
    val merged = ArrayFromSlice(order.ToGoSlice()).Map((k) => {
        val mv = firstMove.Get(k).Get()
        val ctx = context.Get(k).Get()
        if (mv.Group < 0) mv
        else move(mv.Symbols, config(sourceOf(mv).State, ctx, inside, 0).group(), config(mv.Next.State, ctx, inside, mv.Next.Alt))
    })
    // A merged configuration is its group plus its alternative; moves straight
    // out of the decision state have a negative group per alternative.
    val key = merged.Map((mv) => if (mv.Group < 0) mv.Group else mv.Group + int64(mv.Next.Alt) * stateSpan)
        .Sorted().MkString(",")
    dfaFrontier(key, merged)
}

// state returns the non-final DFA state for f, creating it when it is new.
func (b automatonBuilder) state(f dfaFrontier) int {
    if b.index.Contains(f.Key) {
        return b.index.Get(f.Key).Get()
    }
    val id = b.edges.Size()
    b.index.Put(f.Key, id)
    b.edges.Append(EmptyArray[DFAEdge]())
    b.finals.Append(None[DFAFinal]())
    b.pending.Append(f.Moves)
    id
}

// final returns the shared final state for fin.
func (b automatonBuilder) final(fin DFAFinal) int {
    val k = fin match {
        case FinalPredict(alt) => alt
        case FinalFullLL(Some(alt)) => -alt
        case FinalFullLL(None()) => 0
    }
    if b.finalIndex.Contains(k) {
        return b.finalIndex.Get(k).Get()
    }
    val id = b.edges.Size()
    b.finalIndex.Put(k, id)
    b.edges.Append(EmptyArray[DFAEdge]())
    b.finals.Append(Some(fin))
    b.pending.Append(EmptyArray[move]())
    id
}

// sllFinal is ANTLR's SLL verdict on a merged set of configurations (one move
// per state and alternative, see frontier), if it stops there.
func sllFinal(moves Array[move]) Option[DFAFinal] {
    val alts = altsOf(moves)
    if alts.Size() == 1 {
        return Some(FinalPredict(alts.Head()))
    }
    // All at the end of a start rule, or an SLL conflict: the smallest alternative.
    val stop = moves.ForAll((mv) => sourceOf(mv).State == endOfInput) || sllConflict(moves)
    if (stop) Some(FinalFullLL(Some(alts.Head()))) else None()
}

// sllConflict is ANTLR's conflict heuristic: some group of configurations with
// the same state and merged context holds several alternatives, and no state
// is associated with a single alternative.
func sllConflict(moves Array[move]) bool {
    val altOfGroup = m.EmptyHashMap[int64, int]()
    val altOfState = m.EmptyHashMap[int, int]()
    val sharedStates = m.EmptyHashSet[int]()
    var conflicting = false
    moves.ForEach((mv) => {
        val alt = mv.Next.Alt
        val state = sourceOf(mv).State
        if altOfGroup.GetOrElse(mv.Group, alt) != alt {
            conflicting = true
        }
        altOfGroup.Put(mv.Group, alt)
        if altOfState.GetOrElse(state, alt) != alt {
            sharedStates.Add(state)
        }
        altOfState.Put(state, alt)
    })
    conflicting && altOfState.Size() == sharedStates.Size()
}

// expandState computes the edges of state id.
func (b automatonBuilder) expandState(id int) {
    val moves = b.pending.Get(id)
    if b.finals.Get(id).IsDefined() || moves.IsEmpty() {
        return
    }
    val targets = tokenClasses(moves).Collect((cls) => b.target(cls).Map((t) => DFAEdge(cls.Tokens, t)))
    val merged = unique(targets.Map(_.Target)).Map((t) => {
        val tokens = targets.Filter(_.Target == t).FoldLeft(atn.EmptySet(), (acc, e) => acc.Union(e.Tokens))
        DFAEdge(tokens, t)
    }).SortWith((x, y) => x.Tokens.Min().Get() < y.Tokens.Min().Get())
    b.edges.Set(id, merged)
}

// target is the state reached on the tokens of cls, or None when none is.
func (b automatonBuilder) target(cls tokenClass) Option[int] {
    val next = cls.Moves.Map(_.Next)
    if next.Exists((c) => b.d.stacks.depths.Get(c.Stack) > dfaStackLimit) {
        return Some(b.final(FinalFullLL(None())))
    }
    val r = b.d.closure(next, 0)
    if r.Overflow {
        return Some(b.final(FinalFullLL(None())))
    }
    if cls.Tokens.Contains(atn.TokenEOF) {
        // After EOF only the configurations at the end of a start rule remain.
        val ended = altsOf(r.Moves.Filter((mv) => sourceOf(mv).State == endOfInput))
        return ended match {
            case Array() => None()
            case Array(alt) => Some(b.final(FinalPredict(alt)))
            case _ => Some(b.final(FinalFullLL(Some(ended.Head()))))
        }
    }
    val f = b.frontier(r.Moves)
    // A final verdict goes to the shared final state; the start state is
    // never final, as ANTLR decides only after the first token.
    sllFinal(f.Moves) match {
        case Some(fin) => Some(b.final(fin))
        case None() =>
            if (!b.index.Contains(f.Key) && b.edges.Size() >= dfaStateLimit) Some(b.final(FinalFullLL(None())))
            else Some(b.state(f))
    }
}

// seed is how a decision starts: the moves of transitions that consume at
// once, the configurations of the others, and whether a predicate comes first.
struct seed(Moves Array[move], Starts Array[config], Predicated bool)

func decisionSeed(g grammarInfo, dec atn.Decision, d decider) seed {
    // The decision state's i-th transition starts alternative i+1. A
    // transition that consumes straight away gets a group of its own.
    val seeds = g.a.State(dec.State).Out.ZipWithIndex().Map((p) => (p.V1, p.V2 + 1))
    val moves = seeds.Collect({
        case (atn.Atom(target, label), alt) => move(atn.SetOf(label), int64(-alt), config(target, emptyStack, inside, alt))
        case (atn.SetMatch(target, set), alt) => move(set, int64(-alt), config(target, emptyStack, inside, alt))
    })
    val starts = seeds.Collect({
        case (atn.Epsilon(target), alt) => config(target, emptyStack, inside, alt)
        case (atn.RuleCall(target, _, follow), alt) => config(target, d.stacks.push(follow, emptyStack), inside, alt)
        case (atn.LexerActions(target, _), alt) => config(target, emptyStack, inside, alt)
        case (atn.Predicate(target, _, _), alt) => config(target, emptyStack, inside, alt)
        case (atn.Action(target, _, _), alt) => config(target, emptyStack, inside, alt)
    })
    val predicated = seeds.Exists((p) => p.V1 match {
        case atn.Predicate(_, _, _) => true
        case _ => false
    })
    seed(moves, starts, predicated)
}
