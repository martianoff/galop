package atn

import . "martianoff/gala/collection_immutable"

// The rule IR is the parser grammar as a tree again, annotated with the ATN
// facts code generation needs: which decision each choice is, the alternative
// numbers of its branches, and the follow state of each rule call. A code
// generator walks the IR; the analysis works on the ATN; decisions tie the
// two together by id.

// LabelRef is an element label: `name=x` (Append false) or `name+=x`.
struct LabelRef(Name string, Append bool)

// Step is one item of an alternative in the rule IR.
sealed type Step {
    // MatchToken matches one token type (TokenEOF for EOF).
    case MatchToken(Token int, Label Option[LabelRef])
    // MatchSet matches any token type in Set: `('+' | '-')`, `~X`, `.`. Listed
    // says the set lists its members as alternatives (the first form), as
    // ANTLR's getters for them need to know.
    case MatchSet(Set IntervalSet, Label Option[LabelRef], Listed bool)
    // CallRule invokes rule Rule; Follow is the ATN state matching resumes at,
    // which a parser pushes as its return state for context-aware prediction.
    case CallRule(Rule int, Follow int, Label Option[LabelRef])
    // Choose picks one of Alts by Decision. ExitAlt is the decision's
    // alternative that matches nothing (an optional block): alternative 1 when
    // non-greedy, len(Alts)+1 when greedy. Use AltNumber for the others.
    case Choose(Decision int, Alts Array[Array[Step]], ExitAlt Option[int])
    // Loop repeats Body while Decision predicts ContinueAlt. A `+` loop (Plus)
    // runs Body once before its first decision; a `*` loop decides first.
    // A body with several alternatives is a single Choose step.
    case Loop(Plus bool, Decision int, ContinueAlt int, Body Array[Step])
    // RunAction is an embedded action, in the target language.
    case RunAction(Body string)
    // CheckPredicate is a semantic predicate, in the target language.
    case CheckPredicate(Body string)
}

// AltNumber is the decision alternative number of Alts[index] in a Choose.
func AltNumber(exitAlt Option[int], index int) int = exitAlt match {
    case Some(1) => index + 2
    case _ => index + 1
}

// AltIR is one top-level alternative of a parser rule, with its `# Label`.
struct AltIR(Label Option[string], Steps Array[Step])

// RuleIR is a parser rule. Decision is set when the rule has more than one
// alternative; alternative i (from 0) is decision alternative i+1.
struct RuleIR(Index int, Name string, Decision Option[int], Alts Array[AltIR])

// HasStep says whether some step in steps, nested ones included, satisfies p.
func HasStep(steps Array[Step], p func(Step) bool) bool = steps.Exists((s) => p(s) || (s match {
    case Choose(_, alts, _) => alts.Exists((a) => HasStep(a, p))
    case Loop(_, _, _, body) => HasStep(body, p)
    case _ => false
}))

// RunsCode says whether parsing with rules runs grammar code: an embedded
// action or a semantic predicate.
func RunsCode(rules Array[RuleIR]) bool =
    rules.Exists((r) => r.Alts.Exists((a) => HasStep(a.Steps, (s) => s match {
        case RunAction(_) => true
        case CheckPredicate(_) => true
        case _ => false
    })))
