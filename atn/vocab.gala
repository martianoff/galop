package atn

import (
    "strings"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/g4"
)

// TokenEOF is the token type of end of input, as in ANTLR.
val TokenEOF = -1

// Vocabulary maps token types to names, numbered the way ANTLR numbers them,
// so that generated code agrees with ANTLR-generated lexers and parsers.
//
// Index 0 is unused (ANTLR's invalid type). For a combined grammar the order is:
// the implicit tokens of parser-rule literals that no lexer rule defines
// (`T__0`, `T__1`, … in order of first use), then the lexer rules that define a
// token (g4.LexerTokenNames: those without a `type` or `more` command, then
// those that are one literal), then `tokens {}` names, then token names that
// are only referenced (ANTLR warns about those and defines them). A lexer
// grammar numbers its `tokens {}` names first.
struct Vocabulary(
    // Names holds each type's constant name: `T__3`, `IDENTIFIER`.
    Names Array[string],
    // Literals holds each type's literal body (escapes kept), if the type has one:
    // an implicit token, or a lexer rule that is exactly one literal.
    Literals Array[Option[string]],
    // Implicit marks the types created for parser-rule literals.
    Implicit Array[bool],
)

// MaxType is the largest token type.
func (v Vocabulary) MaxType() int = v.Names.Size() - 1

// TypeOf is the type of a token name; EOF is TokenEOF.
func (v Vocabulary) TypeOf(name string) Option[int] =
    if (name == "EOF") Some(TokenEOF) else tokenType(v.Names.IndexOf(name))

// LiteralType is the type whose literal body is value.
func (v Vocabulary) LiteralType(value string) Option[int] = tokenType(v.Literals.IndexOf(Some(value)))

// tokenType is a token type found by IndexOf: -1 means absent, and type 0 is
// <INVALID>, never a real token.
func tokenType(index int) Option[int] = When(index > 0, index)

// Name is the constant name of type t; EOF is "EOF".
func (v Vocabulary) Name(t int) string =
    if (t == TokenEOF) "EOF" else v.Names.GetOption(t).GetOrElse(s"<$t>")

// Display renders type t for messages, as ANTLR does: the literal if it has one
// (`'('`), otherwise the name; EOF is `<EOF>`.
func (v Vocabulary) Display(t int) string =
    if (t == TokenEOF) "<EOF>"
    else v.LiteralName(t).GetOrElse(v.Name(t))

// LiteralName is the literal name of type t, if it has a literal, as ANTLR's
// generated code lists it (see LiteralName).
func (v Vocabulary) LiteralName(t int) Option[string] = v.Literals.GetOption(t).FlatMap((o) => o).Map(LiteralName)

// LiteralName is the literal name of literal body lit, as ANTLR's code generator
// writes it (Target.getTargetStringLiteralFromANTLRStringLiteral): quoted, with
// the escapes of n, r, t, b, f, u and the backslash kept, and the backslash of
// any other escape dropped, so the body of `'\''` is named `'''`.
func LiteralName(lit string) string {
    val (body, _) = ArrayFromSlice(strings.Split(lit, "")).FoldLeft(("", false), (acc, c) => acc match {
        case (s, true) if strings.Contains("nrtbfu\\", c) => (s + "\\" + c, false)
        case (s, true) => (s + c, false)
        case (s, false) if c == "\\" => (s, true)
        case (s, _) => (s + c, false)
    })
    s"'$body'"
}

// BuildVocabulary numbers the tokens of g the way ANTLR does.
func BuildVocabulary(g g4.Grammar) Vocabulary {
    val aliases = g4.LiteralAliases(g)
    val implicitLits = g4.ImplicitLiterals(g)
    val implicitCount = implicitLits.Size()
    val implicitNames = ArrayTabulate(implicitCount, g4.ImplicitTokenName)
    val lexerNames = g4.LexerTokenNames(g)
    val tokens = g.Tokens.Distinct()
    // A name listed twice in `tokens {}` (or by the root and an imported
    // grammar), or one that is already a token, is that one token, as in ANTLR
    // (which warns, 108). A lexer grammar numbers its `tokens {}` first; a
    // combined grammar's belong to its parser, numbered after the lexer's.
    val declared = g.Kind match {
        case g4.LexerOnly() => tokens.AppendAll(lexerNames.Filter((n) => !tokens.Contains(n)))
        case _ => {
            val known = implicitNames.AppendAll(lexerNames)
            lexerNames.AppendAll(tokens.Filter((t) => !known.Contains(t)))
        }
    }
    // Tokens a parser rule uses that nothing defines are defined last (ANTLR
    // warns, 125), a lexer rule that defines no token included; a fragment
    // is error 501 instead.
    val referenced = g.Rules.Filter((r) => !r.IsLexer()).FlatMap(_.Nodes())
        .Collect({ case g4.TokenRef(n) if n != "EOF" => n })
        .Distinct()
        .Filter((n) => !implicitNames.Contains(n) && !declared.Contains(n) && !g.Rules.Exists((r) => r.Name == n && r.Fragment))
    val named = declared.AppendAll(referenced)
    val names = ArrayOf("<INVALID>")
        .AppendAll(implicitNames)
        .AppendAll(named)
    val literals = ArrayOf(None[string]())
        .AppendAll(implicitLits.Map((v) => Some(v)))
        .AppendAll(named.Map((n) => aliases.Find(_.V2 == n).Map(_.V1)))
    val implicit = ArrayTabulate(names.Size(), (t) => t >= 1 && t <= implicitCount)
    Vocabulary(names, literals, implicit)
}
