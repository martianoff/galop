package atn

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"

    "github.com/martianoff/galop/diag"
)

// DecodeLiteral turns a literal body as written in a grammar (escapes kept,
// quotes removed) into its code points. Escapes are ANTLR's: \n \r \t \b \f
// \\ \' \" \uXXXX \u{X...}.
func DecodeLiteral(body string) Either[diag.Diagnostic, Array[int]] {
    val rs = ToRunes(body)
    var i = 0
    var out = EmptyArray[int]()
    var err = None[diag.Diagnostic]()
    for err.IsEmpty() && i < rs.Size() {
        if rs[i] == '\\' {
            decodeEscape(rs, i, false) match {
                case Right(step) => {
                    out = out.Append(step.V1)
                    i = step.V2
                }
                case Left(d) => err = Some(d)
            }
        } else {
            out = out.Append(int(rs[i]))
            i = i + 1
        }
    }
    err match {
        case Some(d) => Left(d)
        case None() => Right(out)
    }
}

// DecodeCharSet turns the body of a lexer set `[...]` into the set it
// denotes. `a-z` is a range; inside a set `\]`, `\-` and `\\` are escapes too.
func DecodeCharSet(body string) Either[diag.Diagnostic, IntervalSet] {
    val rs = ToRunes(body)
    var i = 0
    var acc = EmptyArray[Interval]()
    var err = None[diag.Diagnostic]()
    // next reads one possibly escaped character at i.
    val next = (at int) => if (rs[at] == '\\') decodeEscape(rs, at, true) else Right[diag.Diagnostic, Tuple[int, int]](Tuple(int(rs[at]), at + 1))
    for err.IsEmpty() && i < rs.Size() {
        next(i) match {
            case Left(d) => err = Some(d)
            case Right(first) => {
                val isRange = first.V2 + 1 < rs.Size() && rs[first.V2] == '-'
                if isRange {
                    next(first.V2 + 1) match {
                        case Left(d) => err = Some(d)
                        case Right(last) => {
                            if last.V1 < first.V1 {
                                err = Some(diag.ReversedRange.New(string(rune(first.V1)) + "-" + string(rune(last.V1)), body))
                            }
                            acc = acc.Append(Interval(first.V1, last.V1))
                            i = last.V2
                        }
                    }
                } else {
                    acc = acc.Append(Interval(first.V1, first.V1))
                    i = first.V2
                }
            }
        }
    }
    err match {
        case Some(d) => Left(d)
        case None() => Right(normalize(acc))
    }
}

// decodeEscape decodes the escape starting with the backslash at rs[at] and
// returns (code point, index after the escape).
func decodeEscape(rs []rune, at int, inSet bool) Either[diag.Diagnostic, Tuple[int, int]] {
    if at + 1 >= rs.Size() {
        return Left(diag.InvalidEscapeSequence.New("\\"))
    }
    val c = rs[at + 1]
    val simple = c match {
        case 'n' => Some(10)
        case 'r' => Some(13)
        case 't' => Some(9)
        case 'b' => Some(8)
        case 'f' => Some(12)
        case '\\' => Some(92)
        case '\'' => Some(39)
        case '"' => Some(34)
        case ']' if inSet => Some(93)
        case '-' if inSet => Some(45)
        case _ => None[int]()
    }
    simple match {
        case Some(cp) => Right(Tuple(cp, at + 2))
        case None() if c == 'u' => decodeUnicode(rs, at + 2)
        case None() if c == 'p' || c == 'P' => Left(diag.Unsupported.New("unicode property escapes (\\p{...})"))
        case None() => Left(diag.InvalidEscapeSequence.New(escapeText(rs, at, at + 2)))
    }
}

// decodeUnicode decodes the digits of \uXXXX or \u{X...} starting at rs[at].
func decodeUnicode(rs []rune, at int) Either[diag.Diagnostic, Tuple[int, int]] {
    val braced = at < rs.Size() && rs[at] == '{'
    val start = if (braced) at + 1 else at
    var end = start
    var value = 0
    for end < rs.Size() && hexValue(rs[end]).IsDefined() && (braced || end < start + 4) && end < start + 6 {
        value = value * 16 + hexValue(rs[end]).Get()
        end = end + 1
    }
    val count = end - start
    val closeOk = !braced || (end < rs.Size() && rs[end] == '}')
    val lengthOk = if (braced) count >= 1 else count == 4
    // The escape's text, for messages: from its backslash to where decoding stopped.
    val text = escapeText(rs, at - 2, if (braced && closeOk) end + 1 else end)
    if (!closeOk || !lengthOk) Left(diag.InvalidEscapeSequence.New(text))
    else if (value > MaxCodePoint) Left(diag.InvalidEscapeSequence.New(text))
    else Right(Tuple(value, if (braced) end + 1 else end))
}

// hexValue is the value of hex digit c.
func hexValue(c rune) Option[int] = c match {
    case _ if c >= '0' && c <= '9' => Some(int(c - '0'))
    case _ if c >= 'a' && c <= 'f' => Some(int(c - 'a') + 10)
    case _ if c >= 'A' && c <= 'F' => Some(int(c - 'A') + 10)
    case _ => None[int]()
}

// escapeText is the source text of rs from index from up to (not including) to.
func escapeText(rs []rune, from int, to int) string =
    ArrayTabulate(to - from, (i) => string(rs[from + i])).MkString("")
