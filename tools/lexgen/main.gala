package main

import (
    "os"

    . "martianoff/gala/collection_immutable"
    "martianoff/gala/fs"

    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/codegen"
    "github.com/martianoff/galop/g4"
    "github.com/martianoff/galop/lexgen"
)

val usage = `lexgen - write the Go companion lexer of a grammar

Usage:
  lexgen <grammar.g4> <out.go> <package> <type>

It is what galop -Dlanguage=Go -Dflavor=companion will write for the lexer,
until the CLI does; the differential harness builds gala.g4's lexer with it.
`

func main() {
    val code = ArrayOf(os.Args...).Drop(1) match {
        case Array(grammar, out, pkg, typeName) => generate(grammar, out, pkg, typeName)
        case _ => {
            os.Stderr.WriteString(usage)
            2
        }
    }
    os.Exit(code)
}

// generate writes the lexer and returns the process exit code.
func generate(grammar string, out string, pkg string, typeName string) int = fs.ReadFileString(grammar) match {
    case Failure(e) => fail(ArrayOf(e.Error()))
    case Success(src) => g4.Parse(src) match {
        case Left(d) => fail(ArrayOf(s"$grammar:${d.String()}"))
        case Right(g) => atn.Compile(g).FlatMap((c) =>
            lexgen.GoLexerFile(codegen.Input(g, c, None()), codegen.Options(Package = pkg), typeName)
        ) match {
            case Left(errs) => fail(errs)
            case Right(f) => fs.WriteFileString(out, f.Content, 0644) match {
                case Success(_) => 0
                case Failure(e) => fail(ArrayOf(e.Error()))
            }
        }
    }
}

func fail(errs Array[string]) int {
    errs.ForEach((e) => {
        os.Stderr.WriteString(s"lexgen: $e\n")
    })
    1
}
