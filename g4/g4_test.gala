package g4

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// parseOrFail parses src and fails the test on a diagnostic.
func parseOrFail(t T, src string) Tuple[T, Grammar] = Parse(src) match {
    case Right(g) => (t, g)
    case Left(d) => (Fail(t, s"unexpected parse error: ${d.String()}"), Grammar(Combined(), ""))
}

// errorOf returns the diagnostic text Parse gives for src, or "" when it parses.
func errorOf(src string) string = Parse(src) match {
    case Left(d) => d.String()
    case Right(_) => ""
}

// ruleText parses `grammar t;` plus src and prints the rules back.
func ruleText(src string) string = Parse("grammar t;\n" + src) match {
    case Right(g) => g.Rules.Map(FormatRule).MkString("")
    case Left(d) => "error: " + d.String()
}

func kinds(src string) string = Lex(src) match {
    case Right(toks) => toks.Map((tok) => tok.Kind match {
        case TokId() => "id:" + tok.Text
        case TokInt() => "int:" + tok.Text
        case TokString() => "str:" + tok.Text
        case TokSet() => "set:" + tok.Text
        case TokAction() => "act:" + tok.Text
        case TokPredicate() => "pred:" + tok.Text
        case TokPunct() => tok.Text
        case TokEOF() => "EOF"
    }).MkString(" ")
    case Left(d) => "error: " + d.String()
}

func TestLexTokens(t T) T = RunCases[string, string](t,
    (sub, in, want) => Eq(sub, kinds(in), want),
    Case[string, string](Name = "rule", Input = "a : B 'x' ;", Expected = "id:a : id:B str:x ; EOF"),
    Case[string, string](Name = "comments dropped", Input = "a // c\n /* d */ b", Expected = "id:a id:b EOF"),
    Case[string, string](Name = "escapes kept", Input = "'\\'' [\\]a]", Expected = "str:\\' set:\\]a EOF"),
    Case[string, string](Name = "range and punct", Input = "'a'..'z' += -> :: ~", Expected = "str:a .. str:z += -> :: ~ EOF"),
    Case[string, string](Name = "action nests", Input = "{ a { b } \"}\" }", Expected = "act: a { b } \"}\"  EOF"),
    Case[string, string](Name = "block comment in action", Input = "{ /* } */ } B", Expected = "act: /* } */  id:B EOF"),
    Case[string, string](Name = "line comment in action", Input = "{ // a }\n} B", Expected = "act: // a }\n id:B EOF"),
    Case[string, string](Name = "predicate", Input = "{x > 1}? A", Expected = "pred:x > 1 id:A EOF"),
    Case[string, string](Name = "tokens block is punctuation", Input = "tokens { A, B }", Expected = "id:tokens { id:A , id:B } EOF"),
    Case[string, string](Name = "options block", Input = "options { k = 2; }", Expected = "id:options { id:k = int:2 ; } EOF"),
)

func TestLexErrors(t T) T = RunCases[string, string](t,
    (sub, in, want) => Eq(sub, kinds(in), want),
    Case[string, string](Name = "string", Input = "a 'b", Expected = "error: 1:3: unterminated string literal"),
    Case[string, string](Name = "string newline", Input = "'b\n'", Expected = "error: 1:1: unterminated string literal"),
    Case[string, string](Name = "comment", Input = "\n  /* x", Expected = "error: 2:3: syntax error: unterminated comment"),
    Case[string, string](Name = "set", Input = "[abc", Expected = "error: 1:1: syntax error: unterminated character set"),
    Case[string, string](Name = "action", Input = "{ { }", Expected = "error: 1:1: syntax error: unterminated action"),
    Case[string, string](Name = "comment in action", Input = "{ a /* }", Expected = "error: 1:5: syntax error: unterminated comment"),
    Case[string, string](Name = "character", Input = "a $", Expected = "error: 1:3: syntax error: unexpected character '$'"),
)

func TestParseModel(t T) T {
    val src = "lexer grammar L;\noptions { superClass = Base; }\nchannels { EXTRA }\n@header {package x}\nID: [a-z]+ -> channel(EXTRA);\nfragment D: '0'..'9';\n"
    val (t1, g) = parseOrFail(t, src)
    val want = Grammar(
        Kind = LexerOnly(),
        Name = "L",
        Options = ArrayOf(OptionEntry("superClass", "Base")),
        Channels = ArrayOf("EXTRA"),
        Actions = ArrayOf(NamedAction(None(), "header", "package x")),
        Rules = ArrayOf(
            Rule("ID", false, ArrayOf(Alt(
                ArrayOf[Element](Repeat(CharSet("a-z"), Plus(true))),
                None(),
                ArrayOf(LexerCommand("channel", Some("EXTRA"))),
            ))),
            Rule("D", true, ArrayOf(Alt(ArrayOf[Element](Range("0", "9")), None(), EmptyArray[LexerCommand]()))),
        ),
    )
    Eq(t1, StripPositions(g), want)
}

func TestParsePrintsElements(t T) T = RunCases[string, string](t,
    (sub, in, want) => Eq(sub, ruleText(in), want),
    Case[string, string](Name = "sequence", Input = "a : b C 'd' ;", Expected = "a: b C 'd';\n"),
    Case[string, string](Name = "alternatives", Input = "a: b | c # Lc | ;", Expected = "a\n    : b\n    | c # Lc\n    | \n    ;\n"),
    Case[string, string](Name = "quantifiers", Input = "a: b? c* d+ e?? f*? g+?;", Expected = "a: b? c* d+ e?? f*? g+?;\n"),
    Case[string, string](Name = "labels", Input = "a: x=b ys+=c* z=(d|e);", Expected = "a: x=b ys+=c* z=(d | e);\n"),
    Case[string, string](Name = "not and wildcard", Input = "A: ~[\\r\\n]* . ~('a'|'b');", Expected = "A: ~[\\r\\n]* . ~('a' | 'b');\n"),
    Case[string, string](Name = "non-greedy comment", Input = "C: '/*' .*? '*/' -> channel(HIDDEN);", Expected = "C: '/*' .*? '*/' -> channel(HIDDEN);\n"),
    Case[string, string](Name = "commands", Input = "WS: [ \\t]+ -> skip, pushMode(X);", Expected = "WS: [ \\t]+ -> skip, pushMode(X);\n"),
    Case[string, string](Name = "actions and predicates", Input = "a: {p()}? b {act();};", Expected = "a: {p()}? b {act();};\n"),
    Case[string, string](Name = "fragment", Input = "fragment F: 'f';", Expected = "fragment F: 'f';\n"),
    Case[string, string](Name = "nested blocks", Input = "a: (b (c | d)+)?;", Expected = "a: (b (c | d)+)?;\n"),
)

func TestParseErrors(t T) T = RunCases[string, string](t,
    (sub, in, want) => Eq(sub, errorOf(in), want),
    Case[string, string](Name = "no header", Input = "a: b;", Expected = "1:1: syntax error: expected 'grammar', found 'a'"),
    Case[string, string](Name = "missing semicolon", Input = "grammar g;\na: b\nc: d;", Expected = "3:2: syntax error: expected ';', found ':'"),
    Case[string, string](Name = "unbalanced paren", Input = "grammar g;\na: (b;", Expected = "2:6: syntax error: expected ')', found ';'"),
    Case[string, string](Name = "lowercase fragment", Input = "grammar g;\nfragment a: 'x';", Expected = "2:10: syntax error: fragment rule 'a' must be a lexer rule (uppercase name)"),
    Case[string, string](Name = "rule arguments", Input = "grammar g;\na[int x]: b;", Expected = "2:2: galop does not support rule arguments yet"),
    Case[string, string](Name = "returns", Input = "grammar g;\na returns [int x]: b;", Expected = "2:3: galop does not support 'returns' yet"),
    Case[string, string](Name = "element options", Input = "grammar g;\na: <assoc=right> b;", Expected = "2:4: galop does not support element options yet"),
    Case[string, string](Name = "imports", Input = "grammar g;\nimport Other;", Expected = "2:1: galop does not support grammar imports yet"),
    Case[string, string](Name = "bad range", Input = "grammar g;\nA: 'a'..B;", Expected = "2:9: syntax error: expected a literal after '..', found 'B'"),
    Case[string, string](Name = "lex error surfaces", Input = "grammar g;\nA: 'a", Expected = "2:4: unterminated string literal"),
)

func TestParseErrorCodes(t T) T = RunCases[string, int](t,
    (sub, in, want) => Eq(sub, Parse(in) match {
        case Left(d) => d.Code
        case Right(_) => 0
    }, want),
    Case[string, int](Name = "syntax error", Input = "a: b;", Expected = 50),
    Case[string, int](Name = "unterminated string", Input = "grammar g;\nA: 'a", Expected = 152),
    Case[string, int](Name = "unsupported", Input = "grammar g;\nimport Other;", Expected = 500),
)

// checkText runs Check on src and renders each diagnostic as `code line:col: message`.
func checkText(src string) string = Parse(src) match {
    case Right(g) => Check(g).Map((d) => s"${d.Code} ${d.String()}").MkString("; ")
    case Left(d) => "parse error: " + d.String()
}

func TestCheck(t T) T = RunCases[string, string](t,
    (sub, in, want) => Eq(sub, checkText(in), want),
    Case[string, string](Name = "valid", Input = "grammar g;\ntokens { T }\na: B T EOF 'x';\nB: F;\nfragment F: 'f';", Expected = ""),
    Case[string, string](Name = "undefined rule", Input = "grammar g;\na: b;", Expected = "56 2:4: reference to undefined rule: b"),
    Case[string, string](Name = "every undefined use", Input = "grammar g;\na: b x=b;", Expected = "56 2:4: reference to undefined rule: b; 56 2:8: reference to undefined rule: b"),
    Case[string, string](
        Name = "implicit token, once per name",
        Input = "grammar g;\na: B (B | C)*;",
        Expected = "125 2:4: implicit definition of token B in parser; 125 2:11: implicit definition of token C in parser",
    ),
    Case[string, string](Name = "undefined lexer rule", Input = "grammar g;\nA: B;", Expected = "56 2:4: reference to undefined rule: B"),
    Case[string, string](Name = "duplicate", Input = "grammar g;\na: 'x';\na: 'y';", Expected = "51 3:1: rule a redefinition; previous at line 2"),
    Case[string, string](Name = "lexer refs parser", Input = "grammar g;\na: 'x';\nB: a;", Expected = "160 3:4: reference to parser rule a in lexer rule B"),
    Case[string, string](Name = "parser refs fragment", Input = "grammar g;\na: F;\nfragment F: 'f';", Expected = "501 2:4: reference to fragment rule F in parser rule a"),
    Case[string, string](Name = "parser rule in lexer grammar", Input = "lexer grammar g;\na: 'x';", Expected = "53 2:1: parser rule a not allowed in lexer"),
    Case[string, string](Name = "lexer rule in parser grammar", Input = "parser grammar g;\nA: 'x';", Expected = "52 2:1: lexer rule A not allowed in parser"),
    Case[string, string](Name = "parser grammar without a vocabulary", Input = "parser grammar g;\na: B;", Expected = "125 2:4: implicit definition of token B in parser"),
    Case[string, string](Name = "tokenVocab supplies the tokens", Input = "parser grammar g;\noptions { tokenVocab = L; }\na: B;", Expected = ""),
    Case[string, string](Name = "no rules", Input = "lexer grammar Empty;", Expected = "99 1:15: grammar Empty has no rules"),
    Case[string, string](Name = "results in source order", Input = "grammar g;\nb: y;\na: x;\nb: 'z';", Expected = "56 2:4: reference to undefined rule: y; 56 3:4: reference to undefined rule: x; 51 4:1: rule b redefinition; previous at line 2"),
)

func TestCheckSeverity(t T) T = Parse("grammar g;\na: B;") match {
    case Right(g) => Eq(t, Check(g).Map(_.IsError()), ArrayOf(false))
    case Left(d) => Fail(t, d.String())
}

func TestPositions(t T) T {
    val (t1, g) = parseOrFail(t, "grammar P;\noptions { k = 2; }\nexpr\n    : x=atom ('+' atom)* # Sum\n    | ~(A | B)\n    ;\nfragment F: 'a'..'z' .;\n")
    val expr = g.Rules.Get(0)
    val located = expr.Located().Map((l) => s"${FormatElement(l.Element)}@${l.Pos.Line}:${l.Pos.Col}")
    val t2 = Eq(t1, g.Pos, Pos(1, 9))
    val t3 = Eq(t2, g.Options.Map(_.Pos), ArrayOf(Pos(2, 11)))
    val t4 = Eq(t3, expr.Pos, Pos(3, 1))
    val t5 = Eq(t4, g.Rules.Get(1).Pos, Pos(7, 10))
    val t6 = Eq(t5, located, ArrayOf(
        "x=atom@4:7", "atom@4:9", "('+' atom)*@4:14", "('+' atom)@4:14", "'+'@4:15", "atom@4:19",
        "~(A | B)@5:7", "(A | B)@5:8", "A@5:9", "B@5:13",
    ))
    Eq(t6, g.Rules.Get(1).Located().Map((l) => l.Pos), ArrayOf(Pos(7, 13), Pos(7, 22)))
}

func TestLabeledRepeatPositions(t T) T {
    val (t1, g) = parseOrFail(t, "grammar P;\na: xs+=b* c;\n")
    val located = g.Rules.Get(0).Located().Map((l) => s"${FormatElement(l.Element)}@${l.Pos.Col}")
    Eq(t1, located, ArrayOf("xs+=b*@4", "xs+=b@4", "b@8", "c@11"))
}

func TestPositionsDoNotAffectEquality(t T) T {
    val (t1, a) = parseOrFail(t, "grammar g;\na: b;\nb: 'x';\n")
    val (t2, b) = parseOrFail(t1, "grammar g;\n\n\na  :  b ;   b : 'x' ;\n")
    val t3 = IsFalse(t2, std.Equal(a, b))
    IsTrue(t3, std.Equal(StripPositions(a), StripPositions(b)))
}

func TestCodeBuiltRulesHaveNoPositions(t T) T {
    val r = Rule("a", false, ArrayOf(Alt(ArrayOf[Element](RuleRef("b")), None(), EmptyArray[LexerCommand]())))
    Eq(t, r.Located().Map(_.Pos), ArrayOf(NoPos))
}


// featureGrammar uses every construct the reader supports.
val featureGrammar = `/** doc */
grammar Features;

options { language = Go; tokenVocab = 'Lex'; k = 2; }
tokens { EXTRA, MORE, }
channels { COMMENTS }
@header { package x }
@parser::members { func f() { if a { b() } } }

start : stmt* EOF ;
stmt
    : 'let' name=ID '=' expr ';'      # Let
    | exprs+=expr (',' exprs+=expr)*  # Exprs
    | {p.ok()}? ID {act()}            # Guarded
    |                                 # Empty
    ;
expr: atom (('+' | '-') atom)*? ;
atom: ID | INT | '(' expr ')' | ~(';' | ',') ;
ID : [a-zA-Z_] [a-zA-Z_0-9]* ;
INT: DIGIT+ ;
fragment DIGIT: '0'..'9' ;
STR: '"' (~["\\\r\n] | '\\' .)* '"' ;
WS : [ \t\r\n]+ -> skip ;
LINE_COMMENT: '//' ~[\r\n]* -> channel(COMMENTS) ;
BLOCK_COMMENT: '/*' .*? '*/' -> channel(HIDDEN), type(EXTRA) ;
`

func TestFeatureGrammarRoundTrips(t T) T {
    val (t1, g) = parseOrFail(t, featureGrammar)
    val t2 = Eq(t1, RoundTrip(g), None[string]())
    val t3 = Eq(t2, Check(g).MkString("; "), "")
    val t4 = Eq(t3, g.Tokens, ArrayOf("EXTRA", "MORE"))
    val t5 = Eq(t4, g.Options.Map((o) => o.Name + "=" + o.Value).MkString(" "), "language=Go tokenVocab='Lex' k=2")
    val t6 = Eq(t5, g.Actions.Map((a) => a.Scope.GetOrElse("") + ":" + a.Name).MkString(" "), ":header parser:members")
    Eq(t6, g.Rules.Size(), 11)
}

func TestFormatIsCanonical(t T) T {
    val (t1, g) = parseOrFail(t, "grammar g;\na : b | c ;\nb:'x';c:'y';")
    Eq(t1, Format(g), "grammar g;\n\na\n    : b\n    | c\n    ;\n\nb: 'x';\n\nc: 'y';\n")
}

func TestRoundTripReportsDifferences(t T) T {
    // A model the parser cannot produce: a quantifier on a quantifier prints as
    // (b*)?, which reads back with an extra block around b*.
    val odd = Grammar(
        Kind = Combined(),
        Name = "g",
        Rules = ArrayOf(Rule("a", false, ArrayOf(Alt(
            ArrayOf[Element](Repeat(Repeat(RuleRef("b"), Star(true)), Optional(true))),
            None(),
            EmptyArray[LexerCommand](),
        )))),
    )
    RoundTrip(odd) match {
        case Some(msg) => Contains(t, msg, "rule 'a' changed")
        case None() => Fail(t, "expected the round trip to report a difference")
    }
}
