package g4

import (
    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/diag"
)

// Check reports the semantic problems parsing alone does not catch, as
// diagnostics with ANTLR's codes where ANTLR reports the same problem: a
// grammar with no rules, rule redefinitions, parser rules in a lexer grammar
// (and the reverse), references to undefined rules, lexer rules that
// reference parser rules, parser rules that reference fragments, and (a
// warning) tokens a parser rule uses that nothing defines, which ANTLR then
// defines implicitly. The result is in source order and empty for a valid
// grammar. Diagnostics carry the position of the offending name (none for a
// grammar built in code) and no file.
func Check(g Grammar) Array[diag.Diagnostic] {
    val noRules = if (g.Rules.IsEmpty()) ArrayOf(at(diag.NoRules.New(g.Name), g.Pos)) else EmptyArray[diag.Diagnostic]()
    val redefinitions = g.Rules.ZipWithIndex().Collect((ri) => {
        val (r, i) = ri
        g.Rules.Take(i).Find(_.Name == r.Name).Map((prev) =>
            at(diag.RuleRedefinition.New(r.Name, s"${prev.Pos.Line}"), r.Pos)
        )
    })
    val kindErrors = g.Rules.Collect((r) => ruleKindError(g.Kind, r).Map((d) => at(d, r.Pos)))
    val refErrors = g.Rules.FlatMap((r) => r.Located().Collect((l) => refProblem(g, r, l.Element).Map((d) => at(d, l.Pos))))
    diag.InSourceOrder(noRules.AppendAll(redefinitions).AppendAll(kindErrors).AppendAll(refErrors).AppendAll(implicitTokens(g)))
}

// at places d at p.
func at(d diag.Diagnostic, p Pos) diag.Diagnostic = d.At(p.Line, p.Col)

func ruleKindError(kind GrammarKind, r Rule) Option[diag.Diagnostic] = kind match {
    case LexerOnly() if !r.IsLexer() => Some(diag.ParserRulesNotAllowed.New(r.Name))
    case ParserOnly() if r.IsLexer() => Some(diag.LexerRulesNotAllowed.New(r.Name))
    case _ => None()
}

// refProblem checks one element of rule r that names a rule or token.
func refProblem(g Grammar, r Rule, e Element) Option[diag.Diagnostic] = e match {
    case TokenRef(name) => {
        val target = g.Rules.Find(_.Name == name)
        if (r.IsLexer())
            When(target.IsEmpty() && name != "EOF", diag.UndefinedRuleRef.New(name))
        else
            When(target.Filter(_.Fragment).IsDefined(), diag.FragmentRefInParserRule.New(name, r.Name))
    }
    case RuleRef(name) =>
        if (r.IsLexer()) Some(diag.ParserRuleRefInLexerRule.New(name, r.Name))
        else When(!g.Rules.Exists(_.Name == name), diag.UndefinedRuleRef.New(name))
    case _ => None()
}

// implicitTokens warns once, at its first use, about each token a parser rule
// references that no lexer rule or `tokens {}` entry defines. ANTLR defines
// such a token anyway (atn.BuildVocabulary numbers it last). A grammar that
// imports its vocabulary with the tokenVocab option gets its tokens from
// elsewhere and is not checked.
func implicitTokens(g Grammar) Array[diag.Diagnostic] {
    if g.Options.Exists(_.Name == "tokenVocab") {
        return EmptyArray[diag.Diagnostic]()
    }
    val uses = g.Rules.Filter((r) => !r.IsLexer()).FlatMap(_.Located()).Collect({
        case Located(TokenRef(name), pos) if !isDeclaredToken(g, name) => (name, pos)
    })
    val firsts = uses.FoldLeft(EmptyArray[Tuple[string, Pos]](), (acc, first) =>
        if (acc.Exists(_.V1 == first.V1)) acc else acc.Append(first)
    )
    firsts.Map((first) => at(diag.ImplicitTokenDefinition.New(first.V1), first.V2))
}

func isDeclaredToken(g Grammar, name string) bool =
    name == "EOF" || g.Tokens.Contains(name) || g.Rules.Exists(_.Name == name)
