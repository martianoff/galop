package g4

import (
    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/diag"
)

// Check reports the semantic problems parsing alone does not catch, as
// diagnostics with ANTLR's codes where ANTLR reports the same problem: a
// grammar with no rules, rule redefinitions, parser rules in a lexer grammar
// (and the reverse), references to undefined rules, lexer rules that
// reference parser rules, parser rules that reference fragments, and (a
// warning) tokens a parser rule uses that nothing defines, which ANTLR then
// defines implicitly. The result is in source order and empty for a valid
// grammar. Diagnostics carry the position of the offending name (none for a
// grammar built in code) and no file.
func Check(g Grammar) Array[diag.Diagnostic] {
    val noRules = g.Rules match {
        case Array() => ArrayOf(At(diag.NoRules.New(g.Name), g.Pos))
        case _ => EmptyArray[diag.Diagnostic]()
    }
    val redefinitions = g.Rules.ZipWithIndex().Collect((ri) => {
        val (r, i) = ri
        g.Rules.Take(i).Find(_.Name == r.Name).Map((prev) =>
            At(diag.RuleRedefinition.New(r.Name, s"${prev.Pos.Line}"), r.Pos)
        )
    })
    val kindErrors = g.Rules.Collect((r) => ruleKindError(g.Kind, r).Map((d) => At(d, r.Pos)))
    val refErrors = g.Rules.FlatMap((r) =>
        r.Located().Collect((l) => refProblem(g, r, l.Element).Map((d) => At(d, l.Pos)))
    )
    val all = noRules.AppendAll(redefinitions).AppendAll(kindErrors).AppendAll(refErrors).AppendAll(assocProblems(g))
        .AppendAll(repeatedSections(g)).AppendAll(actionRedefinitions(g))
    diag.InSourceOrder(all.AppendAll(tokenRedefinitions(g)).AppendAll(implicitTokens(g)))
}

// repeatedSections are ANTLR's error 54 at the second `options`, `import` or
// `tokens` section of g, if it has one; a third is not reported, as in ANTLR.
func repeatedSections(g Grammar) Array[diag.Diagnostic] =
    ArrayOf("options", "import", "tokens").Collect((k) =>
        g.Sections.Filter(_.Keyword == k).Drop(1).HeadOption().Map((s) => At(diag.RepeatedPrequel.New(), s.Pos)))

// actionRedefinitions are ANTLR's error 94 for a named action defined twice
// in one scope, found as ANTLR's SymbolChecks finds them. ANTLR checks a
// combined grammar's actions twice: in the lexer it extracts (when the grammar
// has lexer rules or literals), which gets every action, and in the parser,
// which keeps those not scoped to the lexer. A duplicate both see is reported
// twice, as ANTLR reports it.
func actionRedefinitions(g Grammar) Array[diag.Diagnostic] = g.Kind match {
    case LexerOnly() => actionPass(g.Actions, "lexer")
    case ParserOnly() => actionPass(g.Actions, "parser")
    case Combined() => {
        val hasLexer = g.Rules.Exists(_.IsLexer()) || ImplicitLiterals(g).NonEmpty()
        val inLexer = if (hasLexer) actionPass(g.Actions, "lexer") else EmptyArray[diag.Diagnostic]()
        inLexer.AppendAll(actionPass(g.Actions.Filter((a) => a.Scope.GetOrElse("") != "lexer"), "parser"))
    }
}

// actionPass reports each action whose scope and name an earlier one has. As
// in ANTLR's SymbolChecks, an action written without a scope is in the scope
// of the last action written with one (defaultScope until there is one), not
// always in defaultScope.
func actionPass(actions Array[NamedAction], defaultScope string) Array[diag.Diagnostic] {
    val start = (defaultScope, EmptyHashSet[string](), EmptyArray[diag.Diagnostic]())
    val (_, _, found) = actions.FoldLeft(start, (acc, a) => {
        val (last, seen, out) = acc
        val scope = a.Scope.GetOrElse(last)
        val key = scope + "::" + a.Name
        if (seen.Contains(key)) (scope, seen, out.Append(At(diag.ActionRedefinition.New(a.Name), a.Pos)))
        else (scope, seen.Add(key), out)
    })
    found
}

// tokenRedefinitions are ANTLR's warning 108 for a `tokens {}` name that is
// already a token when ANTLR defines it: EOF, a name listed before it, or in a
// combined grammar a token of its lexer (a non-fragment lexer rule or an
// implicit literal token, T__0 ...). A lexer grammar's `tokens {}` is not
// checked, nor is a grammar's whose tokenVocab option supplies its tokens.
func tokenRedefinitions(g Grammar) Array[diag.Diagnostic] = g.Kind match {
    case LexerOnly() => EmptyArray[diag.Diagnostic]()
    case _ if g.Options.Exists(_.Name == "tokenVocab") => EmptyArray[diag.Diagnostic]()
    case Combined() => tokensDefinedAgain(g, ArrayTabulate(ImplicitLiterals(g).Size(), ImplicitTokenName)
        .AppendAll(g.Rules.Collect({ case r if r.IsLexer() && !r.Fragment => r.Name })))
    case ParserOnly() => tokensDefinedAgain(g, EmptyArray[string]())
}

// tokensDefinedAgain reports each `tokens {}` name that EOF, lexerTokens or
// an earlier `tokens {}` name already defines.
func tokensDefinedAgain(g Grammar, lexerTokens Array[string]) Array[diag.Diagnostic] {
    val start = (lexerTokens.FoldLeft(EmptyHashSet[string]().Add("EOF"), (s, n) => s.Add(n)), EmptyArray[diag.Diagnostic]())
    val (_, found) = g.Tokens.Zip(TokenPositions(g)).FoldLeft(start, (acc, tp) => {
        val (defined, out) = acc
        val (name, pos) = tp
        if (defined.Contains(name)) (defined, out.Append(At(diag.TokenNameReassignment.New(name), pos)))
        else (defined.Add(name), out)
    })
    found
}

// assocProblems are ANTLR's warning 84 for an `assoc` option whose value is
// neither left nor right (ANTLR then takes left), on a rule's alternatives.
func assocProblems(g Grammar) Array[diag.Diagnostic] = g.Rules.FlatMap((r) => r.Alts.FlatMap((a) =>
    a.Options.Collect({
        case o if o.Name == "assoc" && o.Value != "left" && o.Value != "right" => At(diag.IllegalOptionValue.New(o.Name, o.Value), o.Pos)
    })
))

// At places d at p, in p's file when p has one (a position in an imported
// grammar).
func At(d diag.Diagnostic, p Pos) diag.Diagnostic = d.At(p.Line, p.Col).In(p.File)

func ruleKindError(kind GrammarKind, r Rule) Option[diag.Diagnostic] = kind match {
    case LexerOnly() if !r.IsLexer() => Some(diag.ParserRulesNotAllowed.New(r.Name))
    case ParserOnly() if r.IsLexer() => Some(diag.LexerRulesNotAllowed.New(r.Name))
    case _ => None()
}

// refProblem checks one element of rule r that names a rule or token.
func refProblem(g Grammar, r Rule, e Element) Option[diag.Diagnostic] = e match {
    case TokenRef(name) => {
        val target = g.Rules.Find(_.Name == name)
        if (r.IsLexer())
            When(target.IsEmpty() && name != "EOF", diag.UndefinedRuleRef.New(name))
        else
            When(target.Filter(_.Fragment).IsDefined(), diag.FragmentRefInParserRule.New(name, r.Name))
    }
    case RuleRef(name) =>
        if (r.IsLexer()) Some(diag.ParserRuleRefInLexerRule.New(name, r.Name))
        else When(!g.Rules.Exists(_.Name == name), diag.UndefinedRuleRef.New(name))
    case _ => None()
}

// implicitTokens warns once, at its first use, about each token a parser rule
// references that no lexer rule or `tokens {}` entry defines. ANTLR defines
// such a token anyway (atn.BuildVocabulary numbers it last). A grammar that
// imports its vocabulary with the tokenVocab option gets its tokens from
// elsewhere and is not checked.
func implicitTokens(g Grammar) Array[diag.Diagnostic] {
    if g.Options.Exists(_.Name == "tokenVocab") {
        return EmptyArray[diag.Diagnostic]()
    }
    val uses = g.Rules.Filter((r) => !r.IsLexer()).FlatMap(_.Located()).Collect({
        case Located(TokenRef(name), pos) if !isDeclaredToken(g, name) => (name, pos)
    })
    val firsts = uses.FoldLeft(EmptyArray[Tuple[string, Pos]](), (acc, first) =>
        if (acc.Exists(_.V1 == first.V1)) acc else acc.Append(first)
    )
    firsts.Map((first) => At(diag.ImplicitTokenDefinition.New(first.V1), first.V2))
}

func isDeclaredToken(g Grammar, name string) bool =
    name == "EOF" || g.Tokens.Contains(name) || LexerTokenNames(g).Contains(name) || g.Rules.Exists((r) => r.Name == name && r.Fragment)
