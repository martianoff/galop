package lexgen

import (
    "strconv"
    gostrings "strings"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/atn"
)

// The `native` flavor's token runtime: the token types and the token, token
// list and error types every native file of a grammar shares. The lexer file
// carries it; the parser file of a grammar with no lexer rules carries it
// instead. Every exported name starts with the grammar's prefix (`Gala`), so
// generated code from several grammars can share a package.

// nativeNames are the names, after the prefix, that the native flavor's
// generated code declares itself. A token named like one of them (`Tokens`)
// gets a trailing underscore in its constant (`GalaTokens_`).
val nativeNames = ArrayOf(
    "EOF", "Token", "Tokens", "HiddenToken", "SyntaxError", "TokenName", "Lex", "LexAt",
    "LiteralNames", "SymbolicNames", "DefaultChannel", "HiddenChannel", "RuleNames", "AltNames",
    "Tree", "NodeData", "NodeRef", "Terminal", "Child", "TokenLabel", "EscapeWhitespace",
)

// NativeTokenName is token name's constant in the native flavor, after the
// prefix: the name, escaped if the runtime declares it (see nativeNames) or
// if it could clash with a channel or rule constant.
func NativeTokenName(name string) string =
    if (nativeNames.Contains(name) || gostrings.HasPrefix(name, "Channel") || gostrings.HasPrefix(name, "RULE_")) name + "_" else name

// NativeTokenRuntime renders the token runtime of vocab, with the grammar's
// `channels {}` names, for the grammar named grammar; exported is the prefix
// of every exported name.
func NativeTokenRuntime(vocab atn.Vocabulary, channels Array[string], exported string, grammar string) string {
    val literals = literalNames(vocab)
    val types = ArrayOf(ConstLine(exported + "EOF", "-1", "")).AppendAll(ArrayTabulate(vocab.MaxType(), (k) => k + 1).Map((t) =>
        ConstLine(exported + NativeTokenName(vocab.Names.Get(t)), strconv.Itoa(t), literals.Get(t))
    ))
    val chans = ArrayOf(ConstLine(exported + "DefaultChannel", "0", ""), ConstLine(exported + "HiddenChannel", "1", ""))
        .AppendAll(channels.ZipWithIndex().Map((ci) => ConstLine(s"${exported}Channel${ci.V1}", strconv.Itoa(ci.V2 + 2), "")))
    val consts = s"// ${exported}EOF and the constants below are the token types of the $grammar grammar,\n" +
        "// numbered as ANTLR numbers them.\n" +
        GoConstBlock(types) + "\n" +
        "// Token channels: a parser reads the tokens on the default channel; the\n" +
        "// others hold off-channel tokens such as comments.\n" +
        GoConstBlock(chans) + "\n" +
        GoStrings(s"${exported}LiteralNames", literals, "are the token types' literal names, by type, as ANTLR lists them.") + "\n" +
        GoStrings(s"${exported}SymbolicNames", symbolicNames(vocab), "are the token types' symbolic names, by type, as ANTLR lists them.") + "\n"
    consts + fill(goTokenRuntimeTemplate, "@X@", exported, "@GRAMMAR@", grammar, "@MAXTYPE@", strconv.Itoa(vocab.MaxType()))
}

// ConstLine is one line of a Go const block: name, value and an optional
// trailing comment.
struct ConstLine(Name string, Value string, Comment string)

// GoConstBlock renders a const block laid out as gofmt lays it out: the names
// padded to the longest, and the comments of each run of consecutive
// commented lines in one column.
func GoConstBlock(lines Array[ConstLine]) string {
    val nameWidth = lines.FoldLeft(0, (w, l) => if (l.Name.Size() > w) l.Name.Size() else w)
    // A run of commented lines ends at each line without a comment.
    val runs = lines.FoldLeft(EmptyArray[int](), (acc, l) =>
        acc.Append(if (acc.IsEmpty()) 0 else if (l.Comment == "") acc.Last() + 1 else acc.Last())
    )
    val valueWidth = (run int) => lines.ZipWithIndex().FoldLeft(0, (w, li) =>
        if (runs.Get(li.V2) == run && li.V1.Comment != "" && li.V1.Value.Size() > w) li.V1.Value.Size() else w
    )
    val rendered = lines.ZipWithIndex().Map((li) => {
        val l = li.V1
        val head = "\t" + l.Name + gostrings.Repeat(" ", nameWidth - l.Name.Size()) + " = " + l.Value
        if (l.Comment == "") head
        else head + gostrings.Repeat(" ", valueWidth(runs.Get(li.V2)) - l.Value.Size()) + " // " + l.Comment
    })
    "const (\n" + rendered.MkString("\n") + "\n)\n"
}

// goTokenRuntimeTemplate is the token, token list and error types. @X@ is the
// exported prefix.
val goTokenRuntimeTemplate = `// @X@Token is one token: its type, the byte span [Start, End) of its text in
// the source, and the line (from 1) and column (in code points, from 0) where
// it starts, as ANTLR counts them. The EOF token is empty and sits at the end
// of the input.
type @X@Token struct {
	Type       int32
	Start, End int32
	Line       int32
	Column     int32
}

// Text is the token's text in src, or "<EOF>" for the EOF token, as ANTLR
// shows it.
func (t @X@Token) Text(src string) string {
	if t.Type == @X@EOF {
		return "<EOF>"
	}
	return src[t.Start:t.End]
}

// @X@TokenName is how ANTLR names token type t in messages: its literal, its
// symbolic name, or <EOF>.
func @X@TokenName(t int32) string {
	switch {
	case t == @X@EOF:
		return "<EOF>"
	case t <= 0 || t > @MAXTYPE@:
		return "<" + strconv.Itoa(int(t)) + ">"
	case @X@LiteralNames[t] != "":
		return @X@LiteralNames[t]
	}
	return @X@SymbolicNames[t]
}

// @X@HiddenToken is a token on a channel other than the default one, such as
// a comment. Next is the index in Tokens of the first default-channel token
// after it, so the comments in front of a token are cheap to find.
type @X@HiddenToken struct {
	@X@Token
	Channel int32
	Next    int32
}

// @X@SyntaxError is a problem in the input at a line (from 1) and column (in
// code points, from 0). Its text is ANTLR's for the same problem.
type @X@SyntaxError struct {
	Line, Column int
	Msg          string
}

func (e *@X@SyntaxError) Error() string {
	return "line " + strconv.Itoa(e.Line) + ":" + strconv.Itoa(e.Column) + " " + e.Msg
}

// @X@Tokens is a lexed input: the default-channel tokens a parser reads,
// ending with EOF; the other channels' tokens, in input order; and the token
// recognition errors, after each of which lexing went on.
//
// A program may change token types before parsing, as long as it keeps the
// slices' order and the EOF token; the parser reads only Tokens.
type @X@Tokens struct {
	Src    string
	Tokens []@X@Token
	Hidden []@X@HiddenToken
	Errors []@X@SyntaxError
}

// Text is the text of token i.
func (ts *@X@Tokens) Text(i int) string { return ts.Tokens[i].Text(ts.Src) }

// HiddenBefore is the off-channel tokens between token i-1 and token i (all
// those before token 0 for i == 0): the comments in front of token i.
func (ts *@X@Tokens) HiddenBefore(i int) []@X@HiddenToken {
	lo, hi := 0, len(ts.Hidden)
	for lo < hi {
		mid := int(uint(lo+hi) >> 1)
		if int(ts.Hidden[mid].Next) < i {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	end := lo
	for end < len(ts.Hidden) && int(ts.Hidden[end].Next) == i {
		end++
	}
	return ts.Hidden[lo:end]
}
`

// goNativeLexerTemplate is the native lexer: the token loop over the DFA. @X@
// is the exported prefix, @P@ the prefix of the internal names.
val goNativeLexerTemplate = `
// @X@Lex lexes src from line 1, column 0. See @X@LexAt.
func @X@Lex(src string) *@X@Tokens { return @X@LexAt(src, 1, 0) }

// @X@LexAt lexes src with the @GRAMMAR@ grammar's lexer, counting lines from
// line and the first line's columns from column (for text cut from a larger
// input). It gives the tokens ANTLR 4.13.1's lexer gives, with their types,
// channels, text, lines and columns: skipped tokens are dropped and
// off-channel ones go to Hidden. Where no token matches it records ANTLR's
// token recognition error and skips what ANTLR's lexer skips, so it always
// reaches the end of the input.
//
// Matching runs a DFA computed when the code was generated (@STATS@).
// Its tables are immutable, so lexing on many goroutines at once is safe.
func @X@LexAt(src string, line, column int) *@X@Tokens {
	ts := &@X@Tokens{Src: src, Tokens: make([]@X@Token, 0, len(src)/4+1)}
	at := @P@Pos{line: line, colBase: -column}
	var m @P@Result
	for at.off < len(src) {
		start := at
		channel := int32(@X@DefaultChannel)
		ttype := int32(@P@More)
		for ttype == @P@More {
			@P@Match(src, at, &m)
			switch {
			case m.accepted:
				at = m.end
				ttype = m.ttype
				if m.channel >= 0 {
					channel = m.channel
				}
			case m.stop.off >= len(src) && m.stop.index == at.index:
				// A "more" token ran into the end of the input: ANTLR emits
				// EOF from where that token started.
				ts.Tokens = append(ts.Tokens, @X@Token{@X@EOF, int32(start.off), int32(at.off), int32(start.line), int32(start.column())})
				return ts
			default:
				ts.recognitionError(start, m.stop)
				at = m.stop
				if at.off < len(src) {
					at = at.advance(@P@At(src, at.off))
				}
				ttype = @P@Skip
			}
		}
		if ttype == @P@Skip {
			continue
		}
		tok := @X@Token{ttype, int32(start.off), int32(at.off), int32(start.line), int32(start.column())}
		if channel == @X@DefaultChannel {
			ts.Tokens = append(ts.Tokens, tok)
		} else {
			ts.Hidden = append(ts.Hidden, @X@HiddenToken{tok, channel, int32(len(ts.Tokens))})
		}
	}
	ts.Tokens = append(ts.Tokens, @X@Token{@X@EOF, int32(at.off), int32(at.off), int32(at.line), int32(at.column())})
	return ts
}

// recognitionError records that no token starts at start, having scanned to
// stop, with ANTLR's message: the text from start through the code point at stop.
func (ts *@X@Tokens) recognitionError(start, stop @P@Pos) {
	end := stop.off
	if end < len(ts.Src) {
		_, size := @P@At(ts.Src, end)
		end += size
	}
	ts.Errors = append(ts.Errors, @X@SyntaxError{start.line, start.column(), "token recognition error at: '" + ts.Src[start.off:end] + "'"})
}

// @P@Skip and @P@More are the token types of ANTLR's skip and more commands.
const (
	@P@Skip = -3
	@P@More = -2
)
`
