package lexgen

import (
    "strconv"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/codegen"
)

// The Python target's `native` flavor lexer: a module with no dependency that
// turns a string into token arrays, as the Go native lexer does. It runs the
// scanner the `antlr` flavor runs (pyTables) and reports token recognition
// errors as ANTLR's Python runtime words them.

// NativePythonLexerFile generates the native Python lexer of in's grammar as
// file name.
func NativePythonLexerFile(in codegen.Input, opts codegen.Options, name string) Either[Array[string], codegen.OutputFile] =
    buildDFA(in, opts).Map((d) => codegen.OutputFile(name, EmitNativePython(d, in.Grammar.Name, in.Grammar.Channels)))

// pyNativeNames are the module-level names the native lexer declares itself.
// A token named like one of them (`Tokens`) gets a trailing underscore.
val pyNativeNames = ArrayOf(
    "EOF", "Token", "Tokens", "HiddenToken", "LexError", "lex", "token_name",
    "LITERAL_NAMES", "SYMBOLIC_NAMES", "DEFAULT_CHANNEL", "HIDDEN_CHANNEL",
)

// NativePyName is token or channel name's constant in the native Python
// modules: escaped as ANTLR's Python target escapes it (PyName), and with a
// trailing underscore when the runtime declares the name itself.
func NativePyName(name string) string = if (pyNativeNames.Contains(name)) name + "_" else PyName(name)

// EmitNativePython renders d as the native flavor's Python lexer module for
// the grammar named grammar, with its `channels {}` names. Unlike the antlr
// flavor's class, it knows every token type of the grammar, the parser's
// `tokens {}` included, and its name lists are indexed by type, as the
// native parser will share them.
func EmitNativePython(d DFA, grammar string, channels Array[string]) string {
    val vocab = d.Model.ATN.Vocab
    val types = ArrayTabulate(vocab.MaxType(), (k) => k + 1).Map((t) => {
        val lit = vocab.LiteralName(t).Map((l) => "  # " + l).GetOrElse("")
        s"${NativePyName(vocab.Names.Get(t))} = $t$lit"
    })
    val chans = ArrayOf("DEFAULT_CHANNEL = 0", "HIDDEN_CHANNEL = 1")
        .AppendAll(channels.ZipWithIndex().Map((ci) => s"${NativePyName(ci.V1)} = ${ci.V2 + 2}"))
    val names = ArrayOf(
        pyModuleList("LITERAL_NAMES", literalNames(vocab), "are the token types' literal names, by type, as ANTLR lists them."),
        pyModuleList("SYMBOLIC_NAMES", symbolicNames(vocab), "are the token types' symbolic names, by type, as ANTLR lists them."),
    ).MkString("\n")
    fill(
        pyNativeLexerTemplate,
        "@GRAMMAR@", grammar,
        "@GRAMMARFILE@", grammar + ".g4",
        "@STATS@", dfaStats(d),
        "@TYPES@", types.MkString("\n"),
        "@CHANNELS@", chans.MkString("\n"),
        "@NAMES@", names,
        "@MAXTYPE@", strconv.Itoa(vocab.MaxType()),
    ) + pyTables(d)
}

// pyModuleList renders a documented module-level list of strings, eight to a line.
func pyModuleList(name string, values Array[string], doc string) string =
    s"# $name $doc\n$name = [\n" + values.Grouped(8).Map((row) => "    " + row.Map((v) => strconv.Quote(v)).MkString(", ") + ",").MkString("\n") + "\n]\n"

// pyNativeLexerTemplate is the native lexer module before its scanner tables.
val pyNativeLexerTemplate = `# Generated by galop from @GRAMMARFILE@. DO NOT EDIT.
"""The lexer of the @GRAMMAR@ grammar, generated by galop.

lex(src) gives the tokens ANTLR 4.13.1's lexer gives for src, with their
types, channels, text, lines and columns, as parallel arrays: skipped tokens
are dropped and off-channel ones go to Tokens.hidden. Where no token matches
it records ANTLR's token recognition error and skips what ANTLR's lexer skips,
so it always reaches the end of the input. It needs no runtime.

Matching runs a DFA computed when the code was generated (@STATS@).
"""

from bisect import bisect_left, bisect_right
from collections import namedtuple

# EOF and the constants below are the token types of the @GRAMMAR@ grammar,
# numbered as ANTLR numbers them.
EOF = -1
@TYPES@

# Token channels: a parser reads the tokens on the default channel; the others
# hold off-channel tokens such as comments.
@CHANNELS@

@NAMES@

def token_name(t):
    """How ANTLR names token type t in messages: its literal, its symbolic
    name, or <EOF>."""
    if t == EOF:
        return "<EOF>"
    if t <= 0 or t > @MAXTYPE@:
        return "<%d>" % t
    return LITERAL_NAMES[t] or SYMBOLIC_NAMES[t]


Token = namedtuple("Token", "type start end line column")
Token.__doc__ = """One token: its type, the span [start, end) of its text in the source,
in code points, and the line (from 1) and column (in code points, from 0)
where it starts, as ANTLR counts them. The EOF token is empty and sits at the
end of the input."""

HiddenToken = namedtuple("HiddenToken", "type start end line column channel next")
HiddenToken.__doc__ = """A token on a channel other than the default one, such as a comment.
next is the index in Tokens of the first default-channel token after it."""


class LexError:
    """A token recognition error at a line (from 1) and column (in code points,
    from 0), with ANTLR's message."""

    __slots__ = ("line", "column", "msg")

    def __init__(self, line, column, msg):
        self.line = line
        self.column = column
        self.msg = msg

    def __str__(self):
        return "line %d:%d %s" % (self.line, self.column, self.msg)

    def __repr__(self):
        return "LexError(%d, %d, %r)" % (self.line, self.column, self.msg)

    def __eq__(self, other):
        return isinstance(other, LexError) and (self.line, self.column, self.msg) == (other.line, other.column, other.msg)

    def __hash__(self):
        return hash((self.line, self.column, self.msg))


class Tokens:
    """A lexed input: the default-channel tokens a parser reads, ending with
    EOF, as parallel lists (types, starts, ends, lines, columns); the other
    channels' tokens, in input order (hidden); and the token recognition
    errors, after each of which lexing went on.

    error_at is, for each of errors, the index of the first default-channel
    token after it. ANTLR's lexer runs as its token stream is read, so it
    reports errors[i] when a parser first reads token error_at[i].

    A program may change token types before parsing, as long as it keeps the
    lists' lengths and the EOF token; a parser reads only the types.
    """

    __slots__ = ("src", "types", "starts", "ends", "lines", "columns", "hidden", "errors", "error_at")

    def __init__(self, src, types, starts, ends, lines, columns, hidden, errors, error_at):
        self.src = src
        self.types = types
        self.starts = starts
        self.ends = ends
        self.lines = lines
        self.columns = columns
        self.hidden = hidden
        self.errors = errors
        self.error_at = error_at

    def __len__(self):
        return len(self.types)

    def token(self, i):
        """Token i as a Token."""
        return Token(self.types[i], self.starts[i], self.ends[i], self.lines[i], self.columns[i])

    def text(self, i):
        """The text of token i: its slice of src, or "<EOF>" for EOF."""
        if self.types[i] == EOF:
            return "<EOF>"
        return self.src[self.starts[i]:self.ends[i]]

    def hidden_text(self, i):
        """The text of off-channel token i."""
        h = self.hidden[i]
        return self.src[h.start:h.end]

    def hidden_before(self, i):
        """The off-channel tokens between token i-1 and token i (all those
        before token 0 for i == 0): the comments in front of token i."""
        lo = bisect_left(self.hidden, i, key=_next)
        return self.hidden[lo:bisect_right(self.hidden, i, lo=lo, key=_next)]


def _next(h):
    return h.next


_SKIP = -3
_MORE = -2


def _display(s):
    """s as ANTLR's Python runtime shows it in an error message: newlines,
    carriage returns and tabs escaped."""
    return s.replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")


def lex(src, line=1, column=0):
    """Lexes src with the @GRAMMAR@ grammar's lexer, counting lines from line
    and the first line's columns from column (for text cut from a larger
    input)."""
    classes = _classes(src)
    n = len(classes)
    types = []
    starts = []
    ends = []
    lines = []
    columns = []
    hidden = []
    errors = []
    error_at = []
    at = 0
    while at < n:
        start, start_line, start_column = at, line, column
        channel = DEFAULT_CHANNEL
        ttype = _MORE
        while ttype == _MORE:
            end, ttype, ch, stop = _match(classes, at, n)
            if end >= 0:
                if ch >= 0:
                    channel = ch
            elif stop >= n and stop == at:
                # A "more" token ran into the end of the input: ANTLR emits
                # EOF from where that token started.
                types.append(EOF)
                starts.append(start)
                ends.append(at)
                lines.append(start_line)
                columns.append(start_column)
                return Tokens(src, types, starts, ends, lines, columns, hidden, errors, error_at)
            else:
                # ANTLR reports the text from the token's start through the
                # code point the scan stopped at, then skips that one.
                errors.append(LexError(start_line, start_column,
                                       "token recognition error at: '" + _display(src[start:stop + 1]) + "'"))
                error_at.append(len(types))
                end = stop + 1 if stop < n else stop
                ttype = _SKIP
            # Count lines as ANTLR's lexer does: one after each "\n".
            k = src.count("\n", at, end)
            if k:
                line += k
                column = end - src.rfind("\n", at, end) - 1
            else:
                column += end - at
            at = end
        if ttype == _SKIP:
            continue
        if channel == DEFAULT_CHANNEL:
            types.append(ttype)
            starts.append(start)
            ends.append(at)
            lines.append(start_line)
            columns.append(start_column)
        else:
            hidden.append(HiddenToken(ttype, start, at, start_line, start_column, channel, len(types)))
    types.append(EOF)
    starts.append(at)
    ends.append(at)
    lines.append(line)
    columns.append(column)
    return Tokens(src, types, starts, ends, lines, columns, hidden, errors, error_at)
`
