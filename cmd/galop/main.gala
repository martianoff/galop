package main

import (
    "os"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/codegen"
    "github.com/martianoff/galop/golang"
    "github.com/martianoff/galop/tool"
)

// version is the galop release this binary was built from.
val version = "0.0.0-dev"

// targets are the code generators this binary ships. A language is added by
// adding its codegen.Target here.
func targets() Array[codegen.Target] = ArrayOf(golang.Target(version))

func main() {
    val kit = tool.Toolkit(Targets = targets(), Files = tool.OSFiles(), Version = version)
    val outcome = tool.Run(ArrayOf(os.Args...).Drop(1), kit)
    os.Stdout.WriteString(outcome.Stdout)
    os.Stderr.WriteString(outcome.Stderr)
    os.Exit(outcome.ExitCode)
}
