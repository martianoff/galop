module(
    name = "galop",
    # Tracks the latest tagged galop release. Bump in lockstep with the release
    # tag so registry consumers see a MODULE.bazel whose version matches the one
    # they requested.
    version = "0.2.1",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "gala", version = "0.93.1")
bazel_dep(name = "rules_gala", version = "0.3.2")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "gala_gazelle", version = "0.3.1", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.5")

# --- Differential harness (//differential) -----------------------------------
# Go code that runs ANTLR's own Go parser for gala.g4 next to galop's, so the
# two can be compared tree for tree and timed against each other.

bazel_dep(name = "rules_java", version = "9.3.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//differential:go.mod")
use_repo(go_deps, "com_github_antlr4_go_antlr_v4")

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

# The ANTLR tool, to generate the reference parser from gala.g4. 4.13.1 is the
# version the GALA compiler uses.
http_jar(
    name = "antlr4_tool",
    sha256 = "bc13a9c57a8dd7d5196888211e5ede657cb64a3ce968608697e4f668251a8487",
    urls = ["https://www.antlr.org/download/antlr-4.13.1-complete.jar"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# The differential corpus: every .gala file of the GALA compiler at the
# release testdata/grammars/gala.g4 was copied from.
http_archive(
    name = "gala_corpus",
    build_file_content = """
filegroup(
    name = "gala_files",
    srcs = glob(["**/*.gala"]),
    visibility = ["//visibility:public"],
)
""",
    # The GALA repository has BUILD files throughout, and a glob stops at a
    # package boundary: delete them so the one above sees every file.
    patch_cmds = ["find . -mindepth 2 \\( -name BUILD -o -name BUILD.bazel \\) -delete"],
    patch_cmds_win = ["Get-ChildItem -Recurse -File -Include BUILD,BUILD.bazel | Where-Object { $_.DirectoryName -ne (Get-Location).Path } | Remove-Item"],
    sha256 = "f8f3fdd79e36d4d954d8999a34de37e888637c08250fb0cd36e59443c3ff4784",
    strip_prefix = "gala-0.92.1",
    urls = ["https://github.com/martianoff/gala/archive/refs/tags/0.92.1.tar.gz"],
)

# The held-out corpus: GALA code galop was never tuned on, from three projects
# at pinned commits of their default branches. The tests compare galop with
# ANTLR on it as on the GALA corpus.
[http_archive(
    name = name,
    build_file_content = """
filegroup(
    name = "gala_files",
    srcs = glob(["**/*.gala"]),
    visibility = ["//visibility:public"],
)
""",
    patch_cmds = ["find . -mindepth 2 \\( -name BUILD -o -name BUILD.bazel \\) -delete"],
    patch_cmds_win = ["Get-ChildItem -Recurse -File -Include BUILD,BUILD.bazel | Where-Object { $_.DirectoryName -ne (Get-Location).Path } | Remove-Item"],
    sha256 = sha256,
    strip_prefix = repo + "-" + commit,
    urls = ["https://github.com/martianoff/%s/archive/%s.tar.gz" % (repo, commit)],
) for name, repo, commit, sha256 in [
    ("heldout_gala_team", "gala-team", "44e03ea2c32ca47fbbadb9bc780ec7a1720758dc", "91c3504b430c830e3ee18fbc9df771066f4d632c2cc184dc5de9d8361b5bbcb1"),
    ("heldout_gala_tui", "gala-tui", "c46554dd1e24a2074c4b99dd2294f30cbe955489", "c73c94b1b84a481d786f8e8402c3d4593bbf0bf9d5346de05c917c8ffff6624d"),
    ("heldout_gala_server", "gala-server", "ba67dc284908010cde53c7984a06288534c54dfb", "c013c4b8d8a3cf9a33ba99b6f7ebb1ed325ce628107a13b7d94f5f18cf950ad5"),
]]
