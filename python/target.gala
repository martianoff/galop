package python

import (
    "strconv"
    "strings"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/codegen"
    "github.com/martianoff/galop/g4"
    "github.com/martianoff/galop/lexgen"
)

// pythonTarget generates Python 3 (`-Dlanguage=Python3`, ANTLR's name for it).
struct pythonTarget()

// Target is the Python code generator. It writes lexers only, so far, in
// either flavor (see PythonFlavors).
func Target() codegen.Target = pythonTarget()

func (t pythonTarget) Language() string = "Python3"

// PythonFlavors are the values of the Python target's `flavor` option; the
// first is the default.
//
//   - `antlr`: `<base>GalopLexer.py`, a subclass of the ANTLR Python
//     runtime's Lexer, to use with ANTLR's generated parser.
//   - `native`: `<base>_lexer.py`, galop's own token arrays, with no
//     dependency; the native parser will read them.
val PythonFlavors = ArrayOf("antlr", "native")

func (t pythonTarget) Flavors() Array[string] = PythonFlavors

// native reports whether the `flavor` option picks the native flavor. The
// tool rejects other values before asking (error 508).
func native(opts codegen.Options) bool = opts.Define("flavor").Exists(_ == "native")

// baseName is the grammar name without the trailing `Lexer` of a lexer
// grammar: `ExprLexer` and `Expr` both give the class `ExprGalopLexer`.
func baseName(g g4.Grammar) string = g.Kind match {
    case g4.LexerOnly() if g.Name != "Lexer" => strings.TrimSuffix(g.Name, "Lexer")
    case _ => g.Name
}

// className is the antlr flavor's lexer class, which also names its file.
func className(g g4.Grammar) string = baseName(g) + "GalopLexer"

// lexerFileName names the lexer's file: the class for the antlr flavor; the
// base name lowercased, as a Python module is, for the native flavor
// (`expr_lexer.py`).
func lexerFileName(g g4.Grammar, opts codegen.Options) string =
    if (native(opts)) strings.ToLower(baseName(g)) + "_lexer.py" else className(g) + ".py"

// parserFileName names the native flavor's parser module (`expr_parser.py`).
func parserFileName(g g4.Grammar) string = strings.ToLower(baseName(g)) + "_parser.py"

// FileNames lists the lexer's file, for a grammar with lexer rules, and in the
// native flavor the parser's, for a combined grammar.
func (t pythonTarget) FileNames(g g4.Grammar, c atn.Compiled, opts codegen.Options) Array[string] = ArrayOf(
    c.Lexer.Map((_) => lexerFileName(g, opts)),
    c.Parser.Filter((_) => native(opts) && c.Lexer.IsDefined()).Map((_) => parserFileName(g)),
).Collect((n) => n)

// Generate writes the lexer of a lexer or combined grammar and, in the native
// flavor, the parser of a combined grammar; the antlr flavor leaves the parser
// to ANTLR. A parser grammar has nothing to generate yet.
func (t pythonTarget) Generate(in codegen.Input, opts codegen.Options) Either[Array[string], Array[codegen.OutputFile]] =
    in.Compiled.Lexer match {
        case Some(_) => {
            val name = lexerFileName(in.Grammar, opts)
            val lexer = if (native(opts)) lexgen.NativePythonLexerFile(in, opts, name)
                else lexgen.PythonLexerFile(in, opts, name, className(in.Grammar))
            val parser = nativeParserFile(in, opts, strings.TrimSuffix(name, ".py"))
            lexer match {
                case Right(l) => parser.Map((p) => ArrayOf(l).AppendAll(p))
                case Left(le) => Left(le.AppendAll(parser.Fold((pe) => pe, (_) => EmptyArray[string]())))
            }
        }
        case None() => Left(ArrayOf("Python3 target: only lexers are supported yet; use ANTLR's Python parser"))
    }

// nativeParserFile is the native flavor's parser module for a combined
// grammar, which imports the lexer module lexerModule; none otherwise. While
// the native parser is being built, a grammar it cannot parse yet gets a
// module that says why when imported, so that its lexer module is still
// written (see unsupported).
func nativeParserFile(in codegen.Input, opts codegen.Options, lexerModule string) Either[Array[string], Array[codegen.OutputFile]] =
    (in.Compiled.Parser, in.Analysis) match {
        case (Some(_), Some(an)) if native(opts) => {
            val code = unsupported(in.Compiled.Rules, an.Plans) match {
                case Array() => nativeParser(penv(
                    grammar = in.Grammar.Name,
                    lexerModule = lexerModule,
                    vocab = in.Compiled.Vocab,
                    rules = in.Compiled.Rules,
                    plans = an.Plans,
                ))
                case problems => unsupportedModule(in.Grammar.Name, problems)
            }
            Right(ArrayOf(codegen.OutputFile(parserFileName(in.Grammar), code)))
        }
        case _ => Right(EmptyArray[codegen.OutputFile]())
    }

// unsupportedModule is a parser module that raises NotImplementedError,
// with problems, when imported.
func unsupportedModule(grammar string, problems Array[string]) string =
    s"# Generated by galop from $grammar.g4. DO NOT EDIT.\n" +
        s"\"\"\"galop cannot generate the native Python parser of the $grammar grammar yet.\n\n" +
        problems.Map((m) => m + "\n").MkString("") + "\"\"\"\n\n" +
        "raise NotImplementedError(\n" + problems.Map((m) => "    " + strconv.Quote(m + "; ")).MkString("\n") + "\n)\n"
