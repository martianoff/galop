package python

import (
    "strings"

    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"

    "github.com/martianoff/galop/analysis"
    "github.com/martianoff/galop/codegen"
    "github.com/martianoff/galop/g4"
    "github.com/martianoff/galop/grammartest"
    "github.com/martianoff/galop/repair"
)

// generate runs the Python target on grammar src with no options.
func generate(src string) Tuple[Array[string], Either[Array[string], Array[codegen.OutputFile]]] {
    val (g, c) = grammartest.Compile(src)
    (Target().FileNames(g, c, codegen.Options()), Target().Generate(codegen.Input(g, c, None()), codegen.Options()))
}

// lexerOf is the one file generate writes for src, or "" when it writes none.
func lexerOf(src string) Tuple[string, string] = generate(src).V2 match {
    case Right(files) => files.HeadOption().Map((f) => (f.Name, f.Content)).GetOrElse(("", ""))
    case Left(_) => ("", "")
}

// TestCombinedGrammarGetsALexer checks that a combined grammar gets its lexer
// only, named after the grammar, with the token constants ANTLR's Python
// lexer declares: those of the lexer's rules and implicit literals, not a
// name only the parser's tokens {} declares.
func TestCombinedGrammarGetsALexer(t T) T {
    val src = "grammar Expr;\ntokens { EXTRA }\ns : 'x' ID None EOF ;\nID : [a-z]+ ;\nNone : 'none' ;\n"
    val (names, _) = generate(src)
    val (name, code) = lexerOf(src)
    val t1 = Eq(t, names, ArrayOf("ExprGalopLexer.py"))
    val t2 = Eq(t1, name, "ExprGalopLexer.py")
    val t3 = IsTrue(t2, strings.Contains(code, "class ExprGalopLexer(Lexer):"))
    val t4 = IsTrue(t3, strings.Contains(code, "    T__0 = 1\n    ID = 2\n    None_ = 3\n"))
    val t5 = IsTrue(t4, !strings.Contains(code, "EXTRA"))
    IsTrue(t5, strings.Contains(code, "\"<INVALID>\", \"'x'\", \"'none'\","))
}

// TestLexerGrammarName checks that a lexer grammar's trailing Lexer is
// dropped from the class name, as from the Go target's names.
func TestLexerGrammarName(t T) T =
    Eq(t, lexerOf("lexer grammar CalcLexer;\nINT : [0-9]+ ;\n").V1, "CalcGalopLexer.py")

// TestParserGrammarHasNothingToGenerate checks the message for a grammar with
// no lexer rules: the target writes lexers only.
func TestParserGrammarHasNothingToGenerate(t T) T {
    val (names, result) = generate("parser grammar P;\ns : A EOF ;\n")
    val t1 = Eq(t, names, EmptyArray[string]())
    Eq(t1, result.Fold((msgs) => msgs.MkString("; "), (_) => ""), "Python3 target: only lexers are supported yet; use ANTLR's Python parser")
}

// TestNativeFlavorWritesAModule checks the native flavor's file name, a
// module named after the grammar's base name in lower case, and that its
// constants include a name only the parser's tokens {} declares, which the
// native parser will share.
func TestNativeFlavorWritesAModule(t T) T {
    val (g, c) = grammartest.Compile("grammar Expr;\ntokens { EXTRA }\ns : ID EXTRA? EOF ;\nID : [a-z]+ ;\n")
    val opts = codegen.Options(Defines = ArrayOf(g4.OptionEntry("flavor", "native")))
    val t1 = Eq(t, Target().FileNames(g, c, opts), ArrayOf("expr_lexer.py", "expr_parser.py"))
    Target().Generate(codegen.Input(g, c, Some(analysis.Analyze(c.Parser.Get(), repair.PlanFor(g, c), true))), opts) match {
        case Right(files) => {
            val code = files.Head().Content
            val t2 = Eq(t1, files.Map(_.Name), ArrayOf("expr_lexer.py", "expr_parser.py"))
            val t3 = IsTrue(t2, strings.Contains(code, "\nID = 1\nEXTRA = 2\n"))
            IsTrue(t3, strings.Contains(code, "def lex(src, line=1, column=0):"))
        }
        case Left(msgs) => Eq(t1, msgs.MkString("; "), "")
    }
}

// nativeFiles generates the native flavor's files for src.
func nativeFiles(src string) Array[codegen.OutputFile] {
    val (g, c) = grammartest.Compile(src)
    val opts = codegen.Options(Defines = ArrayOf(g4.OptionEntry("flavor", "native")))
    Target().Generate(codegen.Input(g, c, Some(analysis.Analyze(c.Parser.Get(), repair.PlanFor(g, c), true))), opts).Fold((_) => EmptyArray[codegen.OutputFile](), (files) => files)
}

// TestNativeParserRules checks the parser module's rule methods: a labeled
// alternative records its number, a token label its number, and a decision
// settled by two tokens reads the second.
func TestNativeParserRules(t T) T {
    val files = nativeFiles("grammar Expr;\ns : a=ID '=' ID # set | ID # get ;\nID : [a-z]+ ;\nWS : ' '+ -> skip ;\n")
    val code = files.Find(_.Name == "expr_parser.py").Map(_.Content).GetOrElse("")
    val t1 = IsTrue(t, strings.Contains(code, "    def _r0(self):\n        # s\n        mark, start, alt = len(self.kids), self.pos, 0\n"))
    val t2 = IsTrue(t1, strings.Contains(code, "            alt = 1\n            self.labs.append((1, self._match(ID)))\n"))
    val t3 = IsTrue(t2, strings.Contains(code, "            t2 = self._la(2)\n"))
    IsTrue(t3, strings.Contains(code, "def parse_s(tokens):"))
}

// TestNativeParserLeftRecursion checks a left-recursive rule's method: it
// takes the precedence it is called with, and a loop iteration makes the
// node so far the next one's first child.
func TestNativeParserLeftRecursion(t T) T {
    val files = nativeFiles("grammar E;\ns : e EOF ;\ne : e '*' e | e '+' e | ID ;\nID : [a-z]+ ;\n")
    val code = files.Find(_.Name == "e_parser.py").Map(_.Content).GetOrElse("")
    val t1 = IsTrue(t, strings.Contains(code, "    def _r1(self, _p):"))
    val t2 = IsTrue(t1, strings.Contains(code, "prev = self._finish(1, 0, start, mark, labs)\n"))
    IsTrue(t2, strings.Contains(code, "child = self._r1(0)"))
}

// TestNativeParserErrors checks that a failed parse reports ANTLR's error:
// the parse stops, and _parse replays ANTLR's parser over the error tables,
// which name a literal token as ANTLR's Python parser does.
func TestNativeParserErrors(t T) T {
    val files = nativeFiles("grammar E;\ns : ID '=' ID EOF ;\nID : [a-z]+ ;\n")
    val code = files.Find(_.Name == "e_parser.py").Map(_.Content).GetOrElse("")
    val t1 = IsTrue(t, strings.Contains(code, "    except _Stop:\n        raise _syntax_error(tokens, rule) from None\n"))
    val t2 = IsTrue(t1, strings.Contains(code, "class _Replay(_Predictor):"))
    IsTrue(t2, strings.Contains(code, "_DISPLAY = (\n    \"<INVALID>\", \"'='\", \"ID\",\n)\n"))
}

// TestNativeParserNotSupported checks that a grammar with actions still gets
// its lexer, and a parser module that says why it has no parser.
func TestNativeParserNotSupported(t T) T {
    val files = nativeFiles("grammar E;\ne : ID {print(1)} ;\nID : [a-z]+ ;\n")
    val t1 = Eq(t, files.Map(_.Name), ArrayOf("e_lexer.py", "e_parser.py"))
    val code = files.Find(_.Name == "e_parser.py").Map(_.Content).GetOrElse("")
    IsTrue(t1, strings.Contains(code, "raise NotImplementedError(") && strings.Contains(code, "actions and predicates are not supported: e"))
}
