package python

// The fixed parts of the native Python parser module: its header, the tree,
// the parser's core and the entry functions. @GRAMMAR@, @GRAMMARFILE@,
// @LEXER@, @RULE@ and @INDEX@ are filled in.

// headerTemplate starts the module: its docstring and the lexer module's
// names, which it re-exports.
val headerTemplate = `# Generated by galop from @GRAMMARFILE@. DO NOT EDIT.
"""The parser of the @GRAMMAR@ grammar, generated by galop.

parse_<rule>(tokens) parses the tokens of @LEXER@.lex (or a string, which it
lexes first) as that rule, from the first token, and returns the rule's Node:
the tree ANTLR 4.13.1's parser builds for the same input. On a syntax error it
raises ParseError. It needs no runtime.
"""

if "." in __name__:
    from .@LEXER@ import *  # noqa: F401,F403 (the token types, Tokens and lex)
    from .@LEXER@ import EOF, Tokens, lex
else:
    from @LEXER@ import *  # noqa: F401,F403
    from @LEXER@ import EOF, Tokens, lex

`

// treeTemplate is the parse tree: nodes in parallel lists, and handles on them.
val treeTemplate = `
class ParseError(Exception):
    """A syntax error at a line (from 1) and column (in code points, from 0),
    with ANTLR's message, msg: parse_<rule> raises the first one ANTLR's
    parser reports for the same tokens. token is the index of the offending
    token (-1 for none). An error of parse_<rule>_with_recovery also has node,
    the node of the rule being parsed when ANTLR reported it, and kids, the
    number of children it had then; read, the furthest token ANTLR's parse had
    read (it reports the lexer's errors up to there first); and expected, the
    token types ANTLR's getExpectedTokens() gives then, ascending, EOF first."""

    def __init__(self, line, column, msg, token=-1, node=-1, kids=0, read=-1, expected=()):
        super().__init__("line %d:%d %s" % (line, column, msg))
        self.line = line
        self.column = column
        self.msg = msg
        self.token = token
        self.node = node
        self.kids = kids
        self.read = read
        self.expected = expected


class Tree:
    """A parse tree: its tokens and its nodes, children before parents, in
    parallel lists. A node's kids are node indexes (>= 0) and tokens (-1 - the
    token's index); node_label is the number of the label a node is stored
    under in its parent's rule (0 for none), and token_labels lists the
    labeled tokens as (node, token index, label number).

    A tree a recovering parse built also has error tokens: error_kids holds
    (node, child position) for each, and a token index past the tokens is
    conjured[index - len(tokens)], a token ANTLR's recovery made up, as
    (type, text, line, column). read is how far ANTLR's parse read (see
    ParseError), -1 when no lexer error needs it."""

    __slots__ = ("tokens", "rule", "alt", "start", "stop", "kids", "node_label", "token_labels",
                 "error_kids", "conjured", "read")

    def __init__(self, tokens):
        self.tokens = tokens
        self.rule = []
        self.alt = []
        self.start = []
        self.stop = []
        self.kids = []
        self.node_label = []
        self.token_labels = []
        self.error_kids = ()
        self.conjured = ()
        self.read = -1

    def node(self, i):
        return Node(self, i)


def _escape_whitespace(s):
    return s.replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r")


class Terminal:
    """A token in the tree: its index in the tokens (past them, one the
    recovery made up), and whether it is an error token (ANTLR's ErrorNode)."""

    __slots__ = ("tree", "index", "is_error")

    def __init__(self, tree, index, is_error=False):
        self.tree = tree
        self.index = index
        self.is_error = is_error

    @property
    def type(self):
        tokens = self.tree.tokens
        if self.index >= len(tokens.types):
            return self.tree.conjured[self.index - len(tokens.types)][0]
        return tokens.types[self.index]

    def get_text(self):
        """The token's text; "<EOF>" for EOF, as ANTLR gives it."""
        tokens = self.tree.tokens
        if self.index >= len(tokens.types):
            return self.tree.conjured[self.index - len(tokens.types)][1]
        return tokens.text(self.index)

    def to_string_tree(self):
        return _escape_whitespace(self.get_text())

    def __repr__(self):
        return "Terminal(%r)" % self.get_text()


class Node:
    """A rule's node in the tree."""

    __slots__ = ("tree", "index")

    def __init__(self, tree, index):
        self.tree = tree
        self.index = index

    @property
    def rule(self):
        """The rule's index (a RULE_ constant)."""
        return self.tree.rule[self.index]

    @property
    def rule_name(self):
        return RULE_NAMES[self.tree.rule[self.index]]

    @property
    def alt(self):
        """The number of the rule's labeled alternative that matched, from 1;
        0 for a rule without alternative labels."""
        return self.tree.alt[self.index]

    @property
    def start(self):
        """The index of the node's first token."""
        return self.tree.start[self.index]

    @property
    def stop(self):
        """The index of the node's last token (start - 1 when it has none)."""
        return self.tree.stop[self.index]

    @property
    def children(self):
        tree = self.tree
        kids = tree.kids[self.index]
        if not tree.error_kids:
            return [Node(tree, k) if k >= 0 else Terminal(tree, -1 - k) for k in kids]
        errs, i = tree.error_kids, self.index
        return [Node(tree, k) if k >= 0 else Terminal(tree, -1 - k, (i, j) in errs) for j, k in enumerate(kids)]

    def get_text(self):
        """The text of the node's tokens, as ANTLR's getText gives it."""
        return "".join(c.get_text() for c in self.children)

    def to_string_tree(self):
        """The node as ANTLR's toStringTree writes it: (rule child ...)."""
        kids = self.children
        name = _escape_whitespace(self.rule_name)
        if not kids:
            return name
        return "(" + name + " " + " ".join(k.to_string_tree() for k in kids) + ")"

    def __repr__(self):
        return "Node(%s)" % self.rule_name

`

// parserTemplate is the parser's state and the helpers every rule uses.
val parserTemplate = `
class _Parser(_Predictor):
    """The state of one parse. stack holds the follow states of the rule
    calls being parsed, for full-context prediction."""

    __slots__ = ("ts", "types", "pos", "kids", "labs", "rule", "alt", "start", "stop",
                 "node_kids", "node_label", "token_labels", "stack", "peek", "dfas")

    def __init__(self, ts):
        self.ts = ts
        self.types = ts.types
        self.pos = 0
        self.kids = []
        self.labs = []
        self.rule = []
        self.alt = []
        self.start = []
        self.stop = []
        self.node_kids = []
        self.node_label = []
        self.token_labels = []
        self.stack = []
        # peek is the furthest token prediction read (see _Recovery.read).
        self.peek = 0
        self.dfas = _DFAS

    def _la(self, i):
        j = self.pos + i - 1
        types = self.types
        return types[j] if j < len(types) else types[-1]

    def _finish(self, rule, alt, start, mark, labs):
        """Adds the node of a rule that started at token start and whose
        children are kids[mark:], and returns its index."""
        node = len(self.rule)
        self.rule.append(rule)
        self.alt.append(alt)
        self.start.append(start)
        self.stop.append(self.pos - 1)
        kids = self.kids
        self.node_kids.append(kids[mark:])
        del kids[mark:]
        self.node_label.append(0)
        if len(self.labs) > labs:
            for label, tok in self.labs[labs:]:
                self.token_labels.append((node, tok, label))
            del self.labs[labs:]
        return node

    def _consume(self):
        """Adds the current token to the rule being parsed and moves past it;
        EOF is added but not passed."""
        i = self.pos
        self.kids.append(-1 - i)
        if self.types[i] != EOF:
            self.pos = i + 1
        return i

    def _match(self, ttype):
        if self.types[self.pos] != ttype:
            raise _Stop
        return self._consume()

    def _match_in(self, types):
        if self.types[self.pos] not in types:
            raise _Stop
        return self._consume()

    def _dead_end(self, decision, at):
        """No alternative of decision takes the input (prediction failed at
        token at): the parse stops, and _parse reports ANTLR's error."""
        raise _Stop

    def _automaton(self, decision, states, prec=0):
        """Runs a lookahead automaton: each state maps a token type to the
        next state, or to -alt where the decision is made. A token no edge
        takes goes to runtime prediction, as in a settled decision."""
        s = 0
        i = 0
        while True:
            i += 1
            nxt = states[s].get(self._la(i))
            if nxt is None:
                return self._adaptive(decision, prec)
            if nxt < 0:
                return -nxt
            s = nxt

    def _tree(self):
        tree = Tree(self.ts)
        tree.rule = self.rule
        tree.alt = self.alt
        tree.start = self.start
        tree.stop = self.stop
        tree.kids = self.node_kids
        tree.node_label = self.node_label
        tree.token_labels = self.token_labels
        return tree

`

// entryTemplate is one rule's entry function.
val entryTemplate = `
def parse_@RULE@(tokens):
    """Parses tokens (a Tokens, or a string to lex first) as @RULE@ and
    returns its Node; raises ParseError on a syntax error."""
    return _parse(tokens, @INDEX@)
`

// parseTemplate is the function every entry calls.
val parseTemplate = `
def _parse(tokens, rule):
    if isinstance(tokens, str):
        tokens = lex(tokens)
    if not tokens.types or tokens.types[-1] != EOF:
        raise ParseError(1, 0, "the tokens do not end with EOF")
    p = _Parser(tokens)
    try:
        root = _RULE_FUNCS[rule](p)
    except _Stop:
        raise _syntax_error(tokens, rule) from None
    return Node(p._tree(), root)


def merge_errors(tokens, root, errors):
    """The lexer's errors (tokens.errors) and the syntax errors of a
    recovering parse, which returned root and errors, in the order ANTLR
    reports them: its token stream lexes as its parser reads, so a lexer
    error comes before the first syntax error whose read reaches its
    error_at, and one past the tree's read is not reported."""
    out = []
    lexed, at, i = tokens.errors, tokens.error_at, 0
    for e in errors:
        while i < len(lexed) and at[i] <= e.read:
            out.append(lexed[i])
            i += 1
        out.append(e)
    read = root.tree.read
    while i < len(lexed) and at[i] <= read:
        out.append(lexed[i])
        i += 1
    return out
`
