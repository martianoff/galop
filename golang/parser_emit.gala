package golang

import (
    "strings"

    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/concurrent"

    "github.com/martianoff/galop/analysis"
    "github.com/martianoff/galop/atn"
)

// env is what emitting one grammar's parser needs.
struct env(
    names Names,
    pfx string,
    parserType string,
    vocab atn.Vocabulary,
    parser atn.ATN,
    rules Array[atn.RuleIR],
    plans Array[analysis.DecisionPlan],
    adaptive bool,
)

// tokenRef is the Go constant for token type t.
func (e env) tokenRef(t int) string = if (t == atn.TokenEOF) "antlr.TokenEOF" else e.names.TokenConst(e.vocab.Name(t))

// tokenList renders a token set as a Go case list.
func (e env) tokenList(set atn.IntervalSet) string = set.Values().Map((t) => e.tokenRef(t)).MkString(", ")

func (e env) ruleName(index int) string = e.rules.Get(index).Name

func (e env) ruleFunc(index int) string = "rule" + capitalize(e.ruleName(index))

// companionParser emits `<grammar>_galop_parser.go`.
func companionParser(e env, pkg string, version string, grammarFile string) string {
    val ruleCode = e.rules.Map((r) => Future(() => emitRule(e, r))).Map(_.Get())
    val decisionCode = e.plans.Map((plan) => Future(() => emitDecision(e, plan))).Map(_.Get())
    val imports = if (e.adaptive) ArrayOf("\"fmt\"", "\"slices\"", "", "\"github.com/antlr4-go/antlr/v4\"") else ArrayOf("\"fmt\"", "", "\"github.com/antlr4-go/antlr/v4\"")
    val parts = ArrayOf(
        s"// Code generated by galop $version from $grammarFile. DO NOT EDIT.\n",
        s"package $pkg\n",
        "import (\n" + imports.Map((i) => if (i == "") "" else "\t" + i).MkString("\n") + "\n)\n",
        tokenAssertions(e),
        parserCore(e),
        e.rules.Map((r) => entryMethod(e, r)).MkString("\n"),
        ruleCode.MkString("\n"),
        decisionCode.MkString("\n"),
    )
    val runtime = if (e.adaptive) ArrayOf(tables(e), strings.ReplaceAll(strings.ReplaceAll(predictorSource, "PARSER", e.parserType), "PFX", e.pfx)) else EmptyArray[string]()
    parts.AppendAll(runtime).MkString("\n")
}

// tokenAssertions makes the generated file fail to compile when galop's token
// numbering and ANTLR's disagree.
func tokenAssertions(e env) string {
    val lines = ArrayTabulate(e.vocab.MaxType(), (k) => k + 1).FlatMap((t) => ArrayOf(
        s"\t_ uint = ${e.tokenRef(t)} - $t",
        s"\t_ uint = $t - ${e.tokenRef(t)}",
    ))
    "// galop numbers tokens the way ANTLR does; these constants fail to compile if the two disagree.\nconst (\n" + lines.MkString("\n") + "\n)\n"
}

// parserCore is the parser struct and the helpers every rule uses.
func parserCore(e env) string {
    val p = e.parserType
    val x = e.pfx
    val predictor = if (e.adaptive) s"\n\tstack []int32\n\tpred  ${x}Predictor" else ""
    fill(`// PARSER parses GRAMMAR input with decisions galop made at generation time.
// It builds the same context objects as ANTLRPARSER. Each instance is
// single-use and not safe for concurrent use; separate instances are independent.
type PARSER struct {
	input antlr.TokenStream
	toks  []antlr.Token
	types []int32
	pos   intPREDICTOR
}

// NewPARSER reads the on-channel tokens of input for parsing.
func NewPARSER(input antlr.TokenStream) *PARSER {
	p := &PARSER{input: input}
	for {
		t := input.LT(1)
		p.toks = append(p.toks, t)
		p.types = append(p.types, int32(t.GetTokenType()))
		if t.GetTokenType() == antlr.TokenEOF {
			break
		}
		input.Consume()
	}
	return p
}

// PFXSyntaxError is where the parser gave up: the input is not in the language,
// or uses something the fast parser cannot decide.
type PFXSyntaxError struct {
	Token antlr.Token
	Msg   string
}

func (e *PFXSyntaxError) Error() string {
	return fmt.Sprintf("line %d:%d %s", e.Token.GetLine(), e.Token.GetColumn(), e.Msg)
}

func PFXTokenText(t antlr.Token) string {
	if t.GetTokenType() == antlr.TokenEOF {
		return "<EOF>"
	}
	return "'" + t.GetText() + "'"
}

// parse runs a rule function as an entry point and leaves the token stream just
// after the input it consumed.
func (p *PARSER) parse(rule func(antlr.ParserRuleContext, int) antlr.ParserRuleContext) (ctx antlr.ParserRuleContext, err error) {
	defer func() {
		p.input.Seek(p.toks[p.pos].GetTokenIndex())
		if r := recover(); r != nil {
			se, ok := r.(*PFXSyntaxError)
			if !ok {
				panic(r)
			}
			ctx, err = nil, se
		}
	}()
	return rule(nil, -1), nil
}

func (p *PARSER) la(i int) int32 {
	j := p.pos + i - 1
	if j >= len(p.types) {
		j = len(p.types) - 1
	}
	return p.types[j]
}

func (p *PARSER) enter(ctx antlr.ParserRuleContext) {
	ctx.SetStart(p.toks[p.pos])
}

func (p *PARSER) exit(ctx antlr.ParserRuleContext) {
	if p.pos > 0 {
		ctx.SetStop(p.toks[p.pos-1])
	} else {
		ctx.SetStop(nil)
	}
}

// consume adds the current token to ctx and moves past it; EOF is added but not passed.
func (p *PARSER) consume(ctx antlr.ParserRuleContext) antlr.Token {
	tok := p.toks[p.pos]
	ctx.AddTokenNode(tok)
	if p.types[p.pos] != antlr.TokenEOF {
		p.pos++
	}
	return tok
}

func (p *PARSER) match(ctx antlr.ParserRuleContext, ttype int32) antlr.Token {
	if p.types[p.pos] != ttype {
		panic(&PFXSyntaxError{p.toks[p.pos], "mismatched input " + PFXTokenText(p.toks[p.pos])})
	}
	return p.consume(ctx)
}

func (p *PARSER) matchIf(ctx antlr.ParserRuleContext, ok bool) antlr.Token {
	if !ok {
		panic(&PFXSyntaxError{p.toks[p.pos], "mismatched input " + PFXTokenText(p.toks[p.pos])})
	}
	return p.consume(ctx)
}

func (p *PARSER) noViableAlt(decision int) {
	panic(&PFXSyntaxError{p.toks[p.pos], "no viable alternative at input " + PFXTokenText(p.toks[p.pos])})
}
`, "PARSER", p, "PFX", x, "GRAMMAR", e.names.Grammar, "ANTLRPARSER", e.names.ParserType(), "PREDICTOR", predictor)
}

// entryMethod is the public method that parses input as one rule.
func entryMethod(e env, r atn.RuleIR) string {
    val iface = e.names.ContextInterface(r.Name)
    val method = e.names.RuleMethod(r.Name)
    fill(`// METHOD parses the input as RULE. On a syntax error it returns the error
// and no tree.
func (p *PARSER) METHOD() (IFACE, error) {
	ctx, err := p.parse(p.RULEFUNC)
	if err != nil {
		return nil, err
	}
	return ctx.(IFACE), nil
}
`, "METHOD", method, "IFACE", iface, "PARSER", e.parserType, "RULEFUNC", e.ruleFunc(r.Index), "RULE", r.Name)
}

// emitRule emits the function that parses one rule.
func emitRule(e env, r atn.RuleIR) string {
    val ctxType = e.names.Context(r.Name)
    val header = ArrayOf(
        s"func (p *${e.parserType}) ${e.ruleFunc(r.Index)}(parent antlr.ParserRuleContext, invokingState int) antlr.ParserRuleContext {",
        s"\tvar localctx antlr.ParserRuleContext = New$ctxType(nil, parent, invokingState)",
        "\tp.enter(localctx)",
    )
    val body = r.Decision match {
        case Some(d) => ArrayOf(s"\tswitch p.decide$d() {").AppendAll(r.Alts.ZipWithIndex().FlatMap((ai) => {
            val alt = ai.V1
            val altCtx = alt.Label.Map((l) => e.names.Context(l)).GetOrElse(ctxType)
            val relabel = alt.Label.Map((l) => ArrayOf(s"\t\tlocalctx = New${e.names.Context(l)}(nil, localctx)")).GetOrElse(EmptyArray[string]())
            ArrayOf(s"\tcase ${ai.V2 + 1}:").AppendAll(relabel).AppendAll(emitSteps(e, alt.Steps, "\t\t", altCtx))
        })).Append("\t}")
        case None() => r.Alts.FlatMap((alt) => emitSteps(e, alt.Steps, "\t", alt.Label.Map((l) => e.names.Context(l)).GetOrElse(ctxType)))
    }
    header.AppendAll(body).AppendAll(ArrayOf("\tp.exit(localctx)", "\treturn localctx", "}")).MkString("\n") + "\n"
}

func emitSteps(e env, steps Array[atn.Step], ind string, ctxType string) Array[string] =
    steps.FlatMap((s) => emitStep(e, s, ind, ctxType))

func emitStep(e env, s atn.Step, ind string, ctxType string) Array[string] = s match {
    case atn.MatchToken(t, label) => tokenStep(ind, s"p.match(localctx, ${e.tokenRef(t)})", label, ctxType)
    case atn.MatchSet(set, label) => tokenStep(ind, s"p.matchIf(localctx, ${setTest(e, set, "p.types[p.pos]")})", label, ctxType)
    case atn.CallRule(rule, follow, label) => {
        val push = if (e.adaptive) ArrayOf(s"$ind\tp.stack = append(p.stack, $follow)") else EmptyArray[string]()
        val pop = if (e.adaptive) ArrayOf(s"$ind\tp.stack = p.stack[:len(p.stack)-1]") else EmptyArray[string]()
        val store = label.Map((l) => {
            val field = s"localctx.(*$ctxType).${e.names.LabelField(l.Name)}"
            val value = s"child.(${e.names.ContextInterface(e.ruleName(rule))})"
            if (l.Append) s"$ind\t$field = append($field, $value)" else s"$ind\t$field = $value"
        })
        ArrayOf(s"$ind{")
            .AppendAll(push)
            .Append(s"$ind\tchild := p.${e.ruleFunc(rule)}(localctx, ${follow - 1})")
            .AppendAll(pop)
            .Append(s"$ind\tlocalctx.AddChild(child)")
            .AppendAll(store.Map((line) => ArrayOf(line)).GetOrElse(EmptyArray[string]()))
            .Append(s"$ind}")
    }
    case atn.Choose(d, alts, exitAlt) => ArrayOf(s"${ind}switch p.decide$d() {")
        .AppendAll(alts.ZipWithIndex().FlatMap((ai) =>
            ArrayOf(s"${ind}case ${atn.AltNumber(exitAlt, ai.V2)}:").AppendAll(emitSteps(e, ai.V1, ind + "\t", ctxType))
        ))
        .Append(s"$ind}")
    case atn.Loop(plus, d, cont, body) if plus => ArrayOf(s"${ind}for {")
        .AppendAll(emitSteps(e, body, ind + "\t", ctxType))
        .AppendAll(ArrayOf(s"$ind\tif p.decide$d() != $cont {", s"$ind\t\tbreak", s"$ind\t}", s"$ind}"))
    case atn.Loop(_, d, cont, body) => ArrayOf(s"${ind}for p.decide$d() == $cont {")
        .AppendAll(emitSteps(e, body, ind + "\t", ctxType))
        .Append(s"$ind}")
    case atn.RunAction(body) => ArrayOf(ind + strings.TrimSpace(body))
    case atn.CheckPredicate(body) => ArrayOf(s"${ind}if !(${strings.TrimSpace(body)}) {", s"$ind\tp.noViableAlt(-1)", s"$ind}")
}

// tokenStep matches one token and stores it in a label field, if any.
func tokenStep(ind string, call string, label Option[atn.LabelRef], ctxType string) Array[string] = label match {
    case None() => ArrayOf(ind + call)
    case Some(l) => {
        val field = s"localctx.(*$ctxType).${escape(l.Name)}"
        val store = if (l.Append) s"$field = append($field, tok)" else s"$field = tok"
        ArrayOf(s"$ind{", s"$ind\ttok := $call", s"$ind\t$store", s"$ind}")
    }
}

// setTest is a Go boolean expression testing whether v is in set.
func setTest(e env, set atn.IntervalSet, v string) string = set.Ranges.Map((r) =>
    if (r.Lo == r.Hi) s"$v == ${e.tokenRef(r.Lo)}" else s"($v >= ${r.Lo} && $v <= ${r.Hi})"
).MkString(" || ")

// emitDecision emits the function that picks an alternative of one decision.
func emitDecision(e env, plan analysis.DecisionPlan) string {
    val d = plan.Decision.Id
    val text = strings.ReplaceAll(plan.Decision.Text, "\n", " ")
    val body = emitLookahead(e, d, plan.Lookahead, "\t", atn.EmptySet())
    s"// decide$d decides ${e.ruleName(plan.Decision.Rule)}: $text\nfunc (p *${e.parserType}) decide$d() int {\n" + body.MkString("\n") + "\n}\n"
}

// emitLookahead emits the code of a lookahead tree. Cases are made disjoint
// (a token goes to the first case that has it), as Go requires.
func emitLookahead(e env, d int, la analysis.Lookahead, ind string, unused atn.IntervalSet) Array[string] = la match {
    case analysis.Predict(alt) => ArrayOf(s"${ind}return $alt")
    case analysis.Adaptive(_) => ArrayOf(s"${ind}return p.adaptivePredict($d)")
    case analysis.Switch(depth, cases) => {
        val subject = if (depth == 1) "p.types[p.pos]" else s"p.la($depth)"
        val disjoint = cases.FoldLeft(Tuple(EmptyArray[analysis.LookaheadCase](), atn.EmptySet()), (acc, c) => {
            val own = c.Tokens.Subtract(acc.V2)
            Tuple(if (own.IsEmpty()) acc.V1 else acc.V1.Append(analysis.LookaheadCase(own, c.Then)), acc.V2.Union(own))
        }).V1
        ArrayOf(s"${ind}switch $subject {")
            .AppendAll(disjoint.FlatMap((c) => ArrayOf(s"${ind}case ${e.tokenList(c.Tokens)}:").AppendAll(emitLookahead(e, d, c.Then, ind + "\t", unused))))
            .AppendAll(ArrayOf(s"$ind}", s"${ind}p.noViableAlt($d)", s"${ind}return 0"))
    }
}

// fill replaces each placeholder in template with its value; pairs alternate
// placeholder and value. Placeholders are upper-case words that cannot occur
// in the Go code around them.
func fill(template string, pairs ...string) string = strings.NewReplacer(pairs...).Replace(template)
