package golang

import (
    "strings"

    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/concurrent"

    "github.com/martianoff/galop/analysis"
    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/lexgen"
)

// env is what emitting one grammar's parser needs.
struct env(
    names Names,
    pfx string,
    parserType string,
    vocab atn.Vocabulary,
    parser atn.ATN,
    rules Array[atn.RuleIR],
    plans Array[analysis.DecisionPlan],
    adaptive bool,
    // brackets are the families adaptive prediction reads as one symbol.
    brackets analysis.Brackets = analysis.NoBrackets(),
    flavor Flavor = ANTLRFlavor(),
    // tokenLabels says whether some rule labels a token (`op=('+'|'-')`).
    tokenLabels bool = false,
    // repair says whether a failed SLL parse may be repaired (repair_go.gala)
    // rather than rerun in LL mode; see GrammarRepairable and Repairable.
    repair bool = false,
)

// Flavor is the output style of the Go target (see GoFlavors).
sealed type Flavor {
    // ANTLRFlavor builds ANTLR's context types from ANTLR's tokens.
    case ANTLRFlavor()
    // NativeFlavor builds galop's own tokens and tree; Exported starts every
    // exported name (`Gala`).
    case NativeFlavor(Exported string)
}

// exported is the native flavor's prefix of exported names.
func (e env) exported() string = e.flavor match {
    case NativeFlavor(x) => x
    case ANTLRFlavor() => ""
}

// tokenRef is the Go constant for token type t: ANTLR's (`galaParserIDENTIFIER`,
// antlr.TokenEOF), or the native flavor's own (`GalaIDENTIFIER`, `GalaEOF`).
func (e env) tokenRef(t int) string = e.flavor match {
    case NativeFlavor(x) => if (t == atn.TokenEOF) x + "EOF" else x + lexgen.NativeTokenName(e.vocab.Name(t))
    case ANTLRFlavor() => if (t == atn.TokenEOF) "antlr.TokenEOF" else e.names.TokenConst(e.vocab.Name(t))
}

// tokenList renders a token set as a Go case list.
func (e env) tokenList(set atn.IntervalSet) string = set.Values().Map((t) => e.tokenRef(t)).MkString(", ")

func (e env) ruleName(index int) string = e.rules.Get(index).Name

func (e env) ruleFunc(index int) string = "rule" + capitalize(e.ruleName(index))

// antlrParser emits the antlr flavor's `<grammar>_galop_parser.go`.
func antlrParser(e env, pkg string, version string, grammarFile string) string {
    val ruleCode = e.rules.Map((r) => Future(emitRule(e, r))).Map(_.Get())
    val decisionCode = e.plans.Map((plan) => Future(emitDecision(e, plan))).Map(_.Get())
    val imports = if (e.adaptive) ArrayOf("\"encoding/binary\"", "\"fmt\"", "\"slices\"", "\"sync\"", "\"sync/atomic\"", "", "\"github.com/antlr4-go/antlr/v4\"") else ArrayOf("\"fmt\"", "", "\"github.com/antlr4-go/antlr/v4\"")
    val parts = ArrayOf(
        s"// Code generated by galop $version from $grammarFile. DO NOT EDIT.\n",
        s"package $pkg\n",
        "import (\n" + imports.Map((i) => if (i == "") "" else "\t" + i).MkString("\n") + "\n)\n",
        tokenAssertions(e),
        parserCore(e),
        e.rules.Map((r) => entryMethod(e, r)).MkString("\n"),
        ruleCode.MkString("\n"),
        decisionCode.MkString("\n"),
    )
    val runtime = if (e.adaptive) ArrayOf(tables(e), predictor(e)) else EmptyArray[string]()
    parts.AppendAll(runtime).MkString("\n")
}

// predictor is the runtime predictor's Go code for e's parser, without the
// template's leading newline (the parts of a file are joined with one).
func predictor(e env) string {
    val (root, zero, syntaxError) = e.flavor match {
        case NativeFlavor(x) => ("int32", "-1", x + "SyntaxError")
        case ANTLRFlavor() => ("antlr.ParserRuleContext", "nil", e.pfx + "SyntaxError")
    }
    val code = fill(predictorSource + repairSource + fullCacheSource,
        "@RULE@", ruleFuncType(e), "@ROOT@", root, "@ZERO@", zero, "@SYNTAXERROR@", syntaxError,
        "PARSER", e.parserType, "PFX", e.pfx)
    strings.TrimPrefix(code, "\n")
}

// ruleFuncType is the Go type of a rule function as attempt takes it.
func ruleFuncType(e env) string = e.flavor match {
    case NativeFlavor(_) => s"func(*${e.parserType}) int32"
    case ANTLRFlavor() => "func(antlr.ParserRuleContext, int) antlr.ParserRuleContext"
}

// tokenAssertions makes the generated file fail to compile when galop's token
// numbering and ANTLR's disagree.
func tokenAssertions(e env) string {
    val lines = ArrayTabulate(e.vocab.MaxType(), (k) => k + 1).FlatMap((t) => ArrayOf(
        s"\t_ uint = ${e.tokenRef(t)} - $t",
        s"\t_ uint = $t - ${e.tokenRef(t)}",
    ))
    "// galop numbers tokens the way ANTLR does; these constants fail to compile if the two disagree.\nconst (\n" + lines.MkString("\n") + "\n)\n"
}

// predictorFields are the parser's fields for runtime prediction: pairs are
// the input's bracket pairs, and group says prediction reads bracketed groups.
func predictorFields(e env) string =
    if (e.adaptive) s"\n\tstack []int32\n\tll    bool\n\tpred  ${e.pfx}Predictor\n\trp    ${e.pfx}Repair\n\tllKey []byte\n\tpairs []int32\n\tgroup bool" else ""

// retryCode handles a failed SLL parse, whose result is in variable root.
// With runtime prediction the parse runs in SLL mode first, as GALA does with
// ANTLR; on a syntax error the result is ANTLR's LL parse (see llParse; an
// entry passes repair).
// After a failed first pass, prediction reads the tokens alone: the repair
// (or LL pass) is then exactly the one without bracket abstraction, so a parse
// that fails reports the error prediction over tokens finds. The repair starts
// with a pass over the tokens; only when the first pass met no conflict, where
// llParse would keep that pass's error, does the pass over tokens run first.
func retryCode(e env, root string) string =
    if (e.adaptive) s"\n\tif err != nil {\n\t\tgrouped := p.group\n\t\tp.group = false\n\t\tif grouped && p.rp.seen == 0 {\n\t\t\t$root, err = p.attempt(rule)\n\t\t}\n\t\tif err != nil {\n\t\t\t$root, err = p.llParse(rule, repair, err)\n\t\t}\n\t}" else ""

// parserCore is the parser struct and the helpers every rule uses.
func parserCore(e env) string {
    val p = e.parserType
    val x = e.pfx
    val predictor = predictorFields(e)
    val absMatch = bracketMatchLine(e)
    val retry = retryCode(e, "ctx")
    val resetStack = if (e.adaptive) "\n\tp.stack = p.stack[:0]\n\tp.rp.seen = 0" else ""
    fill(`// PARSER parses GRAMMAR input with decisions galop made at generation time.
// It builds the same context objects as ANTLRPARSER. Each instance is
// single-use and not safe for concurrent use; separate instances are independent.
type PARSER struct {
	input antlr.TokenStream
	toks  []antlr.Token
	types []int32
	pos   intPREDICTOR
}

// NewPARSER reads the on-channel tokens of input for parsing.
func NewPARSER(input antlr.TokenStream) *PARSER {
	p := &PARSER{input: input}
	if cts, ok := input.(*antlr.CommonTokenStream); ok {
		// Buffer the whole input first: its size bounds the on-channel tokens,
		// so the slices below are allocated once instead of grown.
		cts.Fill()
		p.toks = make([]antlr.Token, 0, cts.Size())
		p.types = make([]int32, 0, cts.Size())
	}
	for {
		t := input.LT(1)
		p.toks = append(p.toks, t)
		p.types = append(p.types, int32(t.GetTokenType()))
		if t.GetTokenType() == antlr.TokenEOF {
			break
		}
		input.Consume()
	}ABSMATCH
	return p
}

// PFXSyntaxError is where the parser gave up: the input is not in the language,
// or uses something the fast parser cannot decide.
type PFXSyntaxError struct {
	Token antlr.Token
	Msg   string
}

func (e *PFXSyntaxError) Error() string {
	return fmt.Sprintf("line %d:%d %s", e.Token.GetLine(), e.Token.GetColumn(), e.Msg)
}

func PFXTokenText(t antlr.Token) string {
	if t.GetTokenType() == antlr.TokenEOF {
		return "<EOF>"
	}
	return "'" + t.GetText() + "'"
}

// parse runs a rule function as an entry point and leaves the token stream just
// after the input it consumed. repair says whether a failed SLL parse may be
// repaired rather than rerun in LL mode (see llParse).
func (p *PARSER) parse(rule func(antlr.ParserRuleContext, int) antlr.ParserRuleContext, repair bool) (antlr.ParserRuleContext, error) {GROUPON
	ctx, err := p.attempt(rule)RETRY
	p.input.Seek(p.toks[p.pos].GetTokenIndex())
	return ctx, err
}

// attempt parses once from the first token; a syntax error is returned, not panicked.
func (p *PARSER) attempt(rule func(antlr.ParserRuleContext, int) antlr.ParserRuleContext) (ctx antlr.ParserRuleContext, err error) {
	p.pos = 0RESETSTACK
	defer func() {
		if r := recover(); r != nil {
			se, ok := r.(*PFXSyntaxError)
			if !ok {
				panic(r)
			}
			ctx, err = nil, se
		}
	}()
	return rule(nil, -1), nil
}

func (p *PARSER) la(i int) int32 {
	j := p.pos + i - 1
	if j >= len(p.types) {
		j = len(p.types) - 1
	}
	return p.types[j]
}

func (p *PARSER) enter(ctx antlr.ParserRuleContext) {
	ctx.SetStart(p.toks[p.pos])
}

func (p *PARSER) exit(ctx antlr.ParserRuleContext) {
	if p.pos > 0 {
		ctx.SetStop(p.toks[p.pos-1])
	} else {
		ctx.SetStop(nil)
	}
}

// consume adds the current token to ctx and moves past it; EOF is added but not passed.
func (p *PARSER) consume(ctx antlr.ParserRuleContext) antlr.Token {
	tok := p.toks[p.pos]
	ctx.AddTokenNode(tok)
	if p.types[p.pos] != antlr.TokenEOF {
		p.pos++
	}
	return tok
}

func (p *PARSER) match(ctx antlr.ParserRuleContext, ttype int32) antlr.Token {
	if p.types[p.pos] != ttype {
		panic(&PFXSyntaxError{p.toks[p.pos], "mismatched input " + PFXTokenText(p.toks[p.pos])})
	}
	return p.consume(ctx)
}

func (p *PARSER) matchIf(ctx antlr.ParserRuleContext, ok bool) antlr.Token {
	if !ok {
		panic(&PFXSyntaxError{p.toks[p.pos], "mismatched input " + PFXTokenText(p.toks[p.pos])})
	}
	return p.consume(ctx)
}

func (p *PARSER) noViableAlt(decision int) {
	panic(&PFXSyntaxError{p.toks[p.pos], "no viable alternative at input " + PFXTokenText(p.toks[p.pos])})
}
`, "PARSER", p, "PFX", x, "GRAMMAR", e.names.Grammar, "ANTLRPARSER", e.names.ParserType(), "PREDICTOR", predictor, "ABSMATCH", absMatch, "GROUPON", groupsOn(e), "RETRY", retry, "RESETSTACK", resetStack)
}

// entryMethod is the public method that parses input as one rule.
func entryMethod(e env, r atn.RuleIR) string {
    val iface = e.names.ContextInterface(r.Name)
    val method = e.names.RuleMethod(r.Name)
    fill(`// METHOD parses the input as RULE. On a syntax error it returns the error
// and no tree.
func (p *PARSER) METHOD() (IFACE, error) {
	ctx, err := p.parse(p.RULEFUNC, REPAIR)
	if err != nil {
		return nil, err
	}
	return ctx.(IFACE), nil
}
`, "METHOD", method, "IFACE", iface, "PARSER", e.parserType, "RULEFUNC", e.ruleFunc(r.Index), "RULE", r.Name,
        "REPAIR", s"${e.repair && Repairable(e.rules, r)}")
}

// emitRule emits the antlr flavor's function that parses one rule.
func emitRule(e env, r atn.RuleIR) string {
    val ctxType = e.names.Context(r.Name)
    val header = ArrayOf(
        s"func (p *${e.parserType}) ${e.ruleFunc(r.Index)}(parent antlr.ParserRuleContext, invokingState int) antlr.ParserRuleContext {",
        s"\tvar localctx antlr.ParserRuleContext = New$ctxType(nil, parent, invokingState)",
        "\tp.enter(localctx)",
    )
    // A labeled alternative first turns localctx into the label's context
    // (`# Only` makes an OnlyContext), as ANTLR does, whether or not the rule
    // has other alternatives.
    val body = ruleBody(e, r, (alt, ind) => alt.Label match {
        case Some(l) => ArrayOf(s"${ind}localctx = New${e.names.Context(l)}(nil, localctx)")
            .AppendAll(emitSteps(e, alt.Steps, ind, scope(CtxType = e.names.Context(l))))
        case None() => emitSteps(e, alt.Steps, ind, scope(CtxType = ctxType))
    })
    header.AppendAll(body).AppendAll(ArrayOf("\tp.exit(localctx)", "\treturn localctx", "}")).MkString("\n") + "\n"
}

// ruleBody emits a rule's alternatives with alt: a switch on the rule's
// decision when it has several.
func ruleBody(e env, r atn.RuleIR, alt func(atn.AltIR, string) Array[string]) Array[string] = r.Decision match {
    case Some(d) => ArrayOf(s"\tswitch p.decide$d() {").AppendAll(r.Alts.ZipWithIndex().FlatMap((ai) =>
        ArrayOf(s"\tcase ${ai.V2 + 1}:").AppendAll(alt(ai.V1, "\t\t"))
    )).Append("\t}")
    case None() => r.Alts.FlatMap((a) => alt(a, "\t"))
}

// scope is what emitting a step needs to know about its rule: the antlr
// flavor's context type, whose fields hold labels, or the native flavor's
// label numbering (a label's number is its position in Labels plus one).
struct scope(CtxType string = "", Labels Array[string] = EmptyArray[string]())

func emitSteps(e env, steps Array[atn.Step], ind string, sc scope) Array[string] =
    steps.FlatMap((s) => emitStep(e, s, ind, sc))

// emitStep emits one step. The flavors differ only in how a token is matched
// and how a rule's result is attached and labeled; the decisions are the same.
func emitStep(e env, s atn.Step, ind string, sc scope) Array[string] = s match {
    case atn.MatchToken(t, label) => tokenStep(e, ind, "match", e.tokenRef(t), label, sc)
    case atn.MatchSet(set, label, _) => tokenStep(e, ind, "matchIf", setTest(e, set, "p.types[p.pos]"), label, sc)
    case atn.CallRule(rule, follow, label) => {
        val push = if (e.adaptive) ArrayOf(s"$ind\tp.stack = append(p.stack, $follow)") else EmptyArray[string]()
        val pop = if (e.adaptive) ArrayOf(s"$ind\tp.stack = p.stack[:len(p.stack)-1]") else EmptyArray[string]()
        val (call, attach) = e.flavor match {
            case ANTLRFlavor() => (s"p.${e.ruleFunc(rule)}(localctx, ${follow - 1})", "localctx.AddChild(child)")
            case NativeFlavor(_) => (s"p.${e.ruleFunc(rule)}()", "p.kids = append(p.kids, child)")
        }
        val store = label match {
            case Some(l) => ArrayOf(ind + "\t" + ruleLabelStore(e, rule, l, sc))
            case None() => EmptyArray[string]()
        }
        ArrayOf(s"$ind{")
            .AppendAll(push)
            .Append(s"$ind\tchild := $call")
            .AppendAll(pop)
            .Append(s"$ind\t$attach")
            .AppendAll(store)
            .Append(s"$ind}")
    }
    case atn.Choose(d, alts, exitAlt) => ArrayOf(s"${ind}switch p.decide$d() {")
        .AppendAll(alts.ZipWithIndex().FlatMap((ai) =>
            ArrayOf(s"${ind}case ${atn.AltNumber(exitAlt, ai.V2)}:").AppendAll(emitSteps(e, ai.V1, ind + "\t", sc))
        ))
        .Append(s"$ind}")
    case atn.Loop(plus, d, cont, body) if plus => ArrayOf(s"${ind}for {")
        .AppendAll(emitSteps(e, body, ind + "\t", sc))
        .AppendAll(ArrayOf(s"$ind\tif p.decide$d() != $cont {", s"$ind\t\tbreak", s"$ind\t}", s"$ind}"))
    case atn.Loop(_, d, cont, body) => ArrayOf(s"${ind}for p.decide$d() == $cont {")
        .AppendAll(emitSteps(e, body, ind + "\t", sc))
        .Append(s"$ind}")
    case atn.RunAction(body) => ArrayOf(ind + strings.TrimSpace(body))
    case atn.CheckPredicate(body) => ArrayOf(s"${ind}if !(${strings.TrimSpace(body)}) {", s"$ind\tp.noViableAlt(-1)", s"$ind}")
}

// ruleLabelStore stores the rule's result child under label l: in the antlr
// flavor's context field, or as the native node's label number.
func ruleLabelStore(e env, rule int, l atn.LabelRef, sc scope) string = e.flavor match {
    case ANTLRFlavor() => {
        val field = s"localctx.(*${sc.CtxType}).${e.names.LabelField(l.Name)}"
        val value = s"child.(${e.names.ContextInterface(e.ruleName(rule))})"
        if (l.Append) s"$field = append($field, $value)" else s"$field = $value"
    }
    case NativeFlavor(_) => s"p.tree.Nodes[child].Label = ${sc.Labels.IndexOf(l.Name) + 1}"
}

// tokenStep matches one token with p.match or p.matchIf (fn) and stores it
// under its label, if any: in the antlr flavor's context field, or in the
// native tree's token labels.
func tokenStep(e env, ind string, fn string, arg string, label Option[atn.LabelRef], sc scope) Array[string] = e.flavor match {
    case ANTLRFlavor() => label match {
        case None() => ArrayOf(s"${ind}p.$fn(localctx, $arg)")
        case Some(l) => {
            val field = s"localctx.(*${sc.CtxType}).${escape(l.Name)}"
            val store = if (l.Append) s"$field = append($field, tok)" else s"$field = tok"
            ArrayOf(s"$ind{", s"$ind\ttok := p.$fn(localctx, $arg)", s"$ind\t$store", s"$ind}")
        }
    }
    case NativeFlavor(_) => label match {
        case None() => ArrayOf(s"${ind}p.$fn($arg)")
        case Some(l) => ArrayOf(s"${ind}p.labelToken(${sc.Labels.IndexOf(l.Name) + 1}, p.$fn($arg))")
    }
}

// setTest is a Go boolean expression testing whether v is in set.
func setTest(e env, set atn.IntervalSet, v string) string = set.Ranges.Map((r) =>
    if (r.Lo == r.Hi) s"$v == ${e.tokenRef(r.Lo)}" else s"($v >= ${r.Lo} && $v <= ${r.Hi})"
).MkString(" || ")

// emitDecision emits the function that picks an alternative of one decision.
func emitDecision(e env, plan analysis.DecisionPlan) string {
    val d = plan.Decision.Id
    val text = strings.ReplaceAll(plan.Decision.Text, "\n", " ")
    val body = emitLookahead(e, d, plan.Lookahead, "\t")
    s"// decide$d decides ${e.ruleName(plan.Decision.Rule)}: $text\nfunc (p *${e.parserType}) decide$d() int {\n" + body.MkString("\n") + "\n}\n"
}

// emitLookahead emits the code of a lookahead tree. Cases are made disjoint
// (a token goes to the first case that has it), as Go requires.
func emitLookahead(e env, d int, la analysis.Lookahead, ind string) Array[string] = la match {
    case analysis.Predict(alt) => ArrayOf(s"${ind}return $alt")
    case analysis.Adaptive(_) | analysis.Otherwise() => ArrayOf(s"${ind}return p.adaptivePredict($d)")
    case analysis.Automaton(states) => emitAutomaton(e, d, states)
    case analysis.Switch(depth, cases) => {
        val subject = if (depth == 1) "p.types[p.pos]" else s"p.la($depth)"
        val disjoint = cases.FoldLeft(Tuple(EmptyArray[analysis.LookaheadCase](), atn.EmptySet()), (acc, c) => {
            val own = c.Tokens.Subtract(acc.V2)
            Tuple(if (own.IsEmpty()) acc.V1 else acc.V1.Append(analysis.LookaheadCase(own, c.Then)), acc.V2.Union(own))
        }).V1
        // An Otherwise case (no tokens of its own) becomes the default.
        val otherwise = cases.Exists((c) => c.Then match {
            case analysis.Otherwise() => true
            case _ => false
        })
        val body = ArrayOf(s"${ind}switch $subject {")
            .AppendAll(disjoint.FlatMap((c) => ArrayOf(s"${ind}case ${e.tokenList(c.Tokens)}:").AppendAll(emitLookahead(e, d, c.Then, ind + "\t"))))
        if (otherwise) body.AppendAll(ArrayOf(s"${ind}default:", s"$ind\treturn p.adaptivePredict($d)", s"$ind}"))
        else body.AppendAll(ArrayOf(s"$ind}", s"${ind}p.noViableAlt($d)", s"${ind}return 0"))
    }
}

// fill replaces each placeholder in template with its value; pairs alternate
// placeholder and value. Placeholders are upper-case words that cannot occur
// in the Go code around them.
func fill(template string, pairs ...string) string = strings.NewReplacer(pairs...).Replace(template)

// emitAutomaton emits a lookahead DFA as a state machine: a label for each
// state some edge leads to (Go rejects unused labels), an offset counting the
// tokens read so far, and a switch in each reading state. A final state's alt
// is returned directly by the edge into it.
func emitAutomaton(e env, d int, states Array[analysis.DFAState]) Array[string] {
    val targets = states.FlatMap((s) => s.Edges.Map(_.Target)).Distinct()
    val reading = states.ZipWithIndex().Filter((si) => si.V1.Final.IsEmpty())
    val jump = (target int) => states.Get(target).Final match {
        case Some(alt) => s"return $alt"
        case None() => s"goto s$target"
    }
    val readsAgain = reading.Exists((si) => targets.Contains(si.V2))
    val start = if (readsAgain) ArrayOf("\ti := 0") else EmptyArray[string]()
    start.AppendAll(reading.FlatMap((si) => {
        val label = if (targets.Contains(si.V2)) ArrayOf(s"s${si.V2}:") else EmptyArray[string]()
        val subject = if (readsAgain) ArrayOf("\ti++", "\tswitch p.la(i) {") else ArrayOf("\tswitch p.types[p.pos] {")
        label.AppendAll(subject)
            .AppendAll(si.V1.Edges.FlatMap((edge) => ArrayOf(s"\tcase ${e.tokenList(edge.Tokens)}:", s"\t\t${jump(edge.Target)}")))
            .AppendAll(ArrayOf("\t}", s"\tp.noViableAlt($d)", "\treturn 0"))
    }))
}

// bracketMatchLine pairs the brackets of the input once its token types are
// known (see PFXBracketMatch).
func bracketMatchLine(e env) string =
    if (e.adaptive) s"\n\tp.pairs = ${e.pfx}BracketMatch(p.types, p.pairs)" else ""

// groupsOn lets a parse read bracketed groups when its first pass can only
// succeed on the whole input: when it may be repaired, its entry rule ends
// with EOF and the grammar runs no actions while parsing. A pass that stops
// before EOF, or actions run once more, would not be what ANTLR does.
func groupsOn(e env) string = if (e.adaptive) s"\n\tp.group = repair && ${e.pfx}OpenerCount > 0" else ""
