package golang

import (
    "strings"

    . "martianoff/gala/collection_immutable"
    "martianoff/gala/go_builtins"
    . "martianoff/gala/test"

    "github.com/martianoff/galop/analysis"
    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/codegen"
    "github.com/martianoff/galop/g4"
    "github.com/martianoff/galop/grammartest"
    "github.com/martianoff/galop/repair"
)

val exprGrammar = `grammar Expr;
prog : stat+ EOF ;
stat : expr ';' # exprStat
     | ID '=' expr ';' # assign
     ;
expr : term (op=('+' | '-') term)* ;
term : ID | INT | '(' expr ')' ;
ID : [a-z]+ ;
INT : [0-9]+ ;
WS : [ \t\r\n]+ -> skip ;
`

// generate runs the Go target on a test grammar that must be valid.
func generate(src string, defines Array[g4.OptionEntry]) Either[Array[string], Array[codegen.OutputFile]] {
    val (g, c) = grammartest.Compile(src)
    Target("test").Generate(
        codegen.Input(g, c, c.Parser.Map((p) => analysis.Analyze(p, repair.PlanFor(g, c), false))),
        codegen.Options(Package = "expr", Defines = defines),
    )
}

// antlrDefines selects the antlr flavor; tests without it get the default, native.
val antlrDefines = ArrayOf(g4.OptionEntry("flavor", "antlr"))

// parserOf is the content of the generated parser file.
func parserOf(result Either[Array[string], Array[codegen.OutputFile]]) string = result match {
    case Right(files) => files.Find((f) => strings.HasSuffix(f.Name, "_parser.go")).Map(_.Content).GetOrElse("")
    case Left(errs) => go_builtins.Panic(s"generate: ${errs.MkString("; ")}")
}

func parserFile(t T) string = parserOf(generate(exprGrammar, antlrDefines))

func TestANTLRFlavorFileNamesAndPackage(t T) T = generate(exprGrammar, antlrDefines) match {
    case Right(files) => {
        val t1 = Eq(t, files.Map(_.Name), ArrayOf("expr_galop_parser.go", "expr_galop_lexer.go"))
        IsTrue(t1, strings.Contains(files.Head().Content, "\npackage expr\n"))
    }
    case Left(errs) => t.Error(errs.MkString("; "))
}

func TestANTLRFlavorUsesANTLRNames(t T) T {
    val code = parserFile(t)
    val expected = ArrayOf(
        // ANTLR's context constructors, labeled alternatives and token constants.
        "NewProgContext(nil, parent, invokingState)",
        "localctx = NewExprStatContext(nil, localctx)",
        "localctx = NewAssignContext(nil, localctx)",
        "p.match(localctx, ExprParserID)",
        // Token-number assertions against ANTLR's constants.
        "_ uint = ExprParserID - ",
        // The set label is stored in ANTLR's field.
        "localctx.(*ExprContext).op = tok",
        // Public entry points return ANTLR's interfaces.
        "func (p *ExprGalopParser) Prog() (IProgContext, error)",
    )
    expected.FoldLeft(t, (acc, s) => IsTrue(acc, strings.Contains(code, s)))
}

func TestStaticGrammarDecidesStatically(t T) T {
    // Every decision of this grammar is LL(1), so no decision calls the runtime
    // predictor: the two calls are error reporting's and guessOr's, outside
    // the first pass.
    val code = parserFile(t)
    val t1 = Eq(t, strings.Count(code, "p.adaptivePredict("), 2)
    IsTrue(t1, strings.Contains(code, "func (p *ExprGalopParser) decide0() int"))
}

func TestAutomatonSettlesLoopWithoutPredictor(t T) T {
    // Telling a from b needs any number of X, but the SLL automaton loops over
    // them and decides on the token after: no runtime predictor is needed (the
    // two calls are error reporting's and guessOr's).
    val code = parserOf(generate(`grammar A;
s : a | b ;
a : X* Y ;
b : X* Z ;
X : 'x' ; Y : 'y' ; Z : 'z' ;
`, antlrDefines))
    val t1 = Eq(t, strings.Count(code, "p.adaptivePredict("), 2)
    IsTrue(t1, strings.Contains(code, "goto s0"))
}

func TestAdaptiveGrammarEmitsPredictor(t T) T {
    // Nesting deepens the contexts without bound, so the automaton stops at its
    // bound and the runtime predictor takes over from there.
    val code = parserOf(generate(`grammar A;
s : a | b ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`, antlrDefines))
    val t1 = IsTrue(t, strings.Contains(code, "p.adaptivePredict("))
    val t2 = IsTrue(t1, strings.Contains(code, "var AGalopTransStart = []int32{"))
    IsTrue(t2, strings.Contains(code, "p.stack = append(p.stack, "))
}

func TestUnknownFlavor(t T) T =
    generate(exprGrammar, ArrayOf(g4.OptionEntry("flavor", "nope"))) match {
        case Left(errs) => Eq(t, errs, ArrayOf("Go target: unknown flavor 'nope' (supported: native, antlr)"))
        case Right(_) => t.Error("expected an error")
    }

func TestNames(t T) T {
    val n = Names("gala")
    val t1 = Eq(t, n.RuleMethod("type"), "Type_")
    val t2 = Eq(t1, n.RuleMethod("sourceFile"), "SourceFile")
    val t3 = Eq(t2, n.Context("caseClause"), "CaseClauseContext")
    val t4 = Eq(t3, n.TokenConst("T__4"), "galaParserT__4")
    val t5 = Eq(t4, n.RuleConst("type"), "galaParserRULE_type")
    // ANTLR allows Unicode rule names; the first character is upper-cased as a whole.
    val t6 = Eq(t5, n.Context("éclair"), "ÉclairContext")
    Eq(t6, n.RuleMethod("ärger"), "Ärger")
}

func TestSingleLabeledAlternative(t T) T {
    // A label on a rule's only alternative still makes the label's context.
    val code = parserOf(generate(`grammar S;
r : a=ID # Only ;
ID : [a-z]+ ;
`, antlrDefines))
    val t1 = IsTrue(t, strings.Contains(code, "localctx = NewOnlyContext(nil, localctx)"))
    IsTrue(t1, strings.Contains(code, "localctx.(*OnlyContext).a = tok"))
}

func TestParserAndLexerGrammarNames(t T) T {
    // ANTLR appends `Parser` to the recognizer name of a combined grammar
    // only; galop's own types drop the grammar's `Parser`/`Lexer` suffix.
    val parser = generate("parser grammar ExprParser;\nr : ID ;\n", antlrDefines)
    val lexer = generate("lexer grammar ExprLexer;\nID : [a-z]+ ;\n", antlrDefines)
    (parser, lexer) match {
        case (Right(pfiles), Right(lfiles)) => {
            val code = pfiles.Head().Content
            val t1 = Eq(t, pfiles.Map(_.Name), ArrayOf("expr_galop_parser.go"))
            val t2 = IsTrue(t1, strings.Contains(code, "p.match(localctx, ExprParserID)"))
            val t3 = IsFalse(t2, strings.Contains(code, "ExprParserParser"))
            val t4 = IsTrue(t3, strings.Contains(code, "type ExprGalopParser struct"))
            val t5 = Eq(t4, lfiles.Map(_.Name), ArrayOf("expr_galop_lexer.go"))
            IsTrue(t5, strings.Contains(lfiles.Head().Content, "type ExprGalopLexer struct"))
        }
        case _ => t.Error(s"generate: $parser $lexer")
    }
}

func TestFileNamesMatchGenerate(t T) T = g4.Parse(exprGrammar) match {
    case Right(g) => atn.Compile(g) match {
        case Right(c) => {
            val check = (acc T, defines Array[g4.OptionEntry]) => Eq(acc,
                Right[Array[string], Array[string]](Target("test").FileNames(g, c, codegen.Options(Defines = defines))),
                generate(exprGrammar, defines).Map((files) => files.Map(_.Name)),
            )
            check(check(t, EmptyArray[g4.OptionEntry]()), antlrDefines)
        }
        case Left(errs) => t.Error(errs.MkString("; "))
    }
    case Left(d) => t.Error(d.String())
}

// nativeFiles generates src in the default flavor, native, keyed by file name.
func nativeFiles(src string) HashMap[string, string] = generate(src, EmptyArray[g4.OptionEntry]()) match {
    case Right(files) => files.FoldLeft(EmptyHashMap[string, string](), (m, f) => m.Put(f.Name, f.Content))
    case Left(errs) => go_builtins.Panic(s"generate: ${errs.MkString("; ")}")
}

func TestNativeIsTheDefault(t T) T {
    val files = nativeFiles(exprGrammar)
    val t1 = Eq(t, files.Keys().Sorted(), ArrayOf("expr_lexer.go", "expr_parser.go"))
    val parser = files.Get("expr_parser.go").GetOrElse("")
    val lexer = files.Get("expr_lexer.go").GetOrElse("")
    val t2 = IsFalse(t1, strings.Contains(parser, "antlr4-go"))
    val t3 = IsFalse(t2, strings.Contains(lexer, "antlr4-go"))
    val t4 = IsTrue(t3, strings.Contains(parser, "\npackage expr\n"))
    IsTrue(t4, strings.Contains(lexer, "func ExprLex(src string) *ExprTokens"))
}

func TestNativeTokenTypesAndRules(t T) T {
    val files = nativeFiles(exprGrammar)
    val lexer = files.Get("expr_lexer.go").GetOrElse("")
    val parser = files.Get("expr_parser.go").GetOrElse("")
    val expected = ArrayOf(
        // Token types, numbered as ANTLR numbers them; literals are commented.
        // The const blocks are laid out as gofmt lays them out.
        Tuple(lexer, "\tExprEOF  = -1\n"),
        Tuple(lexer, "\tExprT__0 = 1 // ';'\n"),
        Tuple(lexer, "\tExprID   = 7\n"),
        Tuple(lexer, "\tExprHiddenChannel  = 1\n"),
        // Rule indexes and the parse entry points.
        Tuple(parser, "\tExprRULE_prog = 0\n"),
        Tuple(parser, "func ParseProg(ts *ExprTokens) (ProgNode, error)"),
        Tuple(parser, "p.match(ExprID)"),
    )
    expected.FoldLeft(t, (acc, e) => IsTrue(acc, strings.Contains(e.V1, e.V2)))
}

func TestNativeAccessors(t T) T {
    val parser = nativeFiles(exprGrammar).Get("expr_parser.go").GetOrElse("")
    val expected = ArrayOf(
        // One stat or more: ANTLR's list getters.
        "func (n ProgNode) AllStat() []StatNode",
        "func (n ProgNode) Stat(i int) StatNode",
        "func (n ProgNode) EOF() ExprTerminal",
        // Labeled alternatives get their own handles and getters.
        "func (n StatNode) AsAssign() (AssignNode, bool)",
        "func (n AssignNode) ID() ExprTerminal",
        "func (n AssignNode) Expr() ExprNode",
        // term* repeats: list getters; the set label op is a token label.
        "func (n ExprNode) AllTerm() []TermNode",
        "func (n ExprNode) GetOp() ExprTerminal",
        "p.labelToken(1, p.matchIf(",
    )
    val t1 = expected.FoldLeft(t, (acc, s) => IsTrue(acc, strings.Contains(parser, s)))
    // A literal-only token ('(') has no getter, as in ANTLR.
    IsFalse(t1, strings.Contains(parser, ") T__"))
}

func TestNativeRuleLabels(t T) T {
    val parser = nativeFiles(`grammar L;
r : 'if' cond=e ('else' alts+=e)* ;
e : X ;
X : 'x' ;
WS : ' ' -> skip ;
`).Get("l_parser.go").GetOrElse("")
    val t1 = IsTrue(t, strings.Contains(parser, "func (n RNode) GetCond() ENode"))
    val t2 = IsTrue(t1, strings.Contains(parser, "func (n RNode) GetAlts() []ENode"))
    IsTrue(t2, strings.Contains(parser, "p.tree.Nodes[child].Label = 2"))
}

func TestNativeParserGrammarCarriesTokens(t T) T {
    // Without lexer rules there is no lexer file, so the parser declares the
    // token runtime itself.
    val files = nativeFiles("parser grammar ExprParser;\nr : ID ;\n")
    val t1 = Eq(t, files.Keys().Sorted(), ArrayOf("expr_parser.go"))
    IsTrue(t1, strings.Contains(files.Get("expr_parser.go").GetOrElse(""), "type ExprTokens struct"))
}

func TestNativeAccessorNamesAvoidHandleMethods(t T) T {
    // A rule named `token` would hide the handles' own Token method.
    val parser = nativeFiles("grammar N;\nr : token ;\ntoken : X ;\nX : 'x' ;\n").Get("n_parser.go").GetOrElse("")
    IsTrue(t, strings.Contains(parser, "func (n RNode) Token_() TokenNode"))
}

func TestNativeTokenLabelHelpersAreFilled(t T) T {
    // The label helpers go in through a placeholder; theirs must be filled too.
    val parser = nativeFiles(exprGrammar).Get("expr_parser.go").GetOrElse("")
    val t1 = IsTrue(t, strings.Contains(parser, "func (p *ExprGalopParser) labelToken(label int32, tok int32)"))
    val t2 = IsFalse(t1, strings.Contains(parser, "@X@"))
    IsFalse(t2, strings.Contains(parser, "*PARSER)"))
}

func TestNativeWildcardHasNoGetters(t T) T {
    // As in ANTLR, `.` and `~X` add no token getters; a listed set does.
    val parser = nativeFiles(`grammar W;
r : ID .*? ';' EOF ;
s : ~ID (INT | ID) ;
ID : [a-z]+ ;
INT : [0-9]+ ;
SEMI : ';' ;
WS : [ ]+ -> skip ;
`).Get("w_parser.go").GetOrElse("")
    val t1 = IsTrue(t, strings.Contains(parser, "func (n RNode) ID() WTerminal"))
    val t2 = IsFalse(t1, strings.Contains(parser, "func (n RNode) AllID()"))
    val t3 = IsFalse(t2, strings.Contains(parser, "func (n RNode) INT()"))
    val t4 = IsTrue(t3, strings.Contains(parser, "func (n SNode) INT() WTerminal"))
    IsFalse(t4, strings.Contains(parser, "func (n SNode) WS()"))
}

func TestNativeTokenNamedLikeTheRuntime(t T) T {
    // A token called Tokens would clash with the runtime's MTokens type.
    val files = nativeFiles("grammar M;\nr : Tokens ;\nTokens : 't' ;\n")
    val t1 = IsTrue(t, strings.Contains(files.Get("m_lexer.go").GetOrElse(""), "\tMTokens_ = 1 // 't'\n"))
    IsTrue(t1, strings.Contains(files.Get("m_parser.go").GetOrElse(""), "p.match(MTokens_)"))
}

func TestBracketsAreAbstracted(t T) T {
    // Telling a from b needs the whole nest of parentheses: the runtime
    // predicts it over the brackets read as one symbol.
    val code = parserOf(generate(`grammar A;
s : (a | b) EOF ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`, antlrDefines))
    val expected = ArrayOf(
        "const AGalopOpenerCount = 1",
        "p.pairs = AGalopBracketMatch(p.types, p.pairs)",
    )
    val t1 = expected.FoldLeft(t, (acc, s) => IsTrue(acc, strings.Contains(code, s)))
    // No automaton is emitted for the decision: it would stop at a bound.
    IsFalse(t1, strings.Contains(code, "goto s"))
}

func TestNativeFlavorMatchesBrackets(t T) T {
    val code = parserOf(generate(`grammar A;
s : (a | b) EOF ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`, EmptyArray[g4.OptionEntry]()))
    IsTrue(t, strings.Contains(code, "p.pairs = AGalopBracketMatch(p.types, p.pairs)"))
}

func TestTokenTypesAboveTheVocabularyAreRejected(t T) T {
    // A token stream from another lexer can carry types past this grammar's;
    // prediction and bracket pairing must not index their tables with them.
    val code = parserOf(generate(`grammar A;
s : (a | b) EOF ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`, antlrDefines))
    val t1 = IsTrue(t, strings.Contains(code, "if t < -1 || int(t) > AGalopMaxTokenType {\n\t\t\tp.noViableAlt(d)"))
    IsTrue(t1, strings.Contains(code, "if t < -1 || int(t) > AGalopMaxTokenType {\n\t\t\tcontinue"))
}

func TestNoBracketsWithActions(t T) T {
    // An action rules out repair, so a failed first pass over groups would
    // add a parse that runs the action again: no brackets are read.
    val code = parserOf(generate(`grammar A;
s : a EOF | b EOF ;
a : '(' a ')' | X {count++} ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`, antlrDefines))
    val t1 = IsTrue(t, strings.Contains(code, "p.adaptivePredict("))
    IsTrue(t1, strings.Contains(code, "const AGalopOpenerCount = 0"))
}

func TestNoBracketsWithoutARepairableEntry(t T) T {
    // The brackets would be inferred, but no entry rule ends with EOF, so no
    // parse may repair a wrong guess over groups: no families, no pairing.
    val code = parserOf(generate(`grammar A;
s : a | b ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`, antlrDefines))
    val t1 = IsTrue(t, strings.Contains(code, "p.adaptivePredict("))
    val t2 = IsTrue(t1, strings.Contains(code, "const AGalopOpenerCount = 0"))
    val t3 = IsFalse(t2, strings.Contains(code, "BracketMatch(p.types"))
    IsFalse(t3, strings.Contains(code, "p.group = repair"))
}

func TestNoBracketsNoAbstraction(t T) T {
    // Adaptive, but no token pair behaves like brackets.
    val code = parserOf(generate(`grammar A;
s : a | b ;
a : X a | X ;
b : X b | Y ;
X : 'x' ; Y : 'y' ;
`, antlrDefines))
    val t1 = IsTrue(t, strings.Contains(code, "p.adaptivePredict("))
    IsTrue(t1, strings.Contains(code, "const AGalopOpenerCount = 0"))
}
