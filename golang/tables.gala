package golang

import (
    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/codegen"
)

// Transition kinds in the emitted tables. Actions and predicates are epsilon
// for prediction (galop rejects grammars whose prediction needs predicates).
val kindEpsilon = 0
val kindRule = 1
val kindAtom = 2
val kindSet = 3

// flatTransition is one transition in table form.
struct flatTransition(Kind int, Target int, Arg int)

// flatten turns a transition into table form; sets are numbered by the order
// of first appearance in sets.
func flatten(t atn.Transition, sets Array[atn.IntervalSet]) flatTransition = t match {
    case atn.Epsilon(target) => flatTransition(kindEpsilon, target, 0)
    case atn.RuleCall(target, _, follow) => flatTransition(kindRule, target, follow)
    case atn.Atom(target, label) => flatTransition(kindAtom, target, label)
    case atn.SetMatch(target, set) => flatTransition(kindSet, target, sets.IndexOf(set))
    case atn.LexerActions(target, _) => flatTransition(kindEpsilon, target, 0)
    case atn.Predicate(target, _, _) => flatTransition(kindEpsilon, target, 0)
    case atn.Action(target, _, _) => flatTransition(kindEpsilon, target, 0)
}

// tables emits the parser ATN as Go literals for the runtime predictor.
func tables(e env) string {
    val states = e.parser.States
    val sets = states.FlatMap((s) => s.Out.Collect({ case atn.SetMatch(_, set) => set })).Distinct()
    val flat = states.Map((s) => s.Out.Map((t) => flatten(t, sets)))
    val starts = codegen.Offsets(flat.Map(_.Size()))
    val all = flat.FlatMap((out) => out)
    val isStop = states.Map(_.IsRuleStop())
    val epsOnly = states.Map(_.EpsilonOnly())
    // Every rule's call sites' follow states: where SLL prediction continues after a
    // rule when the caller is unknown (ANTLR's rule-stop follow links).
    val follows = ArrayTabulate(e.parser.RuleNames.Size(), (r) => e.parser.Callers(r).Map(_.Follow))
    val followStarts = codegen.Offsets(follows.Map(_.Size()))
    val closures = states.Map((s) => staticClosure(e.parser, s.Id))
    val closStarts = codegen.Offsets(closures.Map(_.Size()))
    val closAll = closures.FlatMap((c) => c)
    val x = e.pfx
    ArrayOf(
        "// The parser ATN, for adaptive prediction.",
        "const (",
        s"\t${x}KindEpsilon = $kindEpsilon",
        s"\t${x}KindRule    = $kindRule",
        s"\t${x}KindAtom    = $kindAtom",
        s"\t${x}KindSet     = $kindSet",
        ")",
        "",
        s"// ${x}MaxTokenType is the largest token type; DFA edges are indexed by type + 1.",
        s"const ${x}MaxTokenType = ${e.vocab.MaxType()}",
        "",
        goSlice(s"${x}StateRule", "int32", states.Map((s) => s"${s.Rule}")),
        goSlice(s"${x}StateIsStop", "bool", isStop.Map((b) => s"$b")),
        goSlice(s"${x}StateEpsOnly", "bool", epsOnly.Map((b) => s"$b")),
        goSlice(s"${x}TransStart", "int32", starts.Map((n) => s"$n")),
        goSlice(s"${x}TransKind", "uint8", all.Map((t) => s"${t.Kind}")),
        goSlice(s"${x}TransTarget", "int32", all.Map((t) => s"${t.Target}")),
        goSlice(s"${x}TransArg", "int32", all.Map((t) => s"${t.Arg}")),
        goSlice(s"${x}DecisionState", "int32", e.parser.Decisions.Map((d) => s"${d.State}")),
        goSlice(s"${x}FollowStart", "int32", followStarts.Map((n) => s"$n")),
        goSlice(s"${x}FollowState", "int32", follows.FlatMap((fs) => fs).Map((n) => s"$n")),
        goSlice(s"${x}ClosStart", "int32", closStarts.Map((n) => s"$n")),
        goSlice(s"${x}ClosKind", "uint8", closAll.Map((c) => s"${c.Kind}")),
        goSlice(s"${x}ClosState", "int32", closAll.Map((c) => s"${c.State}")),
        goSlice(s"${x}ClosArg", "int32", closAll.Map((c) => s"${c.Arg}")),
    ).AppendAll(bracketTables(e, all.Size(), starts)).AppendAll(sets match {
        // gofmt writes an empty composite literal on one line.
        case Array() => ArrayOf(s"var ${x}Sets = [][]int32{}")
        case _ => ArrayOf(s"var ${x}Sets = [][]int32{")
            .AppendAll(sets.Map((set) => "\t{" + set.Ranges.Map((r) => s"${r.Lo}, ${r.Hi}").MkString(", ") + "},"))
            .Append("}")
    }).MkString("\n") + "\n"
}

// goSlice renders `var name = []typ{...}` with a bounded number of values per line.
func goSlice(name string, typ string, values Array[string]) string {
    val rows = values.Grouped(24).Map((row) => "\t" + row.MkString(", ") + ",")
    s"var $name = []$typ{\n" + rows.MkString("\n") + "\n}\n"
}

// Kinds of the items in a state's static closure.
val closAdd = 0
val closCall = 1
val closStop = 2

// closureItem is one thing a configuration reaches from a state without
// consuming a token and without leaving the state's rule: a state that consumes
// (closAdd), a rule call (closCall, State = the rule's start, Arg = the follow
// state), or the rule's end (closStop).
struct closureItem(Kind int, State int, Arg int)

// staticClosure is the part of ANTLR's closure that does not depend on the
// prediction context: everything reachable from state s through epsilon,
// action and predicate transitions inside one rule. The runtime only handles
// rule calls and returns itself.
func staticClosure(a atn.ATN, s int) Array[closureItem] =
    visitClosure(a, s, Tuple(EmptyArray[closureItem](), EmptyHashSet[int]())).V1

func visitClosure(a atn.ATN, s int, acc Tuple[Array[closureItem], HashSet[int]]) Tuple[Array[closureItem], HashSet[int]] {
    if acc.V2.Contains(s) {
        return acc
    }
    val seen = Tuple(acc.V1, acc.V2.Add(s))
    val st = a.State(s)
    st.Kind match {
        case atn.RuleStopState() => Tuple(seen.V1.Append(closureItem(closStop, s, 0)), seen.V2)
        case _ => {
            val start = if (st.EpsilonOnly()) seen else Tuple(seen.V1.Append(closureItem(closAdd, s, 0)), seen.V2)
            st.Out.FoldLeft(start, (next, t) => t match {
                case atn.RuleCall(target, _, follow) => Tuple(next.V1.Append(closureItem(closCall, target, follow)), next.V2)
                case _ if t.IsEpsilon() => visitClosure(a, t.Target(), next)
                case _ => next
            })
        }
    }
}

// bracketTables emits the bracket families for prediction over bracketed
// groups: per token (type + 1) its opener index or -1 and whether it closes,
// per opener its closer, and per transition (in TransStart order) the states
// after the closer of the bracket it opens (empty without brackets, when no
// group is ever read).
// transitions: the number of transitions in the flat transition table.
// starts: each state's first transition in that table.
func bracketTables(e env, transitions int, starts Array[int]) Array[string] {
    val x = e.pfx
    val families = e.brackets.Families
    val openers = families.FlatMap((f) => f.Openers.Values().Map((o) => (o, f.Closer)))
    val index = HashMapFromSlice(openers.ZipWithIndex().Map((p) => (p.V1.V1, p.V2)).ToGoSlice())
    val closers = families.Map(_.Closer)
    val sites = HashMapFromSlice(e.brackets.Sites.Map((s) => (starts.Get(s.State) + s.Index, s.After)).ToGoSlice())
    val after = if (families.IsEmpty()) EmptyArray[Array[int]]()
        else ArrayTabulate(transitions, (i) => sites.Get(i).GetOrElse(EmptyArray[int]()))
    ArrayOf(
        s"// ${x}OpenerCount is the number of opening brackets.",
        s"const ${x}OpenerCount = ${openers.Size()}",
        "",
        goSlice(s"${x}OpenerSym", "int32", ArrayTabulate(e.vocab.MaxType() + 2, (i) => s"${index.Get(i - 1).GetOrElse(-1)}")),
        goSlice(s"${x}IsCloser", "bool", ArrayTabulate(e.vocab.MaxType() + 2, (i) => s"${closers.Contains(i - 1)}")),
        goSlice(s"${x}OpenerCloser", "int32", openers.Map((o) => s"${o.V2}")),
        goSlice(s"${x}AfterStart", "int32", codegen.Offsets(after.Map(_.Size())).Map((n) => s"$n")),
        goSlice(s"${x}AfterState", "int32", after.FlatMap((a) => a).Map((n) => s"$n")),
    )
}
