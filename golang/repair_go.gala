package golang

// repairSource settles SLL conflicts and, when the SLL pass fails, finds the
// parse ANTLR's LL stage gives: by the witness-based repair, or by rerunning
// the whole parse in LL mode. Every place where the SLL pass would take the
// lowest conflicting alternative calls onConflict, so the repair sees every
// conflict. PFX is the per-grammar prefix, PARSER the parser type, @ROOT@
// what attempt returns besides the error, @ZERO@ its value on failure,
// @RULE@ the rule function type and @SYNTAXERROR@ the syntax error type.
//
// The repair is exact only when no semantic predicate takes part in
// prediction and no rule is left-recursive; the Go target rejects both.
val repairSource = `
// onConflict settles an SLL conflict whose lowest conflicting alternative is
// sllAlt. The SLL pass takes sllAlt; this stays small enough to inline.
func (p *PARSER) onConflict(d int, sllAlt int) int {
	if p.ll || p.rp.on {
		return p.onConflictSlow(d, sllAlt)
	}
	return sllAlt
}

// onConflictSlow is onConflict outside the SLL pass: LL mode runs
// full-context prediction, and a repair pass replays a recorded conflict or
// records a new one.
func (p *PARSER) onConflictSlow(d int, sllAlt int) int {
	if p.ll {
		return p.predictLL(d)
	}
	r := &p.rp
	i := r.seq
	r.seq++
	if i < len(r.recs) {
		c := &r.recs[i]
		if int(c.d) != d || int(c.pos) != p.pos {
			panic("galop: a repair pass left the parse it replays")
		}
		return int(c.alt)
	}
	from := len(r.stacks)
	r.stacks = append(r.stacks, p.stack...)
	r.recs = append(r.recs, PFXConflict{d: int32(d), pos: int32(p.pos), alt: int32(sllAlt), stackFrom: int32(from), stackTo: int32(len(r.stacks))})
	return sllAlt
}

// PFXConflict is an SLL conflict a repair pass met: the decision, the token
// it was predicted at, the alternative the parse takes there, the parser's
// call stack at that point (r.stacks[stackFrom:stackTo]), and its LL answer
// once known (0: not checked, -1: no alternative is viable, err says why).
type PFXConflict struct {
	d, pos, alt, known int32
	stackFrom, stackTo int32
	err                error
}

// PFXRepair is the state of a repair (see llParse).
type PFXRepair struct {
	on     bool
	seq    int
	recs   []PFXConflict
	stacks []int32
}

// PFXRepairPasses bounds the passes of one repair; past it the parse falls
// back to running LL prediction over the whole input.
const PFXRepairPasses = 256

// llParse returns the parse ANTLR's LL prediction gives, after the SLL pass
// failed. With repair it repairs the failed parse instead of running
// full-context prediction at every conflict; repair needs an entry rule that
// ends with EOF.
//
// At an SLL conflict, ANTLR's LL prediction is the lowest alternative that
// can still complete the parse: configurations with the same state and stack
// have the same future, and SLL configurations over-approximate LL ones. So a
// parse that reaches EOF proves its choice at every conflict where it took the
// lowest alternative, and only where it takes another one does it need LL
// prediction, which then decides. Each pass replays the parse with the
// choices so far; after a syntax error, switchLatest changes one. When it
// finds nothing to change, LL fails too: at the earliest conflict where no
// alternative is viable, or where this pass failed.
func (p *PARSER) llParse(rule @RULE@, repair bool) (@ROOT@, error) {
	if repair {
		r := &p.rp
		r.on = true
		defer func() { r.on = false }()
		r.recs, r.stacks = r.recs[:0], r.stacks[:0]
		for range PFXRepairPasses {
			r.seq = 0
			root, err := p.attempt(rule)
			if err == nil {
				return root, nil
			}
			switched, dead := p.switchLatest()
			switch {
			case switched:
			case dead != nil:
				return @ZERO@, dead.err
			default:
				return root, err
			}
		}
		r.on = false
	}
	p.ll = true
	defer func() { p.ll = false }()
	return p.attempt(rule)
}

// switchLatest checks the conflicts of the pass that just failed, from the
// failure backwards, and switches the latest one whose LL answer differs from
// the alternative taken. Otherwise it returns the earliest conflict where no
// alternative is viable, if any.
func (p *PARSER) switchLatest() (switched bool, dead *PFXConflict) {
	r := &p.rp
	for i := r.seq - 1; i >= 0; i-- {
		c := &r.recs[i]
		if c.known == 0 {
			p.checkConflict(c)
		}
		switch {
		case c.known < 0:
			dead = c
		case c.known != c.alt:
			c.alt = c.known
			r.recs, r.stacks = r.recs[:i+1], r.stacks[:c.stackTo]
			return true, nil
		}
	}
	return false, dead
}

// checkConflict computes c's LL answer with the parser at c's token and stack.
func (p *PARSER) checkConflict(c *PFXConflict) {
	pos, stack := p.pos, p.stack
	defer func() {
		p.pos, p.stack = pos, stack
		if e := recover(); e != nil {
			se, ok := e.(*@SYNTAXERROR@)
			if !ok {
				panic(e)
			}
			c.known, c.err = -1, se
		}
	}()
	p.pos, p.stack = int(c.pos), p.rp.stacks[c.stackFrom:c.stackTo:c.stackTo]
	c.known = int32(p.predictLL(int(c.d)))
}
`

// fullCacheSource is full-context prediction, cached across parses.
val fullCacheSource = `
// startLL fills cur with the closure of decision d's alternatives, with the
// call stack stack as the outer context (ANTLR's start state of full-context
// prediction).
func (pr *PFXPredictor) startLL(d int, stack []int32, cur *PFXConfigSet) {
	cp := &pr.pool
	outer := int32(0)
	for _, ret := range stack {
		outer = cp.singleton(outer, ret)
	}
	cur.reset()
	pr.busy.reset()
	s := PFXDecisionState[d]
	for i := PFXTransStart[s]; i < PFXTransStart[s+1]; i++ {
		pr.closure(PFXConfig{PFXTransTarget[i], i - PFXTransStart[s] + 1, outer}, cur, false)
	}
}

// stepLL moves full-context prediction from cur past token t into next and
// applies ANTLR's stopping rule: the alternative it picks, -1 when no
// alternative is viable, or 0 to read another token.
func (pr *PFXPredictor) stepLL(cur *PFXConfigSet, t int32, intermediate, next *PFXConfigSet) int32 {
	if alt := pr.reach(cur, t, intermediate, next); alt != 0 {
		return alt
	}
	if len(next.list) == 0 {
		return -1
	}
	if alt := PFXUniqueAlt(next.list); alt != 0 {
		return alt
	}
	alt, _ := pr.subsets(next)
	return alt
}

// predictLLUncached runs ANTLR's full-context prediction of decision d from
// the current token, with the parser's call stack as the outer context.
func (p *PARSER) predictLLUncached(d int) int {
	pr := &p.pred
	pr.full = true
	pr.pool.reset(false)
	cur, intermediate, next := &pr.sets[0], &pr.sets[1], &pr.sets[2]
	pr.startLL(d, p.stack, cur)
	for offset := 0; ; {
		t := p.la(offset + 1)
		switch alt := pr.stepLL(cur, t, intermediate, next); {
		case alt < 0:
			p.noViableAlt(d)
		case alt > 0:
			return int(alt)
		}
		cur, next = next, cur
		if t != -1 {
			offset++
		}
	}
}

// PFXFull caches full-context prediction. For a decision and a call stack,
// ANTLR's full-context prediction depends only on the tokens ahead, so it is
// cached like the SLL DFA, as a DFA per (decision, stack): states are
// configuration sets whose contexts live in one pool that is never reset, so
// cached contexts keep their meaning. Finding a cached start state takes a
// read lock and walking cached edges no lock; new states are computed under
// the write lock. Past PFXFullMaxStates states or PFXFullMaxContexts contexts
// the cache stops growing and prediction runs uncached.
var PFXFull struct {
	mu     sync.RWMutex
	starts map[string]*PFXDFAState
	states map[string]*PFXDFAState
	pr     PFXPredictor
	key    []byte // scratch for state keys
}

// PFXFullMaxStates and PFXFullMaxContexts bound the full-context cache.
const (
	PFXFullMaxStates   = 1 << 15
	PFXFullMaxContexts = 1 << 20
)

func init() {
	PFXFull.starts = map[string]*PFXDFAState{}
	PFXFull.states = map[string]*PFXDFAState{}
	PFXFull.pr.pool.reset(false)
	PFXFull.pr.full = true
}

// PFXFullIsFull says whether the cache has stopped growing; call it under mu.
func PFXFullIsFull() bool {
	return len(PFXFull.states) >= PFXFullMaxStates || len(PFXFull.pr.pool.kind) >= PFXFullMaxContexts
}

// PFXFullStart returns the start state of decision d under the call stack
// whose key (the decision, then the stack) is key, or nil when it is not
// cached and the cache is full.
func PFXFullStart(d int, stack []int32, key []byte) *PFXDFAState {
	PFXFull.mu.RLock()
	st, ok := PFXFull.starts[string(key)]
	PFXFull.mu.RUnlock()
	if ok {
		return st
	}
	PFXFull.mu.Lock()
	defer PFXFull.mu.Unlock()
	if st, ok := PFXFull.starts[string(key)]; ok {
		return st
	}
	if PFXFullIsFull() {
		return nil
	}
	pr := &PFXFull.pr
	pr.startLL(d, stack, &pr.sets[0])
	st = PFXFullIntern(&pr.sets[0])
	PFXFull.starts[string(key)] = st
	return st
}

// PFXFullIntern returns the cached state for the configurations in set.
func PFXFullIntern(set *PFXConfigSet) *PFXDFAState {
	pr := &PFXFull.pr
	s := append(pr.sorted[:0], set.list...)
	pr.sorted = s
	slices.SortFunc(s, func(a, b PFXConfig) int {
		if a.state != b.state {
			return int(a.state - b.state)
		}
		return int(a.alt - b.alt)
	})
	key := PFXFull.key[:0]
	for _, c := range s {
		key = binary.LittleEndian.AppendUint32(key, uint32(c.state))
		key = binary.LittleEndian.AppendUint32(key, uint32(c.alt))
		key = binary.LittleEndian.AppendUint32(key, uint32(c.ctx))
	}
	PFXFull.key = key
	if st, ok := PFXFull.states[string(key)]; ok {
		return st
	}
	st := &PFXDFAState{configs: slices.Clone(s), edges: make([]atomic.Pointer[PFXDFAState], PFXMaxTokenType+2)}
	PFXFull.states[string(key)] = st
	return st
}

// PFXFullNext computes and caches the edge of from on token t; nil when the
// cache is full.
func PFXFullNext(from *PFXDFAState, t int32) *PFXDFAState {
	PFXFull.mu.Lock()
	defer PFXFull.mu.Unlock()
	if st := from.edges[t+1].Load(); st != nil {
		return st
	}
	if PFXFullIsFull() {
		return nil
	}
	pr := &PFXFull.pr
	cur, intermediate, next := &pr.sets[0], &pr.sets[1], &pr.sets[2]
	cur.reset()
	for _, c := range from.configs {
		cur.add(c, &pr.pool)
	}
	var st *PFXDFAState
	switch alt := pr.stepLL(cur, t, intermediate, next); {
	case alt < 0:
		st = PFXDFAError
	case alt > 0:
		st = &PFXDFAState{alt: alt}
	default:
		st = PFXFullIntern(next)
	}
	from.edges[t+1].Store(st)
	return st
}

// predictLL runs ANTLR's full-context prediction of decision d from the
// current token, with the parser's call stack as the outer context, through
// the cache when it can.
func (p *PARSER) predictLL(d int) int {
	key := binary.LittleEndian.AppendUint32(p.llKey[:0], uint32(d))
	for _, ret := range p.stack {
		key = binary.LittleEndian.AppendUint32(key, uint32(ret))
	}
	p.llKey = key
	st := PFXFullStart(d, p.stack, key)
	for i := 1; st != nil; i++ {
		t := p.la(i)
		if t < -1 || int(t)+1 >= len(st.edges) {
			break
		}
		next := st.edges[t+1].Load()
		if next == nil {
			if next = PFXFullNext(st, t); next == nil {
				break
			}
		}
		switch {
		case next == PFXDFAError:
			p.noViableAlt(d)
		case next.alt > 0:
			return int(next.alt)
		}
		st = next
	}
	return p.predictLLUncached(d)
}
`
