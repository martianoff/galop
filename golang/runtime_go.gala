package golang

// predictorSource is the Go code of the runtime predictor that generated
// parsers include when the analysis left decisions to runtime prediction.
// PFX is replaced with a per-grammar prefix and PARSER with the parser type.
//
// It reproduces the prediction of ANTLR's Go runtime 4.13.1
// (ParserATNSimulator execATN, execATNWithFullContext, computeReachSet,
// closure; PredictionMode; PredictionContext merge) over the static ATN
// tables, in both of ANTLR's modes:
//
//   - SLL: the calling context is a wildcard (a rule's end continues at every
//     caller) and an SLL conflict is settled by the lowest conflicting
//     alternative. SLL results are cached in a per-decision DFA for the life of
//     the process, as ANTLR caches them.
//   - LL: the parser's real call stack is the context, and prediction runs until
//     ANTLR's stopping rule picks an alternative.
//
// Prediction contexts are graph-structured stacks, hash-consed so that equal
// contexts have equal ids, and merged with ANTLR's rules, so configuration
// sets, conflict subsets and DFA states are the ones ANTLR computes.
val predictorSource = `
// PFXEmptyReturn is the return state that marks the end of the outermost context.
const PFXEmptyReturn = int32(0x7fffffff)

// PFXCtxPool holds hash-consed prediction contexts. Context 0 is EMPTY; every
// other context is a singleton (one return state and parent) or an array
// (return states in ascending order, with parents). A parent of -1 is nil.
type PFXCtxPool struct {
	wildcard bool
	kind     []uint8
	start    []int32
	length   []int32
	rets     []int32
	parents  []int32
	next     []int32
	heads    PFXMap
	singles  PFXMap
	merges   PFXMap
}

const (
	PFXCtxEmpty     = 0
	PFXCtxSingleton = 1
	PFXCtxArray     = 2
)

func (cp *PFXCtxPool) reset(wildcard bool) {
	cp.wildcard = wildcard
	cp.kind = append(cp.kind[:0], PFXCtxEmpty)
	cp.start = append(cp.start[:0], 0)
	cp.length = append(cp.length[:0], 1)
	cp.rets = append(cp.rets[:0], PFXEmptyReturn)
	cp.parents = append(cp.parents[:0], -1)
	cp.next = append(cp.next[:0], -1)
	cp.heads.reset()
	cp.singles.reset()
	cp.merges.reset()
}

// intern returns the id of the context (kind, rets, parents), adding it if new.
// Contexts are found through a hash of their contents and a chain of the ids
// that share it. Singletons are interned by singleton instead.
func (cp *PFXCtxPool) intern(kind uint8, rets, parents []int32) int32 {
	h := uint64(kind) + 0x9e3779b97f4a7c15
	for i := range rets {
		h = PFXMix(h ^ (uint64(uint32(rets[i]))<<32 | uint64(uint32(parents[i]))))
	}
	head, found := cp.heads.get(h)
	if found {
		for id := head; id >= 0; id = cp.next[id] {
			if cp.kind[id] != kind || int(cp.length[id]) != len(rets) {
				continue
			}
			s, same := cp.start[id], true
			for i := range rets {
				if cp.rets[s+int32(i)] != rets[i] || cp.parents[s+int32(i)] != parents[i] {
					same = false
					break
				}
			}
			if same {
				return id
			}
		}
	} else {
		head = -1
	}
	id := int32(len(cp.kind))
	cp.kind = append(cp.kind, kind)
	cp.start = append(cp.start, int32(len(cp.rets)))
	cp.length = append(cp.length, int32(len(rets)))
	cp.rets = append(cp.rets, rets...)
	cp.parents = append(cp.parents, parents...)
	cp.next = append(cp.next, head)
	cp.heads.set(h, id)
	return id
}

// singleton is ANTLR's SingletonBasePredictionContextCreate. Closure creates
// one at every rule call, so singletons skip the hash chains of intern: their
// return state and parent are the whole key.
func (cp *PFXCtxPool) singleton(parent, ret int32) int32 {
	if ret == PFXEmptyReturn && parent < 0 {
		return 0
	}
	k := uint64(uint32(ret))<<32 | uint64(uint32(parent))
	if id, ok := cp.singles.get(k); ok {
		return id
	}
	id := int32(len(cp.kind))
	cp.kind = append(cp.kind, PFXCtxSingleton)
	cp.start = append(cp.start, int32(len(cp.rets)))
	cp.length = append(cp.length, 1)
	cp.rets = append(cp.rets, ret)
	cp.parents = append(cp.parents, parent)
	cp.next = append(cp.next, -1)
	cp.singles.set(k, id)
	return id
}

func (cp *PFXCtxPool) isEmpty(c int32) bool {
	switch cp.kind[c] {
	case PFXCtxEmpty:
		return true
	case PFXCtxArray:
		return cp.length[c] > 0 && cp.rets[cp.start[c]] == PFXEmptyReturn
	}
	return false
}

// toArray is ANTLR's convertToArray: EMPTY becomes an array with no entries.
func (cp *PFXCtxPool) toArray(c int32) int32 {
	switch cp.kind[c] {
	case PFXCtxEmpty:
		return cp.intern(PFXCtxArray, nil, nil)
	case PFXCtxSingleton:
		s := cp.start[c]
		one := [2]int32{cp.rets[s], cp.parents[s]}
		return cp.intern(PFXCtxArray, one[0:1], one[1:2])
	}
	return c
}

func PFXMergeKey(a, b int32) uint64 { return uint64(uint32(a))<<32 | uint64(uint32(b)) }

func (cp *PFXCtxPool) cached(a, b int32) (int32, bool) {
	if r, ok := cp.merges.get(PFXMergeKey(a, b)); ok {
		return r, true
	}
	return cp.merges.get(PFXMergeKey(b, a))
}

// merge is ANTLR's merge(a, b, rootIsWildcard, mergeCache).
func (cp *PFXCtxPool) merge(a, b int32) int32 {
	if a == b {
		return a
	}
	if cp.kind[a] == PFXCtxSingleton && cp.kind[b] == PFXCtxSingleton {
		return cp.mergeSingletons(a, b)
	}
	if cp.wildcard {
		if cp.isEmpty(a) {
			return a
		}
		if cp.isEmpty(b) {
			return b
		}
	}
	return cp.mergeArrays(cp.toArray(a), cp.toArray(b))
}

func (cp *PFXCtxPool) mergeSingletons(a, b int32) int32 {
	if r, ok := cp.cached(a, b); ok {
		return r
	}
	ar, ap := cp.rets[cp.start[a]], cp.parents[cp.start[a]]
	br, bp := cp.rets[cp.start[b]], cp.parents[cp.start[b]]
	var r int32
	if ar == br {
		parent := cp.merge(ap, bp)
		if parent == ap {
			return a
		}
		if parent == bp {
			return b
		}
		r = cp.singleton(parent, ar)
	} else if ap >= 0 && ap == bp {
		lo, hi := min(ar, br), max(ar, br)
		r = cp.intern(PFXCtxArray, []int32{lo, hi}, []int32{ap, ap})
	} else if ar < br {
		r = cp.intern(PFXCtxArray, []int32{ar, br}, []int32{ap, bp})
	} else {
		r = cp.intern(PFXCtxArray, []int32{br, ar}, []int32{bp, ap})
	}
	cp.merges.set(PFXMergeKey(a, b), r)
	return r
}

func (cp *PFXCtxPool) mergeArrays(a, b int32) int32 {
	if r, ok := cp.cached(a, b); ok {
		return r
	}
	as, al := cp.start[a], cp.length[a]
	bs, bl := cp.start[b], cp.length[b]
	rets := make([]int32, 0, al+bl)
	parents := make([]int32, 0, al+bl)
	i, j := int32(0), int32(0)
	for i < al && j < bl {
		ar, ap := cp.rets[as+i], cp.parents[as+i]
		br, bp := cp.rets[bs+j], cp.parents[bs+j]
		switch {
		case ar == br:
			bothDollars := ar == PFXEmptyReturn && ap < 0 && bp < 0
			if bothDollars || (ap >= 0 && bp >= 0 && ap == bp) {
				parents = append(parents, ap)
			} else {
				parents = append(parents, cp.merge(ap, bp))
				// The merge may have grown the pool; re-read the bases.
				as, bs = cp.start[a], cp.start[b]
			}
			rets = append(rets, ar)
			i++
			j++
		case ar < br:
			rets, parents = append(rets, ar), append(parents, ap)
			i++
		default:
			rets, parents = append(rets, br), append(parents, bp)
			j++
		}
	}
	for ; i < al; i++ {
		rets, parents = append(rets, cp.rets[as+i]), append(parents, cp.parents[as+i])
	}
	for ; j < bl; j++ {
		rets, parents = append(rets, cp.rets[bs+j]), append(parents, cp.parents[bs+j])
	}
	var r int32
	if int32(len(rets)) < al+bl && len(rets) == 1 {
		r = cp.singleton(parents[0], rets[0])
	} else {
		r = cp.intern(PFXCtxArray, rets, parents)
	}
	cp.merges.set(PFXMergeKey(a, b), r)
	return r
}

// PFXConfig is an ATN configuration: a state, the alternative it predicts and
// its context (an id in the predictor's pool).
type PFXConfig struct {
	state int32
	alt   int32
	ctx   int32
}

func (c PFXConfig) key() uint64 {
	return uint64(uint32(c.ctx))<<32 | uint64(uint32(c.state))<<12 | uint64(uint32(c.alt)&0xfff)
}

// PFXMap maps uint64 keys to int32 values: open addressing, cleared in O(1)
// by bumping the generation. A slot holds its key, value and generation
// together, so a probe reads one cache line.
type PFXMap struct {
	slots []PFXSlot
	gen   uint32
	n     int
}

type PFXSlot struct {
	key uint64
	val int32
	gen uint32
}

func (m *PFXMap) reset() {
	m.gen++
	m.n = 0
	if m.slots == nil || m.gen == 0 {
		m.slots = make([]PFXSlot, 64)
		m.gen = 1
	}
}

func PFXMix(k uint64) uint64 {
	k ^= k >> 33
	k *= 0xff51afd7ed558ccd
	k ^= k >> 33
	return k
}

// put stores v for k unless k is present; it returns the stored value and
// whether k was new.
func (m *PFXMap) put(k uint64, v int32) (int32, bool) {
	if 2*(m.n+1) > len(m.slots) {
		m.grow()
	}
	mask := uint64(len(m.slots) - 1)
	for i := PFXMix(k) & mask; ; i = (i + 1) & mask {
		s := &m.slots[i]
		if s.gen != m.gen {
			*s = PFXSlot{k, v, m.gen}
			m.n++
			return v, true
		}
		if s.key == k {
			return s.val, false
		}
	}
}

// get returns the value stored for k.
func (m *PFXMap) get(k uint64) (int32, bool) {
	if m.n == 0 {
		return 0, false
	}
	mask := uint64(len(m.slots) - 1)
	for i := PFXMix(k) & mask; ; i = (i + 1) & mask {
		s := &m.slots[i]
		if s.gen != m.gen {
			return 0, false
		}
		if s.key == k {
			return s.val, true
		}
	}
}

// set stores v for k, replacing any earlier value.
func (m *PFXMap) set(k uint64, v int32) {
	if 2*(m.n+1) > len(m.slots) {
		m.grow()
	}
	mask := uint64(len(m.slots) - 1)
	for i := PFXMix(k) & mask; ; i = (i + 1) & mask {
		s := &m.slots[i]
		if s.gen != m.gen {
			*s = PFXSlot{k, v, m.gen}
			m.n++
			return
		}
		if s.key == k {
			s.val = v
			return
		}
	}
}

func (m *PFXMap) grow() {
	old, gen := m.slots, m.gen
	m.slots = make([]PFXSlot, 2*len(old))
	m.gen = 1
	m.n = 0
	for _, s := range old {
		if s.gen == gen {
			m.put(s.key, s.val)
		}
	}
}

// PFXConfigSet is ANTLR's ATNConfigSet: one configuration per (state, alt),
// whose context is the merge of every context added for it.
type PFXConfigSet struct {
	list []PFXConfig
	at   PFXMap
}

func (s *PFXConfigSet) add(c PFXConfig, cp *PFXCtxPool) {
	k := uint64(uint32(c.state))<<32 | uint64(uint32(c.alt))
	if i, isNew := s.at.put(k, int32(len(s.list))); !isNew {
		s.list[i].ctx = cp.merge(s.list[i].ctx, c.ctx)
		return
	}
	s.list = append(s.list, c)
}

func (s *PFXConfigSet) reset() {
	s.list = s.list[:0]
	s.at.reset()
}

// PFXPredictor holds the scratch state of runtime prediction.
type PFXPredictor struct {
	full    bool
	pool    PFXCtxPool
	busy    PFXMap
	sets    [3]PFXConfigSet
	skipped []PFXConfig
	sorted  []PFXConfig
	multi   bool
	// Scratch for subsets.
	groups     PFXMap
	states     PFXMap
	groupMin   []int32
	stateAlt   []int32
	stateMulti []bool
}

// matches reports whether consuming transition i accepts token type t.
func PFXMatches(i int32, t int32) bool {
	switch PFXTransKind[i] {
	case PFXKindAtom:
		return PFXTransArg[i] == t
	case PFXKindSet:
		set := PFXSets[PFXTransArg[i]]
		lo, hi := 0, len(set)/2-1
		for lo <= hi {
			mid := (lo + hi) / 2
			if t < set[2*mid] {
				hi = mid - 1
			} else if t > set[2*mid+1] {
				lo = mid + 1
			} else {
				return true
			}
		}
	}
	return false
}

// closure adds c and every configuration reachable from it without consuming
// a token to out (ANTLR's closureCheckingStopState and closureWork).
//
// Within a rule, what a state reaches without consuming is the same in every
// context, so it comes from the precomputed PFXClos tables; only rule calls
// and rule ends are handled here. After EOF, transitions that match EOF also
// count as epsilon, which the tables do not cover, so that case walks the ATN.
func (pr *PFXPredictor) closure(c PFXConfig, out *PFXConfigSet, eofAsEpsilon bool) {
	if _, isNew := pr.busy.put(c.key(), 0); !isNew {
		return
	}
	if PFXStateIsStop[c.state] {
		pr.ruleEnd(c, out, eofAsEpsilon)
		return
	}
	if eofAsEpsilon {
		pr.walk(c, out)
		return
	}
	cp := &pr.pool
	for i := PFXClosStart[c.state]; i < PFXClosStart[c.state+1]; i++ {
		s := PFXClosState[i]
		switch PFXClosKind[i] {
		case 0:
			out.add(PFXConfig{s, c.alt, c.ctx}, cp)
		case 1:
			pr.closure(PFXConfig{s, c.alt, cp.singleton(c.ctx, PFXClosArg[i])}, out, false)
		default:
			pr.closure(PFXConfig{s, c.alt, c.ctx}, out, false)
		}
	}
}

// walk is closure over the ATN transitions themselves, for after EOF.
func (pr *PFXPredictor) walk(c PFXConfig, out *PFXConfigSet) {
	cp := &pr.pool
	if !PFXStateEpsOnly[c.state] {
		out.add(c, cp)
	}
	for i := PFXTransStart[c.state]; i < PFXTransStart[c.state+1]; i++ {
		switch PFXTransKind[i] {
		case PFXKindEpsilon:
			pr.closure(PFXConfig{PFXTransTarget[i], c.alt, c.ctx}, out, true)
		case PFXKindRule:
			pr.closure(PFXConfig{PFXTransTarget[i], c.alt, cp.singleton(c.ctx, PFXTransArg[i])}, out, true)
		default:
			if PFXMatches(i, -1) {
				pr.closure(PFXConfig{PFXTransTarget[i], c.alt, c.ctx}, out, true)
			}
		}
	}
}

// ruleEnd continues a configuration at a rule's end: back to each return state
// of its context, or, with the context exhausted, at the end of the start rule
// (LL) or after every call of the rule (SLL).
func (pr *PFXPredictor) ruleEnd(c PFXConfig, out *PFXConfigSet, eofAsEpsilon bool) {
	cp := &pr.pool
	{
		if !cp.isEmpty(c.ctx) {
			for i := int32(0); i < cp.length[c.ctx]; i++ {
				ret, parent := cp.rets[cp.start[c.ctx]+i], cp.parents[cp.start[c.ctx]+i]
				if ret == PFXEmptyReturn {
					if pr.full {
						out.add(PFXConfig{c.state, c.alt, 0}, cp)
					} else {
						pr.follow(c, out, eofAsEpsilon)
					}
					continue
				}
				pr.closure(PFXConfig{ret, c.alt, parent}, out, eofAsEpsilon)
			}
			return
		}
		if pr.full {
			// End of the start rule in full context.
			out.add(c, cp)
			return
		}
		pr.follow(c, out, eofAsEpsilon)
	}
}

// follow continues a configuration at a rule's end after every call of the
// rule (ANTLR's rule-stop follow links, used when the caller is unknown). A
// rule nobody calls keeps the configuration at its end.
func (pr *PFXPredictor) follow(c PFXConfig, out *PFXConfigSet, eofAsEpsilon bool) {
	rule := PFXStateRule[c.state]
	if PFXFollowStart[rule] == PFXFollowStart[rule+1] {
		out.add(c, &pr.pool)
		return
	}
	for i := PFXFollowStart[rule]; i < PFXFollowStart[rule+1]; i++ {
		pr.closure(PFXConfig{PFXFollowState[i], c.alt, c.ctx}, out, eofAsEpsilon)
	}
}

func PFXUniqueAlt(list []PFXConfig) int32 {
	alt := int32(0)
	for _, c := range list {
		if alt == 0 {
			alt = c.alt
		} else if c.alt != alt {
			return 0
		}
	}
	return alt
}

// reach computes the configurations reachable from closure by consuming t
// (ANTLR's computeReachSet). With group set, t is an opening bracket and the
// whole bracketed group is consumed: a configuration moves to the states after
// the matching closer. The result is in out; a non-zero return is an
// alternative decided early.
func (pr *PFXPredictor) reach(closure *PFXConfigSet, t int32, group bool, intermediate, out *PFXConfigSet) int32 {
	cp := &pr.pool
	intermediate.reset()
	pr.skipped = pr.skipped[:0]
	for _, c := range closure.list {
		if PFXStateIsStop[c.state] {
			if pr.full || t == -1 {
				pr.skipped = append(pr.skipped, c)
			}
			continue
		}
		for i := PFXTransStart[c.state]; i < PFXTransStart[c.state+1]; i++ {
			k := PFXTransKind[i]
			if k != PFXKindAtom && k != PFXKindSet || !PFXMatches(i, t) {
				continue
			}
			if !group {
				intermediate.add(PFXConfig{PFXTransTarget[i], c.alt, c.ctx}, cp)
				continue
			}
			for j := PFXAfterStart[i]; j < PFXAfterStart[i+1]; j++ {
				intermediate.add(PFXConfig{PFXAfterState[j], c.alt, c.ctx}, cp)
			}
		}
	}
	if len(pr.skipped) == 0 && t != -1 {
		if alt := PFXUniqueAlt(intermediate.list); alt != 0 {
			return alt
		}
	}
	out.reset()
	pr.busy.reset()
	for _, c := range intermediate.list {
		pr.closure(c, out, t == -1)
	}
	if t == -1 {
		// After EOF only configurations at the end of a rule matter.
		n := 0
		for _, c := range out.list {
			if PFXStateIsStop[c.state] {
				out.list[n] = c
				n++
			}
		}
		out.list = out.list[:n]
		out.at.reset()
		for i, c := range out.list {
			out.at.put(uint64(uint32(c.state))<<32|uint64(uint32(c.alt)), int32(i))
		}
	}
	if len(pr.skipped) > 0 {
		inStop := false
		for _, c := range out.list {
			if PFXStateIsStop[c.state] {
				inStop = true
				break
			}
		}
		if !pr.full || !inStop {
			for _, c := range pr.skipped {
				out.add(c, cp)
			}
		}
	}
	return 0
}

// subsets computes ANTLR's conflicting alternative subsets of set (its
// configurations grouped by state and context). It returns the lowest
// alternative common to all subsets' minimums (0 if they differ), sets
// pr.multi when some subset has more than one alternative, and reports
// whether some state is associated with exactly one alternative.
func (pr *PFXPredictor) subsets(set *PFXConfigSet) (single int32, stateWithOneAlt bool) {
	// A configuration set holds one configuration per (state, alt), so two
	// configurations in the same (state, ctx) group always differ in alt.
	pr.groups.reset()
	pr.states.reset()
	pr.groupMin = pr.groupMin[:0]
	pr.stateAlt = pr.stateAlt[:0]
	pr.stateMulti = pr.stateMulti[:0]
	pr.multi = false
	for _, c := range set.list {
		g, isNew := pr.groups.put(uint64(uint32(c.state))<<32|uint64(uint32(c.ctx)), int32(len(pr.groupMin)))
		if isNew {
			pr.groupMin = append(pr.groupMin, c.alt)
		} else {
			pr.multi = true
			pr.groupMin[g] = min(pr.groupMin[g], c.alt)
		}
		s, isNew := pr.states.put(uint64(uint32(c.state)), int32(len(pr.stateAlt)))
		if isNew {
			pr.stateAlt = append(pr.stateAlt, c.alt)
			pr.stateMulti = append(pr.stateMulti, false)
		} else if pr.stateAlt[s] != c.alt {
			pr.stateMulti[s] = true
		}
	}
	for _, m := range pr.stateMulti {
		if !m {
			stateWithOneAlt = true
			break
		}
	}
	for _, m := range pr.groupMin {
		if single == 0 {
			single = m
		} else if single != m {
			return 0, stateWithOneAlt
		}
	}
	return single, stateWithOneAlt
}

func PFXAllInStop(list []PFXConfig) bool {
	for _, c := range list {
		if !PFXStateIsStop[c.state] {
			return false
		}
	}
	return true
}

// PFXDFAState is a state of a decision's SLL lookahead DFA, cached for the
// life of the process as ANTLR caches its DFA. Walking existing edges takes
// no lock; new states are computed under PFXDFA.mu.
type PFXDFAState struct {
	configs  []PFXConfig
	alt      int32
	conflict int32
	edges    []atomic.Pointer[PFXDFAState]
}

// PFXDFA holds every decision's cached SLL DFA. Its context pool is never
// reset, so cached configurations keep meaning the same contexts.
var PFXDFA struct {
	mu     sync.Mutex
	starts []atomic.Pointer[PFXDFAState]
	states map[string]*PFXDFAState
	pr     PFXPredictor
	key    []byte
}

// PFXDFAError marks an edge on which no alternative is viable.
var PFXDFAError = &PFXDFAState{}

func init() {
	PFXDFA.starts = make([]atomic.Pointer[PFXDFAState], len(PFXDecisionState))
	PFXDFA.states = map[string]*PFXDFAState{}
	PFXDFA.pr.pool.reset(true)
}

// PFXDFAIntern returns decision d's cached state for the configurations in set.
func PFXDFAIntern(d int, set *PFXConfigSet) *PFXDFAState {
	return PFXInternState(PFXDFA.states, &PFXDFA.pr, &PFXDFA.key, d, set, PFXEdges)
}

// PFXInternState returns the state in states for the configurations in set,
// adding it if new. A state keeps its configurations sorted by state and
// alternative; its key is that list, after decision d when d >= 0. pr and key
// are scratch, owned by whoever owns states. A new state has edges edges.
func PFXInternState(states map[string]*PFXDFAState, pr *PFXPredictor, key *[]byte, d int, set *PFXConfigSet, edges int) *PFXDFAState {
	s := append(pr.sorted[:0], set.list...)
	pr.sorted = s
	slices.SortFunc(s, func(a, b PFXConfig) int {
		if a.state != b.state {
			return int(a.state - b.state)
		}
		return int(a.alt - b.alt)
	})
	k := (*key)[:0]
	if d >= 0 {
		k = binary.LittleEndian.AppendUint32(k, uint32(d))
	}
	for _, c := range s {
		k = binary.LittleEndian.AppendUint32(k, uint32(c.state))
		k = binary.LittleEndian.AppendUint32(k, uint32(c.alt))
		k = binary.LittleEndian.AppendUint32(k, uint32(c.ctx))
	}
	*key = k
	if st, ok := states[string(k)]; ok {
		return st
	}
	st := &PFXDFAState{configs: slices.Clone(s), edges: make([]atomic.Pointer[PFXDFAState], edges)}
	states[string(k)] = st
	return st
}

// PFXDFAStart returns decision d's start state, computing it once.
func PFXDFAStart(d int) *PFXDFAState {
	PFXDFA.mu.Lock()
	defer PFXDFA.mu.Unlock()
	if st := PFXDFA.starts[d].Load(); st != nil {
		return st
	}
	pr := &PFXDFA.pr
	pr.full = false
	cur := &pr.sets[0]
	cur.reset()
	pr.busy.reset()
	s := PFXDecisionState[d]
	for i := PFXTransStart[s]; i < PFXTransStart[s+1]; i++ {
		pr.closure(PFXConfig{PFXTransTarget[i], i - PFXTransStart[s] + 1, 0}, cur, false)
	}
	st := PFXDFAIntern(d, cur)
	PFXDFA.starts[d].Store(st)
	return st
}

// PFXDFANext computes and caches the edge of from on symbol sym (ANTLR's
// computeTargetState in SLL mode): token t, or with group set the bracketed
// group t opens.
func PFXDFANext(d int, from *PFXDFAState, sym int, t int32, group bool) *PFXDFAState {
	PFXDFA.mu.Lock()
	defer PFXDFA.mu.Unlock()
	if st := from.edges[sym].Load(); st != nil {
		return st
	}
	pr := &PFXDFA.pr
	pr.full = false
	cur, intermediate, next := &pr.sets[0], &pr.sets[1], &pr.sets[2]
	cur.reset()
	for _, c := range from.configs {
		cur.add(c, &pr.pool)
	}
	var st *PFXDFAState
	if alt := pr.reach(cur, t, group, intermediate, next); alt != 0 {
		st = &PFXDFAState{alt: alt}
	} else if len(next.list) == 0 {
		st = PFXDFAError
	} else if alt := PFXUniqueAlt(next.list); alt != 0 {
		st = &PFXDFAState{alt: alt}
	} else if _, oneAlt := pr.subsets(next); PFXAllInStop(next.list) || (pr.multi && !oneAlt) {
		// An SLL conflict: ANTLR's SLL answer is the lowest conflicting alternative.
		low := next.list[0].alt
		for _, c := range next.list {
			low = min(low, c.alt)
		}
		st = &PFXDFAState{conflict: low}
	} else {
		st = PFXDFAIntern(d, next)
	}
	from.edges[sym].Store(st)
	return st
}

// adaptivePredict predicts decision d as ANTLR's SLL prediction does, over
// the cached DFA, reading each bracketed group as one symbol (PFXBracketMatch
// paired them) unless p.group is off. That over-approximates SLL: every path
// over the tokens has a path over the groups, so an alternative ruled out here
// is ruled out in SLL and in LL, and a unique answer is ANTLR's. A conflict
// goes to onConflict with its smallest alternative: a first pass that
// succeeds with such choices is ANTLR's LL parse, and a wrong one is repaired.
func (p *PARSER) adaptivePredict(d int) int {
	st := PFXDFA.starts[d].Load()
	if st == nil {
		st = PFXDFAStart(d)
	}
	for i := p.pos; ; {
		// Past the end of the tokens (a slice with no EOF at its end) reads as EOF.
		t := int32(-1)
		if i < len(p.types) {
			t = p.types[i]
		}
		if t < -1 || int(t) > PFXMaxTokenType {
			p.noViableAlt(d)
		}
		sym, isGroup := int(t)+1, false
		if g := PFXOpenerSym[t+1]; p.group && g >= 0 && p.pairs[i] >= 0 {
			sym, isGroup = PFXMaxTokenType+2+int(g), true
			i = int(p.pairs[i]) + 1
		} else if t != -1 {
			i++
		}
		next := st.edges[sym].Load()
		if next == nil {
			next = PFXDFANext(d, st, sym, t, isGroup)
		}
		switch {
		case next == PFXDFAError:
			p.noViableAlt(d)
		case next.alt > 0:
			return int(next.alt)
		case next.conflict > 0:
			return p.onConflict(d, int(next.conflict))
		}
		st = next
	}
}

// PFXEdges is the number of DFA edges per state: one per token type and EOF,
// then one per opening bracket for the group it opens.
const PFXEdges = PFXMaxTokenType + 2 + PFXOpenerCount

// PFXBracketMatch pairs the brackets of types into m: m[i] is the index of
// the closer of the opener at i, or -1. An opener with no well-nested closer
// (the input is not in the language) is left at -1, and prediction reads it
// as a token. Without brackets in the grammar m is not read and stays as is.
func PFXBracketMatch(types []int32, m []int32) []int32 {
	if PFXOpenerCount == 0 {
		return m
	}
	m = slices.Grow(m[:0], len(types))[:len(types)]
	var open []int32
	for i, t := range types {
		m[i] = -1
		if t < -1 || int(t) > PFXMaxTokenType {
			continue
		}
		if PFXOpenerSym[t+1] >= 0 {
			open = append(open, int32(i))
			continue
		}
		if !PFXIsCloser[t+1] || len(open) == 0 {
			continue
		}
		top := open[len(open)-1]
		if PFXOpenerCloser[PFXOpenerSym[types[top]+1]] == t {
			m[top] = int32(i)
			open = open[:len(open)-1]
		} else {
			// A closer of the wrong kind: no opener still open can close
			// around it.
			open = open[:0]
		}
	}
	return m
}
`
