package golang

// predictorSource is the Go code of the runtime predictor that generated
// parsers include when the analysis left decisions to full-context
// prediction. PFX is replaced with a per-grammar prefix and PARSER with the
// parser type.
//
// It is ANTLR 4's full-context (LL) prediction (ParserATNSimulator
// execATNWithFullContext, computeReachSet, closure, getConflictingAltSubsets,
// getSingleViableAlt), run over the static ATN tables with the parser's real
// call stack, so it picks the alternative ANTLR picks. A prediction stack is
// an interned frame (an index into a pool); a configuration set keeps one
// entry per (state, alt, stack); conflict subsets group configurations by
// state and by the set of stacks of each (state, alt), which is what ANTLR's
// merged contexts denote. All scratch memory is reused across predictions:
// sets are open-addressing tables cleared by bumping a generation number.
val predictorSource = `
// PFXFrame is one frame of a prediction stack: the ATN state to return to
// and the frame below it (-1 is the empty stack: the start rule's caller).
type PFXFrame struct {
	ret    int32
	parent int32
}

// PFXConfig is an ATN configuration: a state, the alternative it predicts and
// its stack (a frame index, -1 for empty).
type PFXConfig struct {
	state int32
	alt   int32
	ctx   int32
}

func (c PFXConfig) key() uint64 {
	return uint64(uint32(c.ctx))<<32 | uint64(uint32(c.state))<<12 | uint64(uint32(c.alt)&0xfff)
}

// PFXSet is a set of uint64 keys: open addressing, cleared in O(1) by
// bumping the generation.
type PFXSet struct {
	keys []uint64
	gens []uint32
	gen  uint32
	n    int
}

func (s *PFXSet) reset() {
	s.gen++
	s.n = 0
	if s.keys == nil || s.gen == 0 {
		s.keys = make([]uint64, 64)
		s.gens = make([]uint32, 64)
		s.gen = 1
	}
}

func PFXMix(k uint64) uint64 {
	k ^= k >> 33
	k *= 0xff51afd7ed558ccd
	k ^= k >> 33
	return k
}

// insert adds k and reports whether it was new.
func (s *PFXSet) insert(k uint64) bool {
	if 2*(s.n+1) > len(s.keys) {
		s.grow()
	}
	mask := uint64(len(s.keys) - 1)
	for i := PFXMix(k) & mask; ; i = (i + 1) & mask {
		if s.gens[i] != s.gen {
			s.gens[i] = s.gen
			s.keys[i] = k
			s.n++
			return true
		}
		if s.keys[i] == k {
			return false
		}
	}
}

func (s *PFXSet) grow() {
	oldKeys, oldGens, gen := s.keys, s.gens, s.gen
	s.keys = make([]uint64, 2*len(oldKeys))
	s.gens = make([]uint32, 2*len(oldKeys))
	s.gen = 1
	s.n = 0
	for i, k := range oldKeys {
		if oldGens[i] == gen {
			s.insert(k)
		}
	}
}

// PFXConfigSet is an insertion-ordered set of configurations.
type PFXConfigSet struct {
	list []PFXConfig
	seen PFXSet
}

func (s *PFXConfigSet) add(c PFXConfig) {
	if s.seen.insert(c.key()) {
		s.list = append(s.list, c)
	}
}

func (s *PFXConfigSet) reset() {
	s.list = s.list[:0]
	s.seen.reset()
}

// PFXPredictor holds the scratch state of full-context prediction, reused
// across decisions.
type PFXPredictor struct {
	frames  []PFXFrame
	frameIx PFXSet
	frameAt []int32
	busy    PFXSet
	sets    [3]PFXConfigSet
	skipped []PFXConfig
	sorted  []PFXConfig
}

// push interns the frame (ret, parent) and returns its index.
func (pr *PFXPredictor) push(ret int32, parent int32) int32 {
	k := uint64(uint32(ret))<<32 | uint64(uint32(parent))
	s := &pr.frameIx
	if 2*(s.n+1) > len(s.keys) {
		// Rebuild the index at twice the size; frame indexes stay valid.
		size := 2 * len(s.keys)
		s.keys = make([]uint64, size)
		s.gens = make([]uint32, size)
		pr.frameAt = make([]int32, size)
		s.gen = 1
		s.n = 0
		mask := uint64(size - 1)
		for id, f := range pr.frames {
			fk := uint64(uint32(f.ret))<<32 | uint64(uint32(f.parent))
			i := PFXMix(fk) & mask
			for s.gens[i] == s.gen {
				i = (i + 1) & mask
			}
			s.gens[i], s.keys[i], pr.frameAt[i] = s.gen, fk, int32(id)
			s.n++
		}
	}
	mask := uint64(len(s.keys) - 1)
	for i := PFXMix(k) & mask; ; i = (i + 1) & mask {
		if s.gens[i] != s.gen {
			id := int32(len(pr.frames))
			pr.frames = append(pr.frames, PFXFrame{ret, parent})
			s.gens[i], s.keys[i], pr.frameAt[i] = s.gen, k, id
			s.n++
			return id
		}
		if s.keys[i] == k {
			return pr.frameAt[i]
		}
	}
}

func (pr *PFXPredictor) start() {
	pr.frames = pr.frames[:0]
	if pr.frameIx.keys == nil {
		pr.frameIx.reset()
		pr.frameAt = make([]int32, len(pr.frameIx.keys))
	} else {
		pr.frameIx.reset()
	}
}

// matches reports whether consuming transition i accepts token type t.
func PFXMatches(i int32, t int32) bool {
	switch PFXTransKind[i] {
	case PFXKindAtom:
		return PFXTransArg[i] == t
	case PFXKindSet:
		set := PFXSets[PFXTransArg[i]]
		lo, hi := 0, len(set)/2-1
		for lo <= hi {
			mid := (lo + hi) / 2
			if t < set[2*mid] {
				hi = mid - 1
			} else if t > set[2*mid+1] {
				lo = mid + 1
			} else {
				return true
			}
		}
	}
	return false
}

// closure adds c and every configuration reachable from it without consuming
// a token (following rule calls and returns) to out.
func (pr *PFXPredictor) closure(c PFXConfig, out *PFXConfigSet, eofAsEpsilon bool) {
	if !pr.busy.insert(c.key()) {
		return
	}
	if PFXStateIsStop[c.state] {
		if c.ctx < 0 {
			// End of the start rule in full context.
			out.add(c)
			return
		}
		f := pr.frames[c.ctx]
		pr.closure(PFXConfig{f.ret, c.alt, f.parent}, out, eofAsEpsilon)
		return
	}
	if !PFXStateEpsOnly[c.state] {
		out.add(c)
	}
	for i := PFXTransStart[c.state]; i < PFXTransStart[c.state+1]; i++ {
		switch PFXTransKind[i] {
		case PFXKindEpsilon:
			pr.closure(PFXConfig{PFXTransTarget[i], c.alt, c.ctx}, out, eofAsEpsilon)
		case PFXKindRule:
			pr.closure(PFXConfig{PFXTransTarget[i], c.alt, pr.push(PFXTransArg[i], c.ctx)}, out, eofAsEpsilon)
		default:
			if eofAsEpsilon && PFXMatches(i, -1) {
				pr.closure(PFXConfig{PFXTransTarget[i], c.alt, c.ctx}, out, eofAsEpsilon)
			}
		}
	}
}

func PFXUniqueAlt(list []PFXConfig) int32 {
	alt := int32(0)
	for _, c := range list {
		if alt == 0 {
			alt = c.alt
		} else if c.alt != alt {
			return 0
		}
	}
	return alt
}

// reach computes the configurations reachable from closure by consuming t
// (ANTLR's computeReachSet in full-context mode). The result is in out; a
// non-zero return is an alternative decided early.
func (pr *PFXPredictor) reach(closure *PFXConfigSet, t int32, intermediate, out *PFXConfigSet) int32 {
	intermediate.reset()
	pr.skipped = pr.skipped[:0]
	for _, c := range closure.list {
		if PFXStateIsStop[c.state] {
			pr.skipped = append(pr.skipped, c)
			continue
		}
		for i := PFXTransStart[c.state]; i < PFXTransStart[c.state+1]; i++ {
			k := PFXTransKind[i]
			if (k == PFXKindAtom || k == PFXKindSet) && PFXMatches(i, t) {
				intermediate.add(PFXConfig{PFXTransTarget[i], c.alt, c.ctx})
			}
		}
	}
	if len(pr.skipped) == 0 && t != -1 {
		if alt := PFXUniqueAlt(intermediate.list); alt != 0 {
			return alt
		}
	}
	out.reset()
	pr.busy.reset()
	for _, c := range intermediate.list {
		pr.closure(c, out, t == -1)
	}
	if t == -1 {
		// After EOF only configurations at the end of the start rule matter.
		n := 0
		for _, c := range out.list {
			if PFXStateIsStop[c.state] {
				out.list[n] = c
				n++
			}
		}
		out.list = out.list[:n]
	}
	if len(pr.skipped) > 0 {
		inStop := false
		for _, c := range out.list {
			if PFXStateIsStop[c.state] {
				inStop = true
				break
			}
		}
		if !inStop {
			for _, c := range pr.skipped {
				out.add(c)
			}
		}
	}
	return 0
}

// resolve applies ANTLR's LL stopping rule: group configurations by state and
// by the stacks of each (state, alt); when every group's lowest alternative is
// the same, that alternative wins.
func (pr *PFXPredictor) resolve(set *PFXConfigSet) int32 {
	s := append(pr.sorted[:0], set.list...)
	pr.sorted = s
	slices.SortFunc(s, func(a, b PFXConfig) int {
		if a.state != b.state {
			return int(a.state - b.state)
		}
		if a.alt != b.alt {
			return int(a.alt - b.alt)
		}
		return int(a.ctx - b.ctx)
	})
	result := int32(0)
	// For each state: runs of equal (state, alt) are an alternative's stack
	// set. Runs with identical stack sets form one ANTLR subset; its minimum
	// alternative is the run seen first, since runs are sorted by alt.
	for i := 0; i < len(s); {
		j := i
		for j < len(s) && s[j].state == s[i].state {
			j++
		}
		// Runs of this state: [i, j).
		for r := i; r < j; {
			re := r
			for re < j && s[re].alt == s[r].alt {
				re++
			}
			first := true
			for q := i; q < r; {
				qe := q
				for qe < r && s[qe].alt == s[q].alt {
					qe++
				}
				if PFXSameStacks(s[q:qe], s[r:re]) {
					first = false
					break
				}
				q = qe
			}
			if first {
				if result == 0 {
					result = s[r].alt
				} else if result != s[r].alt {
					return 0
				}
			}
			r = re
		}
		i = j
	}
	return result
}

func PFXSameStacks(a, b []PFXConfig) bool {
	if len(a) != len(b) {
		return false
	}
	for k := range a {
		if a[k].ctx != b[k].ctx {
			return false
		}
	}
	return true
}

// adaptivePredict picks the alternative of decision d the way ANTLR's
// full-context prediction does, using the parser's call stack as context.
func (p *PARSER) adaptivePredict(d int) int {
	pr := &p.pred
	pr.start()
	outer := int32(-1)
	for _, ret := range p.stack {
		outer = pr.push(ret, outer)
	}
	cur, intermediate, next := &pr.sets[0], &pr.sets[1], &pr.sets[2]
	cur.reset()
	pr.busy.reset()
	s := PFXDecisionState[d]
	for i := PFXTransStart[s]; i < PFXTransStart[s+1]; i++ {
		pr.closure(PFXConfig{PFXTransTarget[i], i - PFXTransStart[s] + 1, outer}, cur, false)
	}
	offset := 0
	for {
		t := p.la(offset + 1)
		if alt := pr.reach(cur, t, intermediate, next); alt != 0 {
			return int(alt)
		}
		if len(next.list) == 0 {
			p.noViableAlt(d)
		}
		if alt := PFXUniqueAlt(next.list); alt != 0 {
			return int(alt)
		}
		if alt := pr.resolve(next); alt != 0 {
			return int(alt)
		}
		cur, next = next, cur
		if t != -1 {
			offset++
		}
	}
}
`
