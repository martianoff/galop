package golang

import (
    "strings"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/analysis"
    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/codegen"
    "github.com/martianoff/galop/g4"
    "github.com/martianoff/galop/lexgen"
)

// goTarget generates Go; Version is stamped into generated files.
struct goTarget(Version string)

// Target is the Go code generator (`-Dlanguage=Go`) of galop release version.
func Target(version string) codegen.Target = goTarget(version)

func (t goTarget) Language() string = "Go"

// Generate returns the Go files for in. The `flavor` option picks the shape:
// `companion` (the default) builds ANTLR's own context types and lives in the
// package of ANTLR's generated code.
func (t goTarget) Generate(in codegen.Input, opts codegen.Options) Either[Array[string], Array[codegen.OutputFile]] =
    opts.Define("flavor").GetOrElse("companion") match {
        case "companion" => companion(in, opts, t.Version)
        case other => Left(ArrayOf(s"Go target: unknown flavor '$other' (supported: companion)"))
    }

// fileBase is the prefix of the generated files' names, as ANTLR's Go target
// names its files: the grammar name lowercased, without a trailing `Parser`
// for a parser grammar or `Lexer` for a lexer grammar.
func fileBase(g g4.Grammar) string {
    val trimmed = g.Kind match {
        case g4.ParserOnly() if g.Name != "Parser" => strings.TrimSuffix(g.Name, "Parser")
        case g4.LexerOnly() if g.Name != "Lexer" => strings.TrimSuffix(g.Name, "Lexer")
        case _ => g.Name
    }
    strings.ToLower(trimmed)
}

// companion generates the fast parser and lexer that sit next to ANTLR's
// generated parser and lexer: `<base>_galop_parser.go` for a grammar with
// parser rules, `<base>_galop_lexer.go` for one with lexer rules.
func companion(in codegen.Input, opts codegen.Options, version string) Either[Array[string], Array[codegen.OutputFile]] {
    val base = fileBase(in.Grammar)
    val parser = companionParserFile(in, opts, version, base + "_galop_parser.go")
    val lexer = in.Compiled.Lexer match {
        case Some(_) => lexgen.GoLexerFile(in, opts, base + "_galop_lexer.go", in.Grammar.Name + "GalopLexer").Map((f) => ArrayOf(f))
        case None() => Right[Array[string], Array[codegen.OutputFile]](EmptyArray[codegen.OutputFile]())
    }
    parser match {
        case Right(p) => lexer.Map((l) => p.AppendAll(l))
        case Left(pe) => Left(pe.AppendAll(lexer.Fold((le) => le, (_) => EmptyArray[string]())))
    }
}

// companionParserFile generates the fast parser, if the grammar has parser rules.
func companionParserFile(in codegen.Input, opts codegen.Options, version string, name string) Either[Array[string], Array[codegen.OutputFile]] {
    val compiled = in.Compiled
    val predicates = compiled.Rules.Exists((r) => r.Alts.Exists((a) => hasPredicate(a.Steps)))
    if predicates {
        return Left(ArrayOf("Go target: semantic predicates are not supported yet"))
    }
    (compiled.Parser, in.Analysis) match {
        case (Some(parser), Some(an)) => {
            val grammar = in.Grammar.Name
            val e = env(
                names = Names(grammar),
                pfx = grammar + "Galop",
                parserType = grammar + "GalopParser",
                vocab = compiled.Vocab,
                parser = parser,
                rules = compiled.Rules,
                plans = an.Plans,
                adaptive = an.Plans.Exists((p) => hasAdaptive(p.Lookahead)),
            )
            val pkg = if (opts.Package == "") "parser" else opts.Package
            Right(ArrayOf(codegen.OutputFile(name, companionParser(e, pkg, version, grammar + ".g4"))))
        }
        case _ => Right(EmptyArray[codegen.OutputFile]())
    }
}

func hasAdaptive(la analysis.Lookahead) bool = la match {
    case analysis.Adaptive(_) => true
    case analysis.Automaton(states) => states.Exists((s) => s.Final match {
        case Some(analysis.FinalFullLL(_)) => true
        case _ => false
    })
    case analysis.Switch(_, cases) => cases.Exists((c) => hasAdaptive(c.Then))
    case _ => false
}

func hasPredicate(steps Array[atn.Step]) bool = steps.Exists((s) => s match {
    case atn.CheckPredicate(_) => true
    case atn.Choose(_, alts, _) => alts.Exists(hasPredicate)
    case atn.Loop(_, _, _, body) => hasPredicate(body)
    case _ => false
})
