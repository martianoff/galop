package golang

import (
    "strings"

    . "martianoff/gala/collection_immutable"

    "github.com/martianoff/galop/analysis"
    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/codegen"
    "github.com/martianoff/galop/g4"
    "github.com/martianoff/galop/lexgen"
)

// goTarget generates Go; Version is stamped into generated files.
struct goTarget(Version string)

// Target is the Go code generator (`-Dlanguage=Go`) of galop release version.
func Target(version string) codegen.Target = goTarget(version)

func (t goTarget) Language() string = "Go"

// GoFlavors are the values of the Go target's `flavor` option; the first is
// the default.
//
//   - `native`: galop's own tokens and tree, in `<base>_lexer.go` and
//     `<base>_parser.go`, with no dependency.
//   - `antlr`: builds ANTLR's own context types and tokens, in
//     `<base>_galop_lexer.go` and `<base>_galop_parser.go` next to ANTLR's
//     generated code, for programs written against ANTLR's trees.
val GoFlavors = ArrayOf("native", "antlr")

func (t goTarget) Flavors() Array[string] = GoFlavors

// flavorOf is the flavor the `flavor` option picks for grammar g (the
// default when it is not set), or None for a value that is not a flavor.
func flavorOf(opts codegen.Options, g g4.Grammar) Option[Flavor] = opts.Define("flavor").GetOrElse(GoFlavors.Head()) match {
    case "native" => Some(NativeFlavor(capitalize(baseName(g))))
    case "antlr" => Some(ANTLRFlavor())
    case _ => None()
}

// Generate returns the Go files for in in the chosen flavor.
func (t goTarget) Generate(in codegen.Input, opts codegen.Options) Either[Array[string], Array[codegen.OutputFile]] =
    flavorOf(opts, in.Grammar) match {
        case Some(f) => generateFlavor(in, opts, t.Version, f)
        case None() => Left(ArrayOf(s"Go target: unknown flavor '${opts.Define("flavor").GetOrElse("")}' (supported: ${GoFlavors.MkString(", ")})"))
    }

// baseName is the grammar name without the trailing `Parser` of a parser
// grammar or `Lexer` of a lexer grammar, as ANTLR's Go target trims it.
// galop names its own types after it: `ExprParser` and `Expr` both give
// `ExprGalopParser`.
func baseName(g g4.Grammar) string = g.Kind match {
    case g4.ParserOnly() if g.Name != "Parser" => strings.TrimSuffix(g.Name, "Parser")
    case g4.LexerOnly() if g.Name != "Lexer" => strings.TrimSuffix(g.Name, "Lexer")
    case _ => g.Name
}

// fileBase is the prefix of the generated files' names, as ANTLR's Go target
// names its files: the base name lowercased.
func fileBase(g g4.Grammar) string = strings.ToLower(baseName(g))

// isCombined reports whether g is a combined grammar (parser and lexer rules).
func isCombined(g g4.Grammar) bool = g.Kind match {
    case g4.Combined() => true
    case _ => false
}

// parserFileName and lexerFileName name the generated files: the antlr flavor's
// carry `_galop` so they can sit next to ANTLR's own; the native flavor's are
// named like ANTLR's.
func parserFileName(g g4.Grammar, f Flavor) string = fileBase(g) + infix(f) + "_parser.go"

func lexerFileName(g g4.Grammar, f Flavor) string = fileBase(g) + infix(f) + "_lexer.go"

func infix(f Flavor) string = f match {
    case ANTLRFlavor() => "_galop"
    case NativeFlavor(_) => ""
}

// FileNames lists the generated files: a parser for a grammar with parser
// rules, a lexer for one with lexer rules. An unknown flavor names none (the
// tool reports it before asking).
func (t goTarget) FileNames(g g4.Grammar, c atn.Compiled, opts codegen.Options) Array[string] = flavorOf(opts, g) match {
    case Some(f) => ArrayOf(c.Parser.Map((_) => parserFileName(g, f)), c.Lexer.Map((_) => lexerFileName(g, f))).Collect((name) => name)
    case None() => EmptyArray[string]()
}

// generateFlavor generates a flavor's parser, for a grammar with parser rules,
// and lexer, for one with lexer rules.
func generateFlavor(in codegen.Input, opts codegen.Options, version string, f Flavor) Either[Array[string], Array[codegen.OutputFile]] {
    val parser = flavorParserFile(in, opts, version, f)
    val name = lexerFileName(in.Grammar, f)
    val lexer = in.Compiled.Lexer match {
        case Some(_) => (f match {
            case ANTLRFlavor() => lexgen.GoLexerFile(in, opts, name, baseName(in.Grammar) + "GalopLexer")
            case NativeFlavor(x) => lexgen.NativeGoLexerFile(in, opts, name, x)
        }).Map((file) => ArrayOf(file))
        case None() => Right[Array[string], Array[codegen.OutputFile]](EmptyArray[codegen.OutputFile]())
    }
    parser match {
        case Right(p) => lexer.Map((l) => p.AppendAll(l))
        case Left(pe) => Left(pe.AppendAll(lexer.Fold((le) => le, (_) => EmptyArray[string]())))
    }
}

// flavorParserFile generates a flavor's parser, if the grammar has parser rules.
func flavorParserFile(in codegen.Input, opts codegen.Options, version string, f Flavor) Either[Array[string], Array[codegen.OutputFile]] {
    val compiled = in.Compiled
    val predicates = compiled.Rules.Exists((r) => r.Alts.Exists((a) => atn.HasStep(a.Steps, isPredicate)))
    if predicates {
        return Left(ArrayOf("Go target: semantic predicates are not supported yet"))
    }
    (compiled.Parser, in.Analysis) match {
        case (Some(parser), Some(an)) => {
            // ANTLR rewrites directly left-recursive rules into precedence loops
            // (the front end reports other left recursion as error 119); parsed
            // as written, they would call themselves forever.
            val lr = an.Repair.LeftRecursion
            if !lr.IsEmpty() {
                val names = lr.Direct.AppendAll(lr.Cycles.FlatMap((c) => c)).Distinct()
                    .Map((i) => compiled.Rules.Get(i).Name).MkString(", ")
                return Left(ArrayOf(s"Go target: left-recursive rules are not supported yet: $names"))
            }
            val grammar = in.Grammar.Name
            val base = baseName(in.Grammar)
            val e = env(
                names = Names(Grammar = grammar, Combined = isCombined(in.Grammar)),
                pfx = base + "Galop",
                parserType = base + "GalopParser",
                vocab = compiled.Vocab,
                parser = parser,
                rules = compiled.Rules,
                plans = an.Plans,
                adaptive = an.Plans.Exists((p) => analysis.NeedsRuntime(p.Lookahead)),
                repairPlan = an.Repair,
                brackets = an.Brackets,
                flavor = f,
                tokenLabels = HasTokenLabels(compiled.Rules),
            )
            val pkg = lexgen.PackageOf(opts)
            val file = grammar + ".g4"
            val code = f match {
                case NativeFlavor(_) => nativeParser(e, pkg, version, file, compiled.Lexer.IsEmpty(), in.Grammar.Channels)
                case ANTLRFlavor() => antlrParser(e, pkg, version, file)
            }
            Right(ArrayOf(codegen.OutputFile(parserFileName(in.Grammar, f), code)))
        }
        case _ => Right(EmptyArray[codegen.OutputFile]())
    }
}

func isPredicate(s atn.Step) bool = s match {
    case atn.CheckPredicate(_) => true
    case _ => false
}
