package golang

import (
    "strings"

    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"

    "github.com/martianoff/galop/g4"
)

// adaptiveGrammar needs runtime prediction (nesting deepens the contexts past
// the automaton's bound) and has an entry rule with EOF (s) and one without (r).
val adaptiveGrammar = `grammar A;
s : (a | b) EOF ;
r : a | b ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`

func TestGoTargetRejectsLeftRecursion(t T) T =
    generate("grammar L;\ns : e EOF ;\ne : e '+' e | X ;\nX : 'x' ;\n", EmptyArray[g4.OptionEntry]()) match {
        case Left(errs) => Eq(t, errs, ArrayOf("Go target: left-recursive rules are not supported yet: e"))
        case Right(_) => t.Error("expected an error")
    }

func TestRepairInANTLRFlavor(t T) T {
    val code = parserOf(generate(adaptiveGrammar, antlrDefines))
    val expected = ArrayOf(
        // Entry rules ending with EOF may repair; others rerun in LL mode.
        "ctx, err := p.parse(p.ruleS, 0, true)",
        "ctx, err := p.parse(p.ruleR, 2, false)",
        "ctx, err = p.llParse(rule, repair, err)",
        "func (p *AGalopParser) llParse(rule func(antlr.ParserRuleContext, int) antlr.ParserRuleContext, repair bool, sllErr error) (antlr.ParserRuleContext, error)",
        "return nil, dead.err",
        "se, ok := e.(*AGalopSyntaxError)",
        // Every SLL conflict goes through onConflict (precomputed automata settle
        // every input and have none), and LL prediction through the cache.
        "return p.onConflict(d, int(next.conflict))",
        "var AGalopFull = func() *AGalopFullCache {",
        "return p.predictLLUncached(d)",
        "\trp    AGalopRepair",
    )
    val t1 = expected.FoldLeft(t, (acc, s) => IsTrue(acc, strings.Contains(code, s)))
    IsFalse(t1, strings.Contains(code, "@"))
}

func TestRepairInNativeFlavor(t T) T {
    val code = nativeFiles(adaptiveGrammar).Get("a_parser.go").GetOrElse("")
    val expected = ArrayOf(
        "t, root, err := newAGalopParser(ts).run((*AGalopParser).ruleS, 0, true)",
        "t, root, err := newAGalopParser(ts).run((*AGalopParser).ruleR, 2, false)",
        // The exported entry point takes no repair flag and does not repair.
        "func AGalopParse(ts *ATokens, rule int) (*ATree, int32, error) {",
        "return newAGalopParser(ts).run(AGalopRuleFuncs[rule], AGalopRuleStartState[rule], false)",
        "var AGalopRuleFuncs = []func(*AGalopParser) int32{\n\t(*AGalopParser).ruleS,",
        "root, err = p.llParse(rule, repair, err)",
        "func (p *AGalopParser) llParse(rule func(*AGalopParser) int32, repair bool, sllErr error) (int32, error)",
        "return -1, dead.err",
        "se, ok := e.(*ASyntaxError)",
        "var AGalopFull = func() *AGalopFullCache {",
    )
    val t1 = expected.FoldLeft(t, (acc, s) => IsTrue(acc, strings.Contains(code, s)))
    IsFalse(t1, strings.Contains(code, "@"))
}

func TestStaticGrammarHasNoRepair(t T) T {
    // Without runtime prediction SLL and LL agree, so a failed parse is not
    // parsed again; only its error is replayed as ANTLR's.
    val code = parserFile(t)
    val t1 = IsFalse(t, strings.Contains(code, "p.llParse(rule, repair, err)"))
    IsTrue(t1, strings.Contains(code, "err = p.antlrError(start, err)"))
}

func TestGoTargetRejectsMutualLeftRecursion(t T) T =
    generate("grammar L;\ns : a EOF ;\na : b 'x' | 'y' ;\nb : a 'z' ;\n", EmptyArray[g4.OptionEntry]()) match {
        case Left(errs) => Eq(t, errs, ArrayOf("Go target: left-recursive rules are not supported yet: a, b"))
        case Right(_) => t.Error("expected an error")
    }

func TestEmbeddedActionsKeepTheLLRerun(t T) T {
    // A repair replays the parse, which would run the action more often than
    // ANTLR's two passes do; with an action the entries do not repair.
    val code = parserOf(generate(`grammar A;
s : (a | b) EOF {} ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`, antlrDefines))
    val t1 = IsTrue(t, strings.Contains(code, "ctx, err := p.parse(p.ruleS, 0, false)"))
    IsTrue(t1, strings.Contains(code, "ctx, err = p.llParse(rule, repair, err)"))
}

func TestErrorReplayInBothFlavors(t T) T {
    // A failed parse reports ANTLR's first error: both flavors replay ANTLR's
    // parse from the entry rule's start state, with the generated tables.
    val native = nativeFiles(adaptiveGrammar).Get("a_parser.go").GetOrElse("")
    val antlr = parserOf(generate(adaptiveGrammar, antlrDefines))
    val shared = ArrayOf(
        "err = p.antlrError(start, err)",
        "func (e *AGalopEmu) run(s int32) *AGalopEmuError {",
        "var AGalopDecisionLL1 = []bool{",
        "var AGalopTokenDisplay = []string{",
        "\"<INVALID>\", \"'('\", \"')'\", \"'x'\", \"'y'\",",
        "\tllBad bool",
    )
    val t1 = shared.FoldLeft(t, (acc, s) => IsTrue(IsTrue(acc, strings.Contains(native, s)), strings.Contains(antlr, s)))
    val t2 = IsTrue(t1, strings.Contains(native, "return &ASyntaxError{Line: int(t.Line), Column: int(t.Column), Msg: msg}"))
    IsTrue(t2, strings.Contains(antlr, "return p.input.GetTextFromTokens(p.toks[start], p.toks[stop])"))
}
