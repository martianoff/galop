package golang

import (
    "strings"

    . "martianoff/gala/collection_immutable"
    "martianoff/gala/go_builtins"
    . "martianoff/gala/test"

    "github.com/martianoff/galop/analysis"
    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/g4"
)

// adaptiveGrammar needs runtime prediction (nesting deepens the contexts past
// the automaton's bound) and has an entry rule with EOF (s) and one without (r).
val adaptiveGrammar = `grammar A;
s : (a | b) EOF ;
r : a | b ;
a : '(' a ')' | X ;
b : '(' b ')' | Y ;
X : 'x' ; Y : 'y' ;
`

// compiled reads, compiles and analyzes a valid test grammar.
func compiled(src string) Tuple[atn.Compiled, analysis.Analysis] = g4.Parse(src) match {
    case Right(g) => atn.Compile(g) match {
        case Right(c) => c.Parser match {
            case Some(p) => (c, analysis.Analyze(p, analysis.MaxK))
            case None() => go_builtins.Panic("no parser rules")
        }
        case Left(errs) => go_builtins.Panic(s"compile: ${errs.MkString("; ")}")
    }
    case Left(d) => go_builtins.Panic(s"parse: ${d.String()}")
}

func TestGoTargetRejectsLeftRecursion(t T) T =
    generate("grammar L;\ns : e EOF ;\ne : e '+' e | X ;\nX : 'x' ;\n", EmptyArray[g4.OptionEntry]()) match {
        case Left(errs) => Eq(t, errs, ArrayOf("Go target: left-recursive rules are not supported yet: e"))
        case Right(_) => t.Error("expected an error")
    }

func endsWithEOF(src string, rule string) bool {
    val (c, _) = compiled(src)
    c.Rules.Find((r) => r.Name == rule).Exists((r) => EndsWithEOF(c.Rules, r))
}

func TestEndsWithEOF(t T) T = RunCases(t, (sub, src, want) => Eq(sub, endsWithEOF(src, "s"), want),
    Case[string, bool](Name = "EOF last", Input = "grammar E;\ns : X+ EOF ;\nX : 'x' ;\n", Expected = true),
    Case[string, bool](Name = "every alternative", Input = "grammar E;\ns : X EOF | Y EOF ;\nX : 'x' ; Y : 'y' ;\n", Expected = true),
    Case[string, bool](Name = "a block of EOF endings", Input = "grammar E;\ns : X (Y EOF | EOF) ;\nX : 'x' ; Y : 'y' ;\n", Expected = true),
    Case[string, bool](Name = "an action after EOF", Input = "grammar E;\ns : X EOF {} ;\nX : 'x' ;\n", Expected = true),
    Case[string, bool](Name = "through the rule called last", Input = "grammar E;\ns : X b ;\nb : X EOF ;\nX : 'x' ;\n", Expected = true),
    Case[string, bool](Name = "a recursive call last", Input = "grammar E;\ns : X s | X ;\nX : 'x' ;\n", Expected = false),
    Case[string, bool](Name = "no EOF", Input = "grammar E;\ns : X ;\nX : 'x' ;\n", Expected = false),
    Case[string, bool](Name = "one alternative without", Input = "grammar E;\ns : X EOF | Y ;\nX : 'x' ; Y : 'y' ;\n", Expected = false),
    Case[string, bool](Name = "optional EOF", Input = "grammar E;\ns : X EOF? ;\nX : 'x' ;\n", Expected = false),
)

func TestRepairInANTLRFlavor(t T) T {
    val code = parserOf(generate(adaptiveGrammar, antlrDefines))
    val expected = ArrayOf(
        // Entry rules ending with EOF may repair; others rerun in LL mode.
        "ctx, err := p.parse(p.ruleS, true)",
        "ctx, err := p.parse(p.ruleR, false)",
        "ctx, err = p.llParse(rule, repair, err)",
        "func (p *AGalopParser) llParse(rule func(antlr.ParserRuleContext, int) antlr.ParserRuleContext, repair bool, sllErr error) (antlr.ParserRuleContext, error)",
        "return nil, dead.err",
        "se, ok := e.(*AGalopSyntaxError)",
        // Every SLL conflict goes through onConflict, and LL prediction through the cache.
        "return p.onConflict(d, int(next.conflict))",
        "var AGalopFull = AGalopNewFullCache()",
        "return p.predictLLUncached(d)",
        "\trp    AGalopRepair",
    )
    val t1 = expected.FoldLeft(t, (acc, s) => IsTrue(acc, strings.Contains(code, s)))
    IsFalse(t1, strings.Contains(code, "@"))
}

func TestRepairInNativeFlavor(t T) T {
    val code = nativeFiles(adaptiveGrammar).Get("a_parser.go").GetOrElse("")
    val expected = ArrayOf(
        "t, root, err := newAGalopParser(ts).run((*AGalopParser).ruleS, true)",
        "t, root, err := newAGalopParser(ts).run((*AGalopParser).ruleR, false)",
        // The exported entry point takes no repair flag and does not repair.
        "func AGalopParse(ts *ATokens, rule func(*AGalopParser) int32) (*ATree, int32, error) {\n\treturn newAGalopParser(ts).run(rule, false)",
        "root, err = p.llParse(rule, repair, err)",
        "func (p *AGalopParser) llParse(rule func(*AGalopParser) int32, repair bool, sllErr error) (int32, error)",
        "return -1, dead.err",
        "se, ok := e.(*ASyntaxError)",
        "var AGalopFull = AGalopNewFullCache()",
    )
    val t1 = expected.FoldLeft(t, (acc, s) => IsTrue(acc, strings.Contains(code, s)))
    IsFalse(t1, strings.Contains(code, "@"))
}

func TestStaticGrammarHasNoRepair(t T) T {
    // Without runtime prediction there are no conflicts to repair.
    val code = parserFile(t)
    val t1 = IsFalse(t, strings.Contains(code, ") llParse("))
    IsFalse(t1, strings.Contains(code, "FullCache struct"))
}

func repairable(src string) bool {
    val (c, _) = compiled(src)
    c.Rules.Find((r) => r.Name == "s").Exists((r) => Repairable(c.Rules, r))
}

func TestRepairable(t T) T = RunCases(t, (sub, src, want) => Eq(sub, repairable(src), want),
    Case[string, bool](Name = "recursion below the entry rule", Input = "grammar R;\ns : e EOF ;\ne : '(' e ')' | X ;\nX : 'x' ;\n", Expected = true),
    Case[string, bool](Name = "an entry rule that calls itself", Input = "grammar R;\ns : '(' s ')' EOF | X EOF ;\nX : 'x' ;\n", Expected = false),
    Case[string, bool](Name = "through another rule", Input = "grammar R;\ns : e EOF ;\ne : '(' s ')' | X ;\nX : 'x' ;\n", Expected = false),
    Case[string, bool](Name = "no EOF", Input = "grammar R;\ns : e ;\ne : X ;\nX : 'x' ;\n", Expected = false),
)
