package golang

import (
    "strconv"
    "strings"

    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/concurrent"

    "github.com/martianoff/galop/atn"
    "github.com/martianoff/galop/lexgen"
)

// The `native` flavor's parser: galop's own tree, no ANTLR dependency.
//
// A parse produces one Tree: the tokens, a flat array of Nodes (rule,
// labeled alternative, child range, token span) and the child references,
// each an int32 (a node index, or a negated token index). Typed handles, one
// per rule and labeled alternative, wrap a node index and offer the accessors
// ANTLR's context types offer (`n.Expression()`, `n.AllExpression()`,
// `n.IDENTIFIER()`, `n.GetGuard()`), so code written against ANTLR's trees
// ports by renaming. Parsing decides exactly as the `antlr` flavor does: the
// same decision functions and runtime predictor, SLL first and, on a
// syntax error, ANTLR's LL result (repaired or rerun).

// nativeParser emits `<grammar>_parser.go` of the native flavor. withTokens
// adds the token runtime, for a grammar without lexer rules (otherwise the
// lexer file has it).
func nativeParser(e env, pkg string, version string, grammarFile string, withTokens bool, channels Array[string]) string {
    val ruleCode = e.rules.Map((r) => Future(emitNativeRule(e, r))).Map(_.Get())
    val decisionCode = e.plans.Map((plan) => Future(emitDecision(e, plan))).Map(_.Get())
    val handles = e.rules.Map((r) => Future(nativeHandles(e, r))).Map(_.Get())
    // strconv is for the token runtime's error text, when this file carries it.
    val imports = ArrayOf(
        if (e.adaptive) ArrayOf("encoding/binary", "slices") else EmptyArray[string](),
        if (withTokens) ArrayOf("strconv") else EmptyArray[string](),
        ArrayOf("strings", "sync"),
        if (e.adaptive) ArrayOf("sync/atomic") else EmptyArray[string](),
    ).FlatMap((group) => group)
    val tokens = if (withTokens) ArrayOf(lexgen.NativeTokenRuntime(e.vocab, channels, e.exported(), e.names.Grammar)) else EmptyArray[string]()
    val parts = ArrayOf(
        s"// Code generated by galop $version from $grammarFile. DO NOT EDIT.\n",
        s"package $pkg\n",
        "import (\n" + imports.Map((i) => "\t\"" + i + "\"").MkString("\n") + "\n)\n",
    ).AppendAll(tokens).AppendAll(ArrayOf(
        nativeRuleConstants(e),
        fill(nativeTreeTemplate, "@X@", e.exported(), "PFX", e.pfx),
        strings.TrimSuffix(handles.MkString(""), "\n"),
        e.rules.Map((r) => nativeEntry(e, r)).MkString("\n"),
        nativeParserCore(e),
        ruleCode.MkString("\n"),
        decisionCode.MkString("\n"),
    ))
    val runtime = if (e.adaptive) ArrayOf(tables(e), predictor(e)) else EmptyArray[string]()
    parts.AppendAll(runtime).Filter(_ != "").MkString("\n")
}

// nativeRuleConstants are the rule indexes, ANTLR's numbering, and the names
// of the rules and their labeled alternatives.
func nativeRuleConstants(e env) string {
    val x = e.exported()
    val consts = e.rules.Map((r) => lexgen.ConstLine(s"${x}RULE_${r.Name}", s"${r.Index}", ""))
    val alts = e.rules.Map((r) => altLabelsOf(r) match {
        case Array() => "\tnil,"
        case labels => "\t{\"\", " + labels.Map((l) => strconv.Quote(l)).MkString(", ") + "},"
    })
    s"// ${x}RULE_${e.rules.Head().Name} and the constants below are the rules' indexes, as ANTLR numbers them.\n" +
        lexgen.GoConstBlock(consts) + "\n" +
        lexgen.GoStrings(s"${x}RuleNames", e.rules.Map(_.Name), "are the rules' names, by index.") + "\n" +
        s"// ${x}AltNames are the labels of each rule's labeled alternatives, by rule\n" +
        "// index and then by a node's Alt (so entry 0 is empty); nil for a rule without labels.\n" +
        s"var ${x}AltNames = [][]string{\n" + alts.MkString("\n") + "\n}\n"
}

// altLabelsOf are the labels of a rule's labeled alternatives; a node's Alt is
// a label's position here plus one.
func altLabelsOf(r atn.RuleIR) Array[string] = r.Alts.Collect((a) => a.Label).Distinct()

// nativeEntry is the public function that parses tokens as one rule.
func nativeEntry(e env, r atn.RuleIR) string = fill(`// ParseMETHOD parses the tokens of ts as RULE, from the first token, and
// returns the tree's root. On a syntax error it returns the error and no tree.
// The parse stops after the input RULE matches; Tree().Next is the index of
// the token after it.
func ParseMETHOD(ts *@X@Tokens) (HANDLE, error) {
	t, root, err := newPARSER(ts).run((*PARSER).RULEFUNC, REPAIR)
	if err != nil {
		return HANDLE{}, err
	}
	return HANDLE{@X@NodeRef{t, root}}, nil
}
`, "METHOD", nativeName(e.names.RuleMethod(r.Name)), "RULEFUNC", e.ruleFunc(r.Index), "RULE", r.Name,
    "HANDLE", nodeType(r.Name), "PARSER", e.parserType, "PFX", e.pfx, "@X@", e.exported(),
    "REPAIR", s"${e.repair && Repairable(e.rules, r)}")

// nodeType is the handle type of a rule or labeled alternative: `CaseClauseNode`.
func nodeType(ruleOrLabel string) string = capitalize(ruleOrLabel) + "Node"

// nativeReserved are the methods every handle has; an accessor whose name
// would clash with one gets a trailing underscore.
val nativeReserved = ArrayOf(
    "Ok", "Tree", "Index", "Rule", "Alt", "Start", "Stop", "StartIndex", "StopIndex", "GetText",
    "SourceText", "ChildCount", "Child", "Parent", "Token", "Tokens", "HiddenBefore", "Walk", "ToStringTree",
)

// nativeName escapes a method name that clashes with a handle's own methods.
func nativeName(name string) string = if (nativeReserved.Contains(name)) name + "_" else name

// emitNativeRule emits the function that parses one rule into the tree. A
// labeled alternative records which one it is in the node.
func emitNativeRule(e env, r atn.RuleIR) string {
    val altLabels = altLabelsOf(r)
    val labeled = altLabels.NonEmpty()
    val sc = scope(Labels = ruleLabels(r))
    val vars = if (labeled) "\tmark, start, alt := len(p.kids), p.pos, uint8(0)" else "\tmark, start := len(p.kids), p.pos"
    val altArg = if (labeled) "alt" else "0"
    val labMark = if (e.tokenLabels) ArrayOf("\tlabs := len(p.labs)") else EmptyArray[string]()
    val finish = if (e.tokenLabels) s"\treturn p.finishLabeled(${r.Index}, $altArg, start, mark, labs)" else s"\treturn p.finish(${r.Index}, $altArg, start, mark)"
    val header = ArrayOf(s"func (p *${e.parserType}) ${e.ruleFunc(r.Index)}() int32 {", vars).AppendAll(labMark)
    val body = ruleBody(e, r, (alt, ind) => alt.Label match {
        case Some(l) => ArrayOf(s"${ind}alt = ${altLabels.IndexOf(l) + 1}").AppendAll(emitSteps(e, alt.Steps, ind, sc))
        case None() => emitSteps(e, alt.Steps, ind, sc)
    })
    header.AppendAll(body).AppendAll(ArrayOf(finish, "}")).MkString("\n") + "\n"
}

// labelUse is one label of a rule: its name, whether it collects a list
// (`xs+=e`), and what it stores, a rule's node or a token.
struct labelUse(Name string, Append bool, Rule Option[int])

// labelUses lists the labels in steps, in order of appearance.
func labelUses(steps Array[atn.Step]) Array[labelUse] = steps.FlatMap((s) => s match {
    case atn.MatchToken(_, Some(l)) => ArrayOf(labelUse(l.Name, l.Append, None()))
    case atn.MatchSet(_, Some(l), _) => ArrayOf(labelUse(l.Name, l.Append, None()))
    case atn.CallRule(rule, _, Some(l)) => ArrayOf(labelUse(l.Name, l.Append, Some(rule)))
    case atn.Choose(_, alts, _) => alts.FlatMap(labelUses)
    case atn.Loop(_, _, _, body) => labelUses(body)
    case _ => EmptyArray[labelUse]()
})

// ruleLabels are the distinct label names of a rule; a label's number is its
// position here plus one.
func ruleLabels(r atn.RuleIR) Array[string] = r.Alts.FlatMap((a) => labelUses(a.Steps)).Map(_.Name).Distinct()

// HasTokenLabels reports whether any rule labels a token, which the native
// parser then records in the tree.
func HasTokenLabels(rules Array[atn.RuleIR]) bool = rules.Exists((r) => r.Alts.Exists((a) => labelUses(a.Steps).Exists(_.Rule.IsEmpty())))

// elemRef is an element an accessor reaches: a rule (IsRule) or a token type.
struct elemRef(IsRule bool, Id int)

// occurrences lists the rules and named tokens steps reference, each as many
// times as it can occur in one match, but at most twice: twice means a list
// accessor (ANTLR's `AllX()`).
func occurrences(e env, steps Array[atn.Step]) Array[elemRef] =
    steps.FoldLeft(EmptyArray[elemRef](), (acc, s) => capTwice(acc.AppendAll(stepOccurrences(e, s))))

func stepOccurrences(e env, s atn.Step) Array[elemRef] = s match {
    case atn.MatchToken(t, _) => namedToken(e, t)
    // ANTLR has getters for the tokens a set lists, `(A | B)`, but none for `~A` or `.`.
    case atn.MatchSet(set, _, listed) => if (listed) set.Values().FlatMap((t) => namedToken(e, t)) else EmptyArray[elemRef]()
    case atn.CallRule(rule, _, _) => ArrayOf(elemRef(true, rule))
    case atn.Choose(_, alts, _) => {
        val each = alts.Map((a) => occurrences(e, a))
        each.FlatMap((o) => o).Distinct().FlatMap((el) => {
            val most = each.FoldLeft(0, (m, o) => { val c = o.Count(_ == el); if (c > m) c else m })
            ArrayFill(most, el)
        })
    }
    case atn.Loop(_, _, _, body) => {
        val once = occurrences(e, body)
        capTwice(once.AppendAll(once))
    }
    case _ => EmptyArray[elemRef]()
}

// namedToken is t as an accessor element, unless it is an implicit literal
// token (`T__3`), which, as in ANTLR, has no accessor.
func namedToken(e env, t int) Array[elemRef] =
    if (t != atn.TokenEOF && e.vocab.Implicit.Get(t)) EmptyArray[elemRef]() else ArrayOf(elemRef(false, t))

// capTwice keeps at most two copies of each element.
func capTwice(refs Array[elemRef]) Array[elemRef] = refs.ZipWithIndex().Collect((ri) =>
    if (refs.Take(ri.V2).Count(_ == ri.V1) < 2) Some(ri.V1) else None[elemRef]()
)

// nativeHandles emits a rule's handle type and accessors, and those of its
// labeled alternatives.
func nativeHandles(e env, r atn.RuleIR) string {
    val x = e.exported()
    val altLabels = altLabelsOf(r)
    val labels = ruleLabels(r)
    val ruleType = nodeType(r.Name)
    val doc = s"// $ruleType is a node of rule ${r.Name}, or no node when !Ok().\ntype $ruleType struct{ ${x}NodeRef }\n\n"
    altLabels match {
        case Array() => doc + accessors(e, ruleType, ArrayOf(atn.Choose(-1, r.Alts.Map(_.Steps), None())), labels)
        case _ => {
            val casts = altLabels.ZipWithIndex().Map((li) => {
                val t = nodeType(li.V1)
                s"// As${capitalize(li.V1)} is the node as its ${li.V1} alternative, and whether it is that one.\n" +
                    s"func (n $ruleType) As${capitalize(li.V1)}() ($t, bool) {\n\treturn $t{n.${x}NodeRef}, n.Ok() && n.Alt() == ${li.V2 + 1}\n}\n\n"
            })
            val alts = altLabels.Map((l) => {
                val t = nodeType(l)
                val steps = ArrayOf(atn.Choose(-1, r.Alts.Filter(_.Label == Some(l)).Map(_.Steps), None()))
                s"// $t is rule ${r.Name}'s labeled alternative $l.\ntype $t struct{ ${x}NodeRef }\n\n" + accessors(e, t, steps, labels)
            })
            doc + casts.MkString("") + alts.MkString("")
        }
    }
}

// accessors emits the accessors of handle type t for the elements and labels
// of steps (one Choose of the alternatives it covers).
func accessors(e env, t string, steps Array[atn.Step], labels Array[string]) string {
    val refs = occurrences(e, steps)
    val elems = refs.Distinct().Map((el) =>
        if (el.IsRule) ruleAccessor(e, t, e.ruleName(el.Id), refs.Count(_ == el) > 1)
        else tokenAccessor(e, t, el.Id, refs.Count(_ == el) > 1)
    )
    val uses = labelUses(steps)
    val labelGetters = uses.Map(_.Name).Distinct().Map((name) => {
        val same = uses.Filter(_.Name == name)
        labelAccessor(e, t, same.Head(), same.Exists(_.Append), labels.IndexOf(name) + 1)
    })
    elems.AppendAll(labelGetters).MkString("")
}

// ruleAccessor emits ANTLR's getters for a rule: `X()` when it occurs at most
// once, `AllX()` and `X(i)` when it may occur more often.
func ruleAccessor(e env, t string, rule string, many bool) string {
    val name = nativeName(e.names.RuleMethod(rule))
    val h = nodeType(rule)
    val rc = s"${e.exported()}RULE_$rule"
    if (many)
        s"// All$name is n's $h children.\nfunc (n $t) All$name() []$h {\n\treturn ${e.pfx}Children[$h](n.${e.exported()}NodeRef, $rc)\n}\n\n" +
            s"// $name is n's i-th $h child, or no node.\nfunc (n $t) $name(i int) $h {\n\treturn $h{n.child($rc, i)}\n}\n\n"
    else
        s"// $name is n's $h child, or no node.\nfunc (n $t) $name() $h {\n\treturn $h{n.child($rc, 0)}\n}\n\n"
}

// tokenAccessor emits ANTLR's getters for a token, as ruleAccessor does for a rule.
func tokenAccessor(e env, t string, token int, many bool) string {
    val name = nativeName(e.vocab.Name(token))
    val tc = e.tokenRef(token)
    val term = e.exported() + "Terminal"
    if (many)
        s"// All$name is n's $name tokens.\nfunc (n $t) All$name() []$term {\n\treturn n.Tokens($tc)\n}\n\n" +
            s"// $name is n's i-th $name token, or no token.\nfunc (n $t) $name(i int) $term {\n\treturn n.tokenAt($tc, i)\n}\n\n"
    else
        s"// $name is n's $name token, or no token.\nfunc (n $t) $name() $term {\n\treturn n.Token($tc)\n}\n\n"
}

// labelAccessor emits ANTLR's label getter, `GetGuard()`: the node or token
// stored under the label, or all of them for a list label.
func labelAccessor(e env, t string, lu labelUse, list bool, id int) string {
    val name = nativeName("Get" + capitalize(lu.Name))
    val term = e.exported() + "Terminal"
    lu.Rule match {
        case Some(rule) => {
            val h = nodeType(e.ruleName(rule))
            if (list) s"// $name is the nodes stored under label ${lu.Name}.\nfunc (n $t) $name() []$h {\n\treturn ${e.pfx}Labeled[$h](n.${e.exported()}NodeRef, $id)\n}\n\n"
            else s"// $name is the node stored under label ${lu.Name}, or no node.\nfunc (n $t) $name() $h {\n\treturn $h{n.firstLabeled($id)}\n}\n\n"
        }
        case None() =>
            if (list) s"// $name is the tokens stored under label ${lu.Name}.\nfunc (n $t) $name() []$term {\n\treturn n.labeledTokens($id)\n}\n\n"
            else s"// $name is the token stored under label ${lu.Name}, or no token.\nfunc (n $t) $name() $term {\n\treturn n.firstLabeledToken($id)\n}\n\n"
    }
}

// nativeParserCore is the parser state and the helpers the rule functions use.
func nativeParserCore(e env) string {
    val predictor = predictorFields(e)
    val absMatch = bracketMatchLine(e)
    val labs = if (e.tokenLabels) "\n\tlabs  []int32" else ""
    val retry = retryCode(e, "root")
    val resetStack = if (e.adaptive) "\n\tp.stack = p.stack[:0]\n\tp.rp.seen = 0" else ""
    val resetLabs = if (e.tokenLabels) "\n\tp.labs = p.labs[:0]\n\tp.tree.TokenLabels = p.tree.TokenLabels[:0]" else ""
    // The helpers go in through one placeholder, and fill does not rescan
    // what it inserts, so their own placeholders are filled first.
    val labelHelpers = if (e.tokenLabels) fill(nativeLabelHelpers, "PARSER", e.parserType, "@X@", e.exported()) else ""
    fill(nativeCoreTemplate, "PREDICTOR", predictor, "ABSMATCH", absMatch, "GROUPON", groupsOn(e), "LABS", labs, "RETRY", retry, "RESETSTACK", resetStack,
        "RESETLABS", resetLabs, "LABELHELPERS", labelHelpers, "PARSER", e.parserType, "PFX", e.pfx, "@X@", e.exported())
}

val nativeLabelHelpers = `
// labelToken records that token tok is stored under label in the rule
// being parsed; finishLabeled moves the records to the tree.
func (p *PARSER) labelToken(label int32, tok int32) {
	p.labs = append(p.labs, label, tok)
}

func (p *PARSER) finishLabeled(rule int, alt uint8, start, mark, labs int) int32 {
	id := p.finish(rule, alt, start, mark)
	for i := labs; i < len(p.labs); i += 2 {
		p.tree.TokenLabels = append(p.tree.TokenLabels, @X@TokenLabel{Node: id, Token: p.labs[i+1], Label: uint8(p.labs[i])})
	}
	p.labs = p.labs[:labs]
	return id
}
`

val nativeCoreTemplate = `// PARSER is the state of one parse.
type PARSER struct {
	ts    *@X@Tokens
	types []int32
	pos   int
	kids  []int32
	tree  *@X@TreeLABSPREDICTOR
}

// PFXParse parses the tokens of ts with rule, SLL first and LL on a syntax
// error, as the antlr flavor does.
func PFXParse(ts *@X@Tokens, rule func(*PARSER) int32) (*@X@Tree, int32, error) {
	return newPARSER(ts).run(rule, false)
}

// newPARSER prepares a parse of the tokens of ts.
func newPARSER(ts *@X@Tokens) *PARSER {
	n := len(ts.Tokens)
	p := &PARSER{ts: ts, types: make([]int32, n)}
	for i := range ts.Tokens {
		p.types[i] = ts.Tokens[i].Type
	}ABSMATCH
	// Grammars like GALA's have about four nodes and five child references
	// per token; sizing for that saves growing the arrays.
	p.tree = &@X@Tree{@X@Tokens: ts, Nodes: make([]@X@NodeData, 0, 4*n+4), Kids: make([]int32, 0, 5*n+4)}
	return p
}

// run parses with rule; repair says whether a failed SLL parse may be
// repaired rather than rerun in LL mode (see llParse).
func (p *PARSER) run(rule func(*PARSER) int32, repair bool) (*@X@Tree, int32, error) {GROUPON
	root, err := p.attempt(rule)RETRY
	if err != nil {
		return nil, -1, err
	}
	p.tree.Next = p.pos
	return p.tree, root, nil
}

// attempt parses once from the first token; a syntax error is returned, not panicked.
func (p *PARSER) attempt(rule func(*PARSER) int32) (root int32, err error) {
	p.pos = 0
	p.kids = p.kids[:0]
	p.tree.Nodes = p.tree.Nodes[:0]
	p.tree.Kids = p.tree.Kids[:0]RESETSTACKRESETLABS
	defer func() {
		if r := recover(); r != nil {
			se, ok := r.(*@X@SyntaxError)
			if !ok {
				panic(r)
			}
			root, err = -1, se
		}
	}()
	return rule(p), nil
}

func (p *PARSER) la(i int) int32 {
	j := p.pos + i - 1
	if j >= len(p.types) {
		j = len(p.types) - 1
	}
	return p.types[j]
}

// finish adds the node of a rule that started at token start and whose
// children are p.kids[mark:], and returns its index.
func (p *PARSER) finish(rule int, alt uint8, start, mark int) int32 {
	t := p.tree
	off := len(t.Kids)
	t.Kids = append(t.Kids, p.kids[mark:]...)
	p.kids = p.kids[:mark]
	t.Nodes = append(t.Nodes, @X@NodeData{Rule: uint16(rule), Alt: alt, Kids: int32(off), NKids: int32(len(t.Kids) - off), Start: int32(start), Stop: int32(p.pos - 1)})
	return int32(len(t.Nodes) - 1)
}

// consume adds the current token to the rule being parsed and moves past it;
// EOF is added but not passed.
func (p *PARSER) consume() int32 {
	i := p.pos
	p.kids = append(p.kids, int32(-i-1))
	if p.types[i] != @X@EOF {
		p.pos++
	}
	return int32(i)
}

func (p *PARSER) match(ttype int32) int32 {
	if p.types[p.pos] != ttype {
		p.fail("mismatched input ")
	}
	return p.consume()
}

func (p *PARSER) matchIf(ok bool) int32 {
	if !ok {
		p.fail("mismatched input ")
	}
	return p.consume()
}

func (p *PARSER) noViableAlt(decision int) {
	p.fail("no viable alternative at input ")
}

// fail stops the parse at the current token with ANTLR's message.
func (p *PARSER) fail(msg string) {
	tok := p.ts.Tokens[p.pos]
	text := "<EOF>"
	if tok.Type != @X@EOF {
		text = "'" + tok.Text(p.ts.Src) + "'"
	}
	panic(&@X@SyntaxError{Line: int(tok.Line), Column: int(tok.Column), Msg: msg + text})
}
LABELHELPERS`

// nativeTreeTemplate is the tree runtime: nodes, the tree, and the handle
// types every rule's handle builds on.
val nativeTreeTemplate = `// @X@NodeData is one node of a parse tree: its rule, which labeled alternative
// it is (from 1; 0 when the rule's alternatives have no labels), the label it
// is stored under in its parent (from 1, in the order the parent rule's labels
// first appear; 0 for none), its children Kids[Kids : Kids+NKids] of the tree,
// and the tokens it spans, Tokens[Start..Stop] (Stop is Start-1 when it spans
// none).
type @X@NodeData struct {
	Rule        uint16
	Alt         uint8
	Label       uint8
	Kids, NKids int32
	Start, Stop int32
}

// @X@TokenLabel records that token Token is stored under label Label (see
// @X@NodeData) of node Node.
type @X@TokenLabel struct {
	Node, Token int32
	Label       uint8
}

// @X@Tree is a parse: the tokens, every node (children before their parent,
// so the root is last) and the child references, where k >= 0 is Nodes[k] and
// k < 0 is Tokens[-k-1]. Next is the index of the token after the parsed input.
type @X@Tree struct {
	*@X@Tokens
	Nodes       []@X@NodeData
	Kids        []int32
	TokenLabels []@X@TokenLabel
	Next        int
	parents     []int32
	parentsOnce sync.Once
}

// @X@NodeRef is a node of a tree, or no node: the zero value, or a missing
// child. Every rule's handle type embeds it.
type @X@NodeRef struct {
	t *@X@Tree
	i int32
}

// Ok reports whether n is a node.
func (n @X@NodeRef) Ok() bool { return n.t != nil && n.i >= 0 }

// Tree is the tree n belongs to.
func (n @X@NodeRef) Tree() *@X@Tree { return n.t }

// Index is n's index in Tree().Nodes.
func (n @X@NodeRef) Index() int { return int(n.i) }

// Rule is the index of n's rule (see the RULE_ constants).
func (n @X@NodeRef) Rule() int { return int(n.t.Nodes[n.i].Rule) }

// Alt is which labeled alternative n is (from 1), or 0.
func (n @X@NodeRef) Alt() int { return int(n.t.Nodes[n.i].Alt) }

// StartIndex and StopIndex are the indexes of n's first and last tokens; for
// a node that spans no token, StopIndex is StartIndex-1.
func (n @X@NodeRef) StartIndex() int { return int(n.t.Nodes[n.i].Start) }

func (n @X@NodeRef) StopIndex() int { return int(n.t.Nodes[n.i].Stop) }

// Start is n's first token (the next token, for a node that spans none).
func (n @X@NodeRef) Start() @X@Token { return n.t.Tokens[n.t.Nodes[n.i].Start] }

// Stop is n's last token (the token before Start, for a node that spans none;
// the zero token when there is none).
func (n @X@NodeRef) Stop() @X@Token {
	if s := n.t.Nodes[n.i].Stop; s >= 0 {
		return n.t.Tokens[s]
	}
	return @X@Token{}
}

// GetText is the text of n's tokens run together, as ANTLR's GetText gives
// it ("<EOF>" for an EOF child).
func (n @X@NodeRef) GetText() string {
	nd := n.t.Nodes[n.i]
	var b strings.Builder
	if nd.Stop >= nd.Start {
		b.Grow(int(n.t.Tokens[nd.Stop].End - n.t.Tokens[nd.Start].Start))
	}
	n.writeText(&b)
	return b.String()
}

// writeText writes the text of n's tokens, its EOF child included, as ANTLR
// writes its children's text.
func (n @X@NodeRef) writeText(b *strings.Builder) {
	for _, k := range n.kids() {
		if k >= 0 {
			@X@NodeRef{n.t, k}.writeText(b)
		} else {
			b.WriteString(n.t.Text(int(-k - 1)))
		}
	}
}

// SourceText is the source from n's first token through its last, with
// whatever lies between them.
func (n @X@NodeRef) SourceText() string {
	nd := n.t.Nodes[n.i]
	if nd.Stop < nd.Start {
		return ""
	}
	return n.t.Src[n.t.Tokens[nd.Start].Start:n.t.Tokens[nd.Stop].End]
}

// HiddenBefore is the off-channel tokens just before n's first token: the
// comments in front of n.
func (n @X@NodeRef) HiddenBefore() []@X@HiddenToken { return n.t.HiddenBefore(n.StartIndex()) }

// ChildCount is the number of n's children, nodes and tokens.
func (n @X@NodeRef) ChildCount() int { return int(n.t.Nodes[n.i].NKids) }

// Child is n's i-th child.
func (n @X@NodeRef) Child(i int) @X@Child {
	return @X@Child{n.t, n.t.Kids[int(n.t.Nodes[n.i].Kids)+i]}
}

// Parent is the node n is a child of, or no node for the root. The first
// call on a tree indexes every node's parent, once, safely from any goroutine.
func (n @X@NodeRef) Parent() @X@NodeRef {
	t := n.t
	t.parentsOnce.Do(func() {
		t.parents = make([]int32, len(t.Nodes))
		for i := range t.parents {
			t.parents[i] = -1
		}
		for i, nd := range t.Nodes {
			for _, k := range t.Kids[nd.Kids : nd.Kids+nd.NKids] {
				if k >= 0 {
					t.parents[k] = int32(i)
				}
			}
		}
	})
	return @X@NodeRef{t, t.parents[n.i]}
}

// Token is n's first child token of type ttype, or no token.
func (n @X@NodeRef) Token(ttype int32) @X@Terminal { return n.tokenAt(ttype, 0) }

// Tokens is n's child tokens of type ttype.
func (n @X@NodeRef) Tokens(ttype int32) []@X@Terminal {
	if !n.Ok() {
		return nil
	}
	count := 0
	for _, k := range n.kids() {
		if k < 0 && n.t.Tokens[-k-1].Type == ttype {
			count++
		}
	}
	out := make([]@X@Terminal, 0, count)
	for _, k := range n.kids() {
		if k < 0 && n.t.Tokens[-k-1].Type == ttype {
			out = append(out, @X@Terminal{n.t, -k - 1})
		}
	}
	return out
}

// Walk calls visit on n and its descendant nodes, parents before children;
// when visit returns false, the node's children are skipped.
func (n @X@NodeRef) Walk(visit func(@X@NodeRef) bool) {
	if !visit(n) {
		return
	}
	for _, k := range n.kids() {
		if k >= 0 {
			@X@NodeRef{n.t, k}.Walk(visit)
		}
	}
}

// ToStringTree prints n's subtree the way ANTLR's ToStringTree does:
// (rule child child ...), with token text and rule names.
func (n @X@NodeRef) ToStringTree() string {
	var b strings.Builder
	n.writeTree(&b)
	return b.String()
}

func (n @X@NodeRef) writeTree(b *strings.Builder) {
	name := @X@RuleNames[n.Rule()]
	if n.ChildCount() == 0 {
		b.WriteString(name)
		return
	}
	b.WriteString("(")
	b.WriteString(name)
	for _, k := range n.kids() {
		b.WriteString(" ")
		if k >= 0 {
			@X@NodeRef{n.t, k}.writeTree(b)
		} else {
			b.WriteString(@X@EscapeWhitespace(n.t.Text(int(-k - 1))))
		}
	}
	b.WriteString(")")
}

// @X@EscapeWhitespace writes tabs, newlines and carriage returns as \t, \n
// and \r, as ANTLR's tree printer does.
func @X@EscapeWhitespace(s string) string {
	if !strings.ContainsAny(s, "\t\n\r") {
		return s
	}
	return PFXWhitespace.Replace(s)
}

// PFXWhitespace is the replacer behind @X@EscapeWhitespace.
var PFXWhitespace = strings.NewReplacer("\t", "\\t", "\n", "\\n", "\r", "\\r")

func (n @X@NodeRef) kids() []int32 {
	nd := n.t.Nodes[n.i]
	return n.t.Kids[nd.Kids : nd.Kids+nd.NKids]
}

// child is n's k-th child node of rule, or no node.
func (n @X@NodeRef) child(rule uint16, k int) @X@NodeRef {
	if n.Ok() {
		for _, c := range n.kids() {
			if c >= 0 && n.t.Nodes[c].Rule == rule {
				if k == 0 {
					return @X@NodeRef{n.t, c}
				}
				k--
			}
		}
	}
	return @X@NodeRef{n.t, -1}
}

// PFXChildren is n's child nodes of rule, as handles of type H.
func PFXChildren[H ~struct{ @X@NodeRef }](n @X@NodeRef, rule uint16) []H {
	return PFXKidsWhere[H](n, func(c @X@NodeData) bool { return c.Rule == rule })
}

// PFXLabeled is n's child nodes stored under label, as handles of type H.
func PFXLabeled[H ~struct{ @X@NodeRef }](n @X@NodeRef, label uint8) []H {
	return PFXKidsWhere[H](n, func(c @X@NodeData) bool { return c.Label == label })
}

// PFXKidsWhere is n's child nodes that keep holds for, as handles of type H.
func PFXKidsWhere[H ~struct{ @X@NodeRef }](n @X@NodeRef, keep func(@X@NodeData) bool) []H {
	if !n.Ok() {
		return nil
	}
	count := 0
	for _, c := range n.kids() {
		if c >= 0 && keep(n.t.Nodes[c]) {
			count++
		}
	}
	out := make([]H, 0, count)
	for _, c := range n.kids() {
		if c >= 0 && keep(n.t.Nodes[c]) {
			out = append(out, H(struct{ @X@NodeRef }{@X@NodeRef{n.t, c}}))
		}
	}
	return out
}

// tokenAt is n's k-th child token of type ttype, or no token.
func (n @X@NodeRef) tokenAt(ttype int32, k int) @X@Terminal {
	if n.Ok() {
		for _, c := range n.kids() {
			if c < 0 && n.t.Tokens[-c-1].Type == ttype {
				if k == 0 {
					return @X@Terminal{n.t, -c - 1}
				}
				k--
			}
		}
	}
	return @X@Terminal{n.t, -1}
}

// firstLabeled is n's first child node stored under label, or no node.
func (n @X@NodeRef) firstLabeled(label uint8) @X@NodeRef {
	if n.Ok() {
		for _, c := range n.kids() {
			if c >= 0 && n.t.Nodes[c].Label == label {
				return @X@NodeRef{n.t, c}
			}
		}
	}
	return @X@NodeRef{n.t, -1}
}

// labeledTokens is n's tokens stored under label. TokenLabels is in node
// order, so n's records are found by binary search.
func (n @X@NodeRef) labeledTokens(label uint8) []@X@Terminal {
	var out []@X@Terminal
	if n.Ok() {
		labels := n.t.TokenLabels
		lo, hi := 0, len(labels)
		for lo < hi {
			mid := int(uint(lo+hi) >> 1)
			if labels[mid].Node < n.i {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		for ; lo < len(labels) && labels[lo].Node == n.i; lo++ {
			if labels[lo].Label == label {
				out = append(out, @X@Terminal{n.t, labels[lo].Token})
			}
		}
	}
	return out
}

// firstLabeledToken is n's first token stored under label, or no token.
func (n @X@NodeRef) firstLabeledToken(label uint8) @X@Terminal {
	if toks := n.labeledTokens(label); len(toks) > 0 {
		return toks[0]
	}
	return @X@Terminal{n.t, -1}
}

// @X@Terminal is a token of a tree, or no token.
type @X@Terminal struct {
	t *@X@Tree
	i int32
}

// Ok reports whether the terminal is a token.
func (t @X@Terminal) Ok() bool { return t.t != nil && t.i >= 0 }

// Index is the token's index in Tree().Tokens.
func (t @X@Terminal) Index() int { return int(t.i) }

// Token is the token.
func (t @X@Terminal) Token() @X@Token { return t.t.Tokens[t.i] }

// GetText is the token's text.
func (t @X@Terminal) GetText() string { return t.t.Text(int(t.i)) }

// @X@Child is a child of a node: a node or a token.
type @X@Child struct {
	t   *@X@Tree
	ref int32
}

// IsToken reports whether the child is a token.
func (c @X@Child) IsToken() bool { return c.ref < 0 }

// Node is the child as a node; no node when it is a token.
func (c @X@Child) Node() @X@NodeRef {
	if c.ref < 0 {
		return @X@NodeRef{c.t, -1}
	}
	return @X@NodeRef{c.t, c.ref}
}

// Terminal is the child as a token; no token when it is a node.
func (c @X@Child) Terminal() @X@Terminal {
	if c.ref >= 0 {
		return @X@Terminal{c.t, -1}
	}
	return @X@Terminal{c.t, -c.ref - 1}
}
`
