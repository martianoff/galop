package golang

// errorsSource is the Go code that reports a failed parse's syntax error as
// ANTLR 4.13.1's Go runtime does, shared by both flavors. PFX, PARSER and
// @ZERO@ are filled as in predictorSource.
//
// ANTLR's first error depends on where its generated code calls the default
// error strategy and on how its prediction fails, not only on the token
// where the input stops making sense. So after the final parse fails, the
// parser replays ANTLR's generated parser from the first token over galop's
// ATN, up to the first error ANTLR would report:
//
//   - each decision is made the way ANTLR's code generator makes it: an
//     LL(1) switch where the alternatives' lookahead sets are disjoint
//     (with ANTLR's errors for those), adaptive prediction otherwise;
//   - Sync runs where the generated code calls it (choice blocks, loop
//     entries, loop backs, a `+` loop's first iteration), with ANTLR's
//     single-token deletion and its mismatch;
//   - a token match recovers with ANTLR's RecoverInline (extraneous input,
//     missing token, mismatched input);
//   - the Go target's errors that are set but only reported at its next
//     error check: a failed set match (`('(' | NL_LPAREN)`) or Sync leaves
//     the error pending, a successful prediction clears it, and the end of
//     a rule reports it;
//   - a failed prediction reports ANTLR's "no viable alternative": from the
//     decision's first token to the token where SLL prediction found no
//     viable configuration, or at the first token when full-context
//     prediction failed (ANTLR rewinds the input before it builds that
//     error); but where a configuration had already left the decision's
//     rule, ANTLR takes the lowest such alternative and parses on.
val errorsSource = `
// Kinds of decisions in PFXDecisionKind, and of Sync in PFXStateSync.
const (
	PFXDecisionAlt    = 0
	PFXDecisionOpt    = 1
	PFXDecisionStar   = 2
	PFXDecisionPlus   = 3
	PFXSyncBlockStart = 1
	PFXSyncLoopBack   = 2
)

// PFXExpected is a set of token types, EOF included, being collected for an
// error message.
type PFXExpected struct {
	in []bool // indexed by token type + 1
}

func (x *PFXExpected) add(set []int32) {
	for i := 0; i < len(set); i += 2 {
		for t := set[i]; t <= set[i+1]; t++ {
			x.in[t+1] = true
		}
	}
}

// has reports whether t is in the set; a type outside the vocabulary never is.
func (x *PFXExpected) has(t int32) bool { return t+1 >= 0 && int(t+1) < len(x.in) && x.in[t+1] }

// String renders the set as ANTLR's IntervalSet.StringVerbose: one name, or
// names in type order between braces.
func (x *PFXExpected) String() string {
	var names []string
	for i, ok := range x.in {
		if !ok {
			continue
		}
		if i == 0 {
			names = append(names, "<EOF>")
		} else {
			names = append(names, PFXTokenDisplay[i-1])
		}
	}
	if len(names) == 1 {
		return names[0]
	}
	return "{" + strings.Join(names, ", ") + "}"
}

// PFXEmuError is the first error ANTLR reports: its message, at token at.
type PFXEmuError struct {
	at  int
	msg string
}

// PFXEmu replays ANTLR's parse of the parser's tokens; see errorsSource.
type PFXEmu struct {
	p       *PARSER
	pending *PFXEmuError
	sll     PFXSLLFailure
}

// antlrError replaces err, the final parse's syntax error, with the first
// error ANTLR reports parsing the same tokens from rule's start state. The
// replay predicts over the tokens alone, never over bracketed groups. The
// parser's position is left where the failed parse left it.
func (p *PARSER) antlrError(start int32, err error) error {
	pos, ll, group := p.pos, p.ll, p.group
	defer func() { p.pos, p.ll, p.group = pos, ll, group }()
	p.ll, p.group = true, false
	// Conflicts the repair checked need no full-context prediction again.
	if len(p.rp.recs) > 0 {
		p.rp.indexRecs()
		defer func() { p.rp.byPos = nil }()
	}
	e := PFXEmu{p: p}
	if found := e.run(start); found != nil {
		return p.syntaxErrorAt(found.at, found.msg)
	}
	return err
}

// expected is ANTLR's getExpectedTokens at state s with the parser's stack:
// what can follow s, through the rules on the stack while their ends can be
// reached, and EOF past the outermost.
func (e *PFXEmu) expected(s int32) *PFXExpected {
	x := &PFXExpected{in: make([]bool, PFXMaxTokenType+2)}
	x.add(PFXTokenSets[PFXStateNext[s]])
	reaches := PFXStateReachesEnd[s]
	for i := len(e.p.stack) - 1; i >= 0 && reaches; i-- {
		f := e.p.stack[i]
		x.add(PFXTokenSets[PFXStateNext[f]])
		reaches = PFXStateReachesEnd[f]
	}
	if reaches {
		x.in[0] = true
	}
	return x
}

// PFXQuote is ANTLR's escapeWSAndQuote.
func PFXQuote(s string) string {
	s = strings.ReplaceAll(s, "\t", "\\t")
	s = strings.ReplaceAll(s, "\n", "\\n")
	s = strings.ReplaceAll(s, "\r", "\\r")
	return "'" + s + "'"
}

// report is ANTLR's "<what> input <token> expecting <set>" at the current token.
func (e *PFXEmu) report(what string, exp *PFXExpected) *PFXEmuError {
	pos := e.p.pos
	return &PFXEmuError{pos, what + " input " + PFXQuote(e.p.tokenDisplay(pos)) + " expecting " + exp.String()}
}

func (e *PFXEmu) noViable(start, off int) *PFXEmuError {
	input := "<EOF>"
	if e.p.types[start] != @EOF@ {
		input = e.p.inputText(start, off)
	}
	return &PFXEmuError{off, "no viable alternative at input " + PFXQuote(input)}
}

// recoverInline is ANTLR's RecoverInline at match state s, whose transition
// leads to next: an error it reports is returned, a mismatch it only sets
// becomes pending.
func (e *PFXEmu) recoverInline(s, next int32) *PFXEmuError {
	exp := e.expected(s)
	switch {
	case exp.has(e.p.la(2)):
		return e.report("extraneous", exp)
	case e.expected(next).has(e.p.la(1)):
		pos := e.p.pos
		return &PFXEmuError{pos, "missing " + exp.String() + " at " + PFXQuote(e.p.tokenDisplay(pos))}
	}
	e.pending = e.report("mismatched", exp)
	return nil
}

// sync is ANTLR's Sync at s, of a block start or a loop back, followed by the
// generated code's error check if check is set: an error it reports is
// returned; a mismatch at a block start becomes pending.
func (e *PFXEmu) sync(s int32, blockStart, check bool) *PFXEmuError {
	if !PFXStateReachesEnd[s] && !PFXInSet(PFXTokenSets[PFXStateNext[s]], e.p.la(1)) {
		exp := e.expected(s)
		if !blockStart || exp.has(e.p.la(2)) {
			return e.report("extraneous", exp)
		}
		e.pending = e.report("mismatched", exp)
	}
	if check {
		return e.pending
	}
	return nil
}

// ll1Alt is the alternative of decision d whose lookahead has LA(1), or 0.
func (e *PFXEmu) ll1Alt(d int) int {
	t := e.p.la(1)
	for i := PFXAltLookStart[d]; i < PFXAltLookStart[d+1]; i++ {
		if PFXInSet(PFXTokenSets[PFXAltLook[i]], t) {
			return int(i-PFXAltLookStart[d]) + 1
		}
	}
	return 0
}

func (e *PFXEmu) consume() {
	if e.p.types[e.p.pos] != @EOF@ {
		e.p.pos++
	}
}

// run replays ANTLR from state s, a rule's start, and returns the first
// error it reports, or nil.
func (e *PFXEmu) run(s int32) *PFXEmuError {
	p := e.p
	p.pos = 0
	p.stack = p.stack[:0]
	// back says the walk just left a loop back, which synced already: a
	// loop's next iteration does not sync at its start.
	back := false
	for {
		fromBack := back
		back = false
		if PFXStateIsStop[s] {
			// The end of a rule function checks for an error.
			if e.pending != nil {
				return e.pending
			}
			if len(p.stack) == 0 {
				return nil
			}
			s = p.stack[len(p.stack)-1]
			p.stack = p.stack[:len(p.stack)-1]
			continue
		}
		if d := int(PFXStateDecision[s]); d >= 0 {
			// ANTLR matches the alternatives of a set decision as one set.
			if after := PFXDecisionSetAfter[d]; after >= 0 {
				if e.ll1Alt(d) > 0 {
					e.consume()
				} else if err := e.recoverInline(s, after); err != nil {
					return err
				}
				s = after
				continue
			}
			alt, err := e.decide(d, s, fromBack)
			if err != nil {
				return err
			}
			back = PFXDecisionKind[d] == PFXDecisionPlus && alt == int(PFXDecisionLoopAlt[d])
			s = PFXTransTarget[PFXTransStart[s]+int32(alt)-1]
			continue
		}
		switch PFXStateSync[s] {
		case PFXSyncLoopBack:
			if err := e.sync(s, false, true); err != nil {
				return err
			}
			back = true
		case PFXSyncBlockStart:
			if !fromBack {
				if err := e.sync(s, true, true); err != nil {
					return err
				}
			}
		}
		i := PFXTransStart[s]
		t := PFXTransTarget[i]
		switch PFXTransKind[i] {
		case PFXKindEpsilon:
		case PFXKindRule:
			p.stack = append(p.stack, PFXTransArg[i])
		default:
			if PFXMatches(i, p.la(1)) {
				e.consume()
			} else if err := e.recoverInline(s, t); err != nil {
				return err
			}
			// The generated code checks for an error after a token match,
			// not after a set match.
			if PFXTransKind[i] == PFXKindAtom && e.pending != nil {
				return e.pending
			}
		}
		s = t
	}
}

// decide makes decision d at state s as ANTLR's generated code does; fromBack
// says the walk came from the loop back of a star loop, which synced already.
func (e *PFXEmu) decide(d int, s int32, fromBack bool) (int, *PFXEmuError) {
	pos := e.p.pos
	ll1 := PFXDecisionLL1[d]
	// A token an alternative accepts passes Sync too: an LL(1) answer with no
	// error pending needs no Sync.
	if ll1 && e.pending == nil {
		if alt := e.ll1Alt(d); alt > 0 {
			return alt, nil
		}
	}
	var err *PFXEmuError
	switch PFXDecisionKind[d] {
	case PFXDecisionAlt:
		err = e.sync(s, true, true)
	case PFXDecisionOpt:
		// Adaptive prediction follows Sync with no error check.
		err = e.sync(s, true, ll1)
	case PFXDecisionStar:
		if !fromBack {
			err = e.sync(s, true, true)
		}
	case PFXDecisionPlus:
		err = e.sync(s, false, ll1)
	}
	switch {
	case err != nil:
		return 0, err
	case !ll1:
		return e.predict(d)
	}
	if alt := e.ll1Alt(d); alt > 0 {
		return alt, nil
	}
	// An LL(1) choice fails; an optional block or a loop exits.
	if PFXDecisionKind[d] == PFXDecisionAlt {
		return 0, e.noViable(pos, pos)
	}
	return int(PFXAltLookStart[d+1] - PFXAltLookStart[d]), nil
}

// predict is ANTLR's AdaptivePredict for decision d, which sets the parser's
// error to its outcome: a failure is returned, a success clears any pending
// error.
func (e *PFXEmu) predict(d int) (int, *PFXEmuError) {
	p := e.p
	pos := p.pos
	p.llBad = false
	alt, ok := func() (alt int, ok bool) {
		defer func() {
			if r := recover(); r != nil {
				if _, isSE := r.(*@SYNTAXERROR@); !isSE {
					panic(r)
				}
				alt, ok = 0, false
			}
		}()
		return p.adaptivePredict(d), true
	}()
	p.pos = pos
	e.sll.note(d, pos)
	if !ok {
		// A failed full-context stage rewinds the input before ANTLR builds
		// its error, so the error is at the decision's first token.
		if p.llBad {
			return 0, e.noViable(pos, pos)
		}
		off, fallback := e.sllFailure(d)
		if fallback == 0 {
			return 0, e.noViable(pos, off)
		}
		alt = fallback
	}
	e.pending = nil
	return alt, nil
}

// PFXFlagConfig is an SLL configuration with ANTLR's reachesIntoOuterContext
// as a flag. Like ANTLR's counter, the flag belongs to the configuration, not
// to one path: configurations with the same state and alternative merge, and
// so do their flags, and what a configuration reaches inherits its flag.
type PFXFlagConfig struct {
	state, alt, ctx int32
	left            bool
}

// PFXFlagSet is a set of PFXFlagConfig, one per state and alternative. dips
// is ANTLR's dipsIntoOuterContext: building the set followed a rule's end
// with no caller known.
type PFXFlagSet struct {
	list []PFXFlagConfig
	at   PFXMap
	dips bool
}

func (s *PFXFlagSet) reset() {
	s.list = s.list[:0]
	s.at.reset()
	s.dips = false
}

func (s *PFXFlagSet) add(c PFXFlagConfig, cp *PFXCtxPool) {
	// ANTLR's Add sets dipsIntoOuterContext for any flagged configuration.
	s.dips = s.dips || c.left
	k := uint64(uint32(c.state))<<32 | uint64(uint32(c.alt))
	if i, isNew := s.at.put(k, int32(len(s.list))); !isNew {
		s.list[i].ctx = cp.merge(s.list[i].ctx, c.ctx)
		s.list[i].left = s.list[i].left || c.left
		return
	}
	s.list = append(s.list, c)
}

// key packs c as the predictor packs its configurations, with the flag in
// bit 11 of the alternative.
func (c PFXFlagConfig) key() uint64 {
	alt := c.alt
	if c.left {
		alt |= 1 << 11
	}
	return PFXConfig{c.state, alt, c.ctx}.key()
}

// PFXSLLFailure replays SLL prediction of a failed decision.
type PFXSLLFailure struct {
	pool      PFXCtxPool
	busy      PFXMap
	cur, next PFXFlagSet
	mid       PFXFlagSet // the configurations a token reaches, before closure
	// history lists, per decision, the tokens the replay predicted it at;
	// walked counts those whose states built holds already.
	history [][]int32
	walked  []int
	// built holds the flags of each DFA state ANTLR has built, by the
	// state's key (see share). It and pool last for the whole replay.
	built map[string][]bool
	key   []byte
	// Scratch for settled.
	pr   PFXPredictor
	view []PFXConfig
}

// note records that the replay predicted decision d at token pos.
func (m *PFXSLLFailure) note(d, pos int) {
	if m.history == nil {
		m.history = make([][]int32, len(PFXDecisionState))
		m.walked = make([]int, len(PFXDecisionState))
	}
	m.history[d] = append(m.history[d], int32(pos))
}

func (m *PFXSLLFailure) closure(c PFXFlagConfig, out *PFXFlagSet) {
	if _, isNew := m.busy.put(c.key(), 0); !isNew {
		return
	}
	cp := &m.pool
	s := c.state
	if PFXStateIsStop[s] {
		// In ANTLR's order (closureCheckingStopState): the empty return,
		// which sorts last, at once; the others from a stack, last first.
		// Past the rule's end with no caller known, the configuration keeps
		// its whole context, as in ANTLR.
		from, n := cp.start[c.ctx], cp.length[c.ctx]
		if n > 0 && cp.rets[from+n-1] == PFXEmptyReturn {
			m.follow(c, out)
			n--
		}
		for i := n - 1; i >= 0; i-- {
			m.closure(PFXFlagConfig{cp.rets[from+i], c.alt, cp.parents[from+i], c.left}, out)
		}
		return
	}
	// Within a rule the predictor's precomputed closure applies: the flag only
	// changes at a rule's end.
	for i := PFXClosStart[s]; i < PFXClosStart[s+1]; i++ {
		t := PFXClosState[i]
		switch PFXClosKind[i] {
		case 0:
			out.add(PFXFlagConfig{t, c.alt, c.ctx, c.left}, cp)
		case 1:
			m.closure(PFXFlagConfig{t, c.alt, cp.singleton(c.ctx, PFXClosArg[i]), c.left}, out)
		default:
			m.closure(PFXFlagConfig{t, c.alt, c.ctx, c.left}, out)
		}
	}
}

// hasEmptyPath is ANTLR's PredictionContext.hasEmptyPath: context c can end
// with nothing left on the stack.
func (m *PFXSLLFailure) hasEmptyPath(c int32) bool {
	cp := &m.pool
	n := cp.length[c]
	return n > 0 && cp.rets[cp.start[c]+n-1] == PFXEmptyReturn
}

// follow continues c, at its rule's end with no caller known, after every
// call of the rule, as SLL prediction does, flagged as having left the rule.
// A rule nobody calls keeps c there as it is.
func (m *PFXSLLFailure) follow(c PFXFlagConfig, out *PFXFlagSet) {
	rule := PFXStateRule[c.state]
	if PFXFollowStart[rule] == PFXFollowStart[rule+1] {
		out.add(c, &m.pool)
		return
	}
	for i := PFXFollowStart[rule]; i < PFXFollowStart[rule+1]; i++ {
		f := PFXFlagConfig{PFXFollowState[i], c.alt, c.ctx, true}
		// ANTLR sets dipsIntoOuterContext here only for a configuration new
		// to the closure.
		if _, seen := m.busy.get(f.key()); !seen {
			out.dips = true
		}
		m.closure(f, out)
	}
}

// sllFailure replays SLL prediction of decision d, which failed, from the
// current token. It returns the token where no configuration survives and
// the lowest alternative of a configuration flagged as having left the
// decision's rule by then, or one at a rule's end with nothing left on its
// stack (0 for none): ANTLR predicts that alternative instead of failing.
//
// The flags depend on the DFA states ANTLR already holds (see share), so the
// replay first builds the states of this parse's earlier predictions of d
// that it has not built yet, in order.
func (e *PFXEmu) sllFailure(d int) (offending int, alt int) {
	m := &e.sll
	if m.built == nil {
		m.pool.reset(true)
		m.built = map[string][]bool{}
	}
	h := m.history[d]
	for _, pos := range h[m.walked[d] : len(h)-1] {
		m.walk(e.p.types, d, int(pos))
	}
	m.walked[d] = len(h)
	offending, alt, _ = m.walk(e.p.types, d, e.p.pos)
	return offending, alt
}

// walk runs SLL prediction of decision d from token from, building ANTLR's
// DFA states (see share). It reports whether prediction failed, and if so
// the token where it failed and the alternative ANTLR falls back on (see
// sllFailure).
func (m *PFXSLLFailure) walk(types []int32, d int, from int) (offending int, alt int, failed bool) {
	cur, next := &m.cur, &m.next
	cur.reset()
	m.busy.reset()
	s := PFXDecisionState[d]
	for i := PFXTransStart[s]; i < PFXTransStart[s+1]; i++ {
		m.closure(PFXFlagConfig{PFXTransTarget[i], i - PFXTransStart[s] + 1, 0, false}, cur)
	}
	m.share(d, cur)
	for pos := from; ; pos++ {
		t := types[pos]
		// As ANTLR's computeReachSet: merge what t reaches, then close it.
		m.mid.reset()
		for _, c := range cur.list {
			for i := PFXTransStart[c.state]; i < PFXTransStart[c.state+1]; i++ {
				k := PFXTransKind[i]
				if (k == PFXKindAtom || k == PFXKindSet) && PFXMatches(i, t) {
					m.mid.add(PFXFlagConfig{PFXTransTarget[i], c.alt, c.ctx, c.left}, &m.pool)
				}
			}
		}
		next.reset()
		m.busy.reset()
		for _, c := range m.mid.list {
			m.closure(c, next)
		}
		// A prediction that reads EOF stops there.
		if len(next.list) == 0 || t == @EOF@ {
			best := int32(0)
			for _, c := range cur.list {
				done := PFXStateIsStop[c.state] && m.hasEmptyPath(c.ctx)
				if (c.left || done) && (best == 0 || c.alt < best) {
					best = c.alt
				}
			}
			return pos, int(best), true
		}
		if m.settled(next.list) {
			return pos, 0, false
		}
		m.share(d, next)
		cur, next = next, cur
	}
}

// settled reports whether SLL prediction stops at a set, as PFXDFANext does:
// one alternative is left, or an SLL conflict.
func (m *PFXSLLFailure) settled(list []PFXFlagConfig) bool {
	v := m.view[:0]
	for _, c := range list {
		v = append(v, PFXConfig{c.state, c.alt, c.ctx})
	}
	m.view = v
	return PFXUniqueAlt(v) != 0 || m.pr.conflict(v)
}

// share turns set into ANTLR's DFA state of decision d for it. ANTLR keeps
// each state SLL prediction builds and reuses it for a later set with the same
// configurations in the same order (unlike PFXInternState, order counts) and
// the same dipsIntoOuterContext. The flags do not count, so a reused state's
// flags replace set's; a new state records set's.
func (m *PFXSLLFailure) share(d int, set *PFXFlagSet) {
	k := binary.LittleEndian.AppendUint32(m.key[:0], uint32(d))
	for _, c := range set.list {
		k = binary.LittleEndian.AppendUint32(k, uint32(c.state))
		k = binary.LittleEndian.AppendUint32(k, uint32(c.alt))
		k = binary.LittleEndian.AppendUint32(k, uint32(c.ctx))
	}
	if set.dips {
		k = append(k, 1)
	}
	m.key = k
	if flags, ok := m.built[string(k)]; ok {
		for i := range set.list {
			set.list[i].left = flags[i]
		}
		return
	}
	flags := make([]bool, len(set.list))
	for i, c := range set.list {
		flags[i] = c.left
	}
	m.built[string(k)] = flags
}
`

// nativeErrorHelpers are the native flavor's token text and error for
// errorsSource.
val nativeErrorHelpers = `
// tokenDisplay is token i's text as ANTLR's error messages show it.
func (p *PARSER) tokenDisplay(i int) string {
	t := p.ts.Tokens[i]
	if s := t.Text(p.ts.Src); s != "" {
		return s
	}
	// An empty token shows its type, as ANTLR's GetTokenErrorDisplay does.
	return "<" + strconv.Itoa(int(t.Type)) + ">"
}

// inputText is the text of tokens start to stop, with the off-channel tokens
// between them, as ANTLR's token stream gives it.
func (p *PARSER) inputText(start, stop int) string {
	var b strings.Builder
	for i := start; i <= stop; i++ {
		if i > start {
			for _, h := range p.ts.HiddenBefore(i) {
				b.WriteString(h.Text(p.ts.Src))
			}
		}
		if p.types[i] == @EOF@ {
			break
		}
		b.WriteString(p.ts.Tokens[i].Text(p.ts.Src))
	}
	return b.String()
}

// syntaxErrorAt is a syntax error with message msg at token i.
func (p *PARSER) syntaxErrorAt(i int, msg string) error {
	t := p.ts.Tokens[i]
	return &@SYNTAXERROR@{Line: int(t.Line), Column: int(t.Column), Msg: msg}
}
`

// antlrErrorHelpers are the antlr flavor's token text and error for
// errorsSource.
val antlrErrorHelpers = `
// tokenDisplay is token i's text as ANTLR's error messages show it.
func (p *PARSER) tokenDisplay(i int) string {
	t := p.toks[i]
	if s := t.GetText(); s != "" {
		return s
	}
	if t.GetTokenType() == antlr.TokenEOF {
		return "<EOF>"
	}
	return fmt.Sprintf("<%d>", t.GetTokenType())
}

// inputText is the text of tokens start to stop, with the off-channel tokens
// between them, as ANTLR's token stream gives it.
func (p *PARSER) inputText(start, stop int) string {
	return p.input.GetTextFromTokens(p.toks[start], p.toks[stop])
}

// syntaxErrorAt is a syntax error with message msg at token i.
func (p *PARSER) syntaxErrorAt(i int, msg string) error {
	return &@SYNTAXERROR@{p.toks[i], msg}
}
`
