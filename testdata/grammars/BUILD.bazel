exports_files(["gala.g4"])

# The corpus check: every grammar here parses, passes the semantic checks, and
# round-trips through the formatter. `bazel test //...` builds this target, so
# a grammar that fails the check fails the build.
genrule(
    name = "corpus_check",
    srcs = glob(["*.g4"]),
    outs = ["corpus_check.txt"],
    cmd = "$(location //cmd/galop) -check -roundtrip $(SRCS) > $@",
    tools = ["//cmd/galop"],
)
