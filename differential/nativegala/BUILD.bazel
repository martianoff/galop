load("@rules_go//go:def.bzl", "go_library", "go_test")

# galop's lexer and parser for gala.g4 in the Go target's default, native
# flavor, generated at build time by the galop CLI built from this repository.
# The library does not depend on ANTLR. galop is a source, not a tool, so it
# is built once, for the target configuration (see testdata/grammars).
genrule(
    name = "galop_native_go",
    srcs = [
        "//cmd/galop",
        "//testdata/grammars:gala.g4",
    ],
    outs = [
        "gala_lexer.go",
        "gala_parser.go",
    ],
    cmd = "$(location //cmd/galop) -package nativegala -Xexact-output-dir -o $(RULEDIR) $(location //testdata/grammars:gala.g4)",
)

go_library(
    name = "nativegala",
    srcs = [
        "newline.go",
        "tokens.go",
        ":galop_native_go",
    ],
    importpath = "github.com/martianoff/galop/differential/nativegala",
    visibility = ["//differential:__subpackages__"],
)

# nativetokens builds its package from the same helpers.
exports_files([
    "newline.go",
    "tokens.go",
])

# The guessing first pass's plan against the runtime predictor, on both corpora.
[go_test(
    name = name,
    size = "medium",
    srcs = ["guess_test.go"],
    args = ["-manifest=$(rlocationpath %s)" % corpus],
    data = [corpus],
    embed = [":nativegala"],
    deps = ["//differential/corpus"],
) for name, corpus in [
    ("guess_test", "//differential:corpus"),
    ("heldout_guess_test", "//differential:heldout"),
]]
