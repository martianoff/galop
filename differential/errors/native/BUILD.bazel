load("@rules_go//go:def.bzl", "go_library")

# galop's native flavor for Errors.g4, generated at build time.
genrule(
    name = "galop_native_go",
    srcs = [
        "//cmd/galop",
        "//differential/errors:Errors.g4",
    ],
    outs = [
        "errors_lexer.go",
        "errors_parser.go",
    ],
    cmd = "$(location //cmd/galop) -package native -Xexact-output-dir -o $(RULEDIR) $(location //differential/errors:Errors.g4)",
)

go_library(
    name = "native",
    srcs = [
        ":galop_native_go",
    ],
    importpath = "github.com/martianoff/galop/differential/errors/native",
    visibility = ["//differential/errors:__pkg__"],
)
