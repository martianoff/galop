load("@rules_go//go:def.bzl", "go_library", "go_test")

DIFF_TEST_SRCS = [
    "corpus_test.go",
    "diff_test.go",
    "errors_test.go",
    "native_test.go",
    "convert_test.go",
    "mutations_test.go",
]

DIFF_TEST_DEPS = [
    "//differential/antlrgala",
    "//differential/corpus",
    "//differential/gala",
    "//differential/mutate",
    "//differential/nativegala",
    "//differential/nativetokens",
    "@com_github_antlr4_go_antlr_v4//:antlr",
]

go_library(
    name = "diff",
    srcs = ["diff.go"],
    importpath = "github.com/martianoff/galop/differential/diff",
    visibility = ["//differential:__subpackages__"],
    deps = [
        "//differential/corpus",
        "//differential/gala",
        "@com_github_antlr4_go_antlr_v4//:antlr",
    ],
)

# Parses the GALA corpus with ANTLR under SLL and under LL prediction and
# requires identical trees, compares galop's parsers with ANTLR on it and on
# mutated copies of it; also holds the testing.B benchmarks:
#   bazel run //differential/diff:diff_test -- -test.run='^$' -test.bench=. -test.benchmem
go_test(
    name = "diff_test",
    size = "medium",
    srcs = DIFF_TEST_SRCS,
    args = ["-manifest=$(rlocationpath //differential:corpus)"],
    data = ["//differential:corpus"],
    embed = [":diff"],
    deps = DIFF_TEST_DEPS,
)

# The same comparisons on the held-out corpus, code galop was not tuned on
# (heldout_test), and many more mutants on both corpora. The large runs are
# too slow for pull requests; CI runs them on pushes to main:
#   bazel test //differential/diff:mutations_large_test //differential/diff:heldout_mutations_large_test
[go_test(
    name = name,
    size = size,
    srcs = DIFF_TEST_SRCS,
    args = ["-manifest=$(rlocationpath %s)" % corpus] + args,
    data = [corpus],
    embed = [":diff"],
    tags = tags,
    deps = DIFF_TEST_DEPS,
) for name, corpus, size, tags, args in [
    ("heldout_test", "//differential:heldout", "medium", [], [
        "-test.run=^(TestGalopMatchesANTLR|TestNativeMatchesANTLR|TestConvertMatchesNative|TestConvertRecoveredTrees|TestMutations|TestSyntaxErrors)$$",
    ]),
    ("mutations_large_test", "//differential:corpus", "enormous", ["manual"], [
        "-test.run=^(TestMutations|TestSyntaxErrors|TestConvertRecoveredTrees)$$",
        "-mutants=20000",
        "-error_mutants=5000",
        "-recovered_trees=2000",
        "-mutant_seed=2",
    ]),
    ("heldout_mutations_large_test", "//differential:heldout", "enormous", ["manual"], [
        "-test.run=^(TestMutations|TestSyntaxErrors|TestConvertRecoveredTrees)$$",
        "-mutants=10000",
        "-error_mutants=3000",
        "-recovered_trees=1000",
        "-mutant_seed=2",
    ]),
]]

# galop and ANTLR on generated sentences of gala.g4 (//differential:samples*)
# and on mutated copies of them: the same verdict, ANTLR's tree on accepted
# input and ANTLR's first error on rejected input, for both flavors. The large
# run is too slow for pull requests; CI runs it on pushes to main.
[go_test(
    name = name,
    size = size,
    srcs = DIFF_TEST_SRCS + ["generated_test.go"],
    args = [
        "-samples=$(rlocationpath %s)" % samples,
        "-test.run=^(TestGeneratedMatchesANTLR|TestParseWithStatsMatchesParse|TestConvertMatchesNative|TestConvertRecoveredTrees|TestMutations|TestSyntaxErrors)$$",
    ] + args,
    data = [samples],
    embed = [":diff"],
    tags = tags,
    deps = DIFF_TEST_DEPS,
) for name, samples, size, tags, args in [
    ("generated_test", "//differential:samples", "medium", [], [
        "-mutants=300",
        "-error_mutants=200",
    ]),
    ("generated_deep_test", "//differential:samples_deep", "medium", [], [
        "-mutants=150",
        "-error_mutants=100",
    ]),
] + [
    ("generated_large_%d_test" % i, "//differential:samples_large_%d" % i, "enormous", ["manual"], [
        "-mutants=2500",
        "-error_mutants=750",
        "-recovered_trees=500",
        "-mutant_seed=2",
    ])
    for i in range(1, 5)
]]
