load("@rules_go//go:def.bzl", "go_library", "go_test")

DIFF_TEST_SRCS = [
    "corpus_test.go",
    "diff_test.go",
    "native_test.go",
    "repair_test.go",
]

DIFF_TEST_DEPS = [
    "//differential/antlrgala",
    "//differential/corpus",
    "//differential/gala",
    "//differential/nativegala",
    "@com_github_antlr4_go_antlr_v4//:antlr",
]

go_library(
    name = "diff",
    srcs = ["diff.go"],
    importpath = "github.com/martianoff/galop/differential/diff",
    visibility = ["//differential:__subpackages__"],
    deps = [
        "//differential/corpus",
        "//differential/gala",
        "@com_github_antlr4_go_antlr_v4//:antlr",
    ],
)

# Parses the GALA corpus with ANTLR under SLL and under LL prediction and
# requires identical trees, compares galop's parsers with ANTLR on it and on
# mutated copies of it; also holds the testing.B benchmarks:
#   bazel run //differential/diff:diff_test -- -test.run='^$' -test.bench=. -test.benchmem
go_test(
    name = "diff_test",
    size = "medium",
    srcs = DIFF_TEST_SRCS,
    args = ["-manifest=$(rlocationpath //differential:corpus)"],
    data = ["//differential:corpus"],
    embed = [":diff"],
    deps = DIFF_TEST_DEPS,
)

# The same comparisons on the held-out corpus, code galop was not tuned on.
go_test(
    name = "heldout_test",
    size = "medium",
    srcs = DIFF_TEST_SRCS,
    args = [
        "-manifest=$(rlocationpath //differential:heldout)",
        "-test.run=^(TestGalopMatchesANTLR|TestNativeMatchesANTLR|TestMutations)$$",
    ],
    data = ["//differential:heldout"],
    embed = [":diff"],
    deps = DIFF_TEST_DEPS,
)

# Many more mutants than the tests above check, on both corpora. Too slow for
# pull requests; CI runs them on pushes to main:
#   bazel test //differential/diff:mutations_large_test //differential/diff:heldout_mutations_large_test
[go_test(
    name = name,
    size = "enormous",
    srcs = DIFF_TEST_SRCS,
    args = [
        "-manifest=$(rlocationpath %s)" % corpus,
        "-test.run=^TestMutations$$",
        "-mutants=%d" % mutants,
        "-mutant_seed=2",
    ],
    data = [corpus],
    embed = [":diff"],
    tags = ["manual"],
    deps = DIFF_TEST_DEPS,
) for name, corpus, mutants in [
    ("mutations_large_test", "//differential:corpus", 20000),
    ("heldout_mutations_large_test", "//differential:heldout", 10000),
]]
