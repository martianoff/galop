// Code generated from convert_test.go.tmpl for grammar @G@. DO NOT EDIT.

// Package convert checks, for one grammar, that galop's generated code
// compiles and that the converter from ANTLR's trees gives native parsing's
// tree: on generated sentences, ANTLR's tree and galop's antlr-flavor tree
// convert to the native tree exactly; on mutants ANTLR rejects, the converted
// recovered tree is well formed and prints as ANTLR's. It also runs the native
// typed view, listener and visitor over every tree.
package convert

import (
	"flag"
	"fmt"
	"math/rand"
	"reflect"
	"slices"
	"strings"
	"testing"

	"github.com/antlr4-go/antlr/v4"

	ga "@ANTLRPKG@"
	gn "@NATIVEPKG@"
	"github.com/martianoff/galop/differential/corpus"
)

var (
	samples = flag.String("samples", "", "galop-sample output to read")
	mutants = flag.Int("mutants", 200, "how many rejected mutants to convert")
)

// errorListener keeps ANTLR's first lexical or syntax error.
type errorListener struct {
	*antlr.DefaultErrorListener
	err error
}

func (l *errorListener) SyntaxError(_ antlr.Recognizer, _ interface{}, line, column int, msg string, _ antlr.RecognitionException) {
	if l.err == nil {
		l.err = fmt.Errorf("%d:%d: %s", line, column, msg)
	}
}

// parseANTLR parses src with ANTLR, recovering from errors, and returns the
// tree, its token stream and the first error.
func parseANTLR(src string) (antlr.ParserRuleContext, *antlr.CommonTokenStream, error) {
	errs := &errorListener{DefaultErrorListener: antlr.NewDefaultErrorListener()}
	lexer := ga.New@G@Lexer(antlr.NewInputStream(src))
	lexer.RemoveErrorListeners()
	lexer.AddErrorListener(errs)
	stream := antlr.NewCommonTokenStream(lexer, antlr.TokenDefaultChannel)
	p := ga.New@G@Parser(stream)
	p.RemoveErrorListeners()
	p.AddErrorListener(errs)
	return p.@START@(), stream, errs.err
}

// crashes runs parse, ANTLR's parse of an input, and reports whether ANTLR's
// runtime panicked: its MatchWildcard dereferences the nil token
// RecoverInline returns for a wildcard at EOF.
func crashes(parse func()) (crashed bool) {
	defer func() {
		crashed = recover() != nil
	}()
	parse()
	return false
}

// parseFlavor parses src with galop's antlr flavor.
func parseFlavor(src string) (antlr.ParserRuleContext, *antlr.CommonTokenStream, error) {
	stream := antlr.NewCommonTokenStream(ga.New@G@GalopLexer(antlr.NewInputStream(src)), antlr.TokenDefaultChannel)
	ctx, err := ga.New@G@GalopParser(stream).Parse@START@()
	return ctx, stream, err
}

// parseNative parses src with the native flavor; a lexical error is an error.
func parseNative(src string) (*gn.@N@Tree, error) {
	ts := gn.@N@Lex(src)
	if len(ts.Errors) > 0 {
		return nil, fmt.Errorf("lexical error %v", &ts.Errors[0])
	}
	root, err := gn.Parse@START@(ts)
	if err != nil {
		return nil, err
	}
	return root.Tree(), nil
}

func sentences(t *testing.T) []string {
	fs, err := corpus.FromSamples(*samples)
	if err != nil {
		t.Fatal(err)
	}
	srcs := make([]string, len(fs))
	for i, f := range fs {
		srcs[i] = f.Src
	}
	return srcs
}

// sameTree describes the first difference between two native trees, or "".
func sameTree(want, got *gn.@N@Tree) string {
	switch {
	case !reflect.DeepEqual(want.Tokens, got.Tokens):
		return "tokens differ"
	case !reflect.DeepEqual(want.Hidden, got.Hidden):
		return "hidden tokens differ"
	case !slices.Equal(want.Nodes, got.Nodes):
		return fmt.Sprintf("nodes differ:\n%+v\nwant\n%+v", got.Nodes, want.Nodes)
	case !slices.Equal(want.Kids, got.Kids):
		return "child references differ"
	case !slices.Equal(want.TokenLabels, got.TokenLabels):
		return fmt.Sprintf("token labels %+v, want %+v", got.TokenLabels, want.TokenLabels)
	case want.Next != got.Next:
		return fmt.Sprintf("next token %d, want %d", got.Next, want.Next)
	case len(got.ErrorKids)+len(got.Conjured) > 0:
		return "error tokens in a tree native parsing accepts"
	}
	return ""
}

// TestConvertMatchesNative converts ANTLR's tree and the antlr flavor's of
// every sentence native parsing accepts, and requires native parsing's tree.
func TestConvertMatchesNative(t *testing.T) {
	accepted := 0
	for i, src := range sentences(t) {
		want, err := parseNative(src)
		if err != nil {
			continue
		}
		accepted++
		ctx, stream, aerr := parseANTLR(src)
		if aerr != nil {
			t.Errorf("sentence %d: native parsing accepts, ANTLR reports %v\n%s", i, aerr, src)
			continue
		}
		got, _, ctxs := ga.@N@ToNativeContexts(ctx, stream, src)
		if msg := checkContexts(got, ctxs, ctx); msg != "" {
			t.Errorf("sentence %d: @N@ToNativeContexts: %s", i, msg)
		}
		if d := sameTree(want, got); d != "" {
			t.Errorf("sentence %d: converted ANTLR tree: %s\n%s", i, d, src)
		}
		fctx, fstream, ferr := parseFlavor(src)
		if ferr != nil {
			t.Errorf("sentence %d: galop's antlr flavor reports %v", i, ferr)
			continue
		}
		fgot, _, fctxs := ga.@N@ToNativeContexts(fctx, fstream, src)
		if msg := checkContexts(fgot, fctxs, fctx); msg != "" {
			t.Errorf("sentence %d: @N@ToNativeContexts of the antlr flavor's tree: %s", i, msg)
		}
		if d := sameTree(want, fgot); d != "" {
			t.Errorf("sentence %d: converted antlr-flavor tree: %s\n%s", i, d, src)
		}
		for _, tree := range []*gn.@N@Tree{want, got, fgot} {
			if msg := walkAll(tree); msg != "" {
				t.Errorf("sentence %d: %s", i, msg)
			}
		}
	}
	if accepted == 0 {
		t.Fatal("native parsing accepts no sentence")
	}
	t.Logf("%d sentences converted and compared", accepted)
}

// mutate drops, doubles or swaps a token of src, or copies one elsewhere.
func mutate(r *rand.Rand, src string) string {
	toks := gn.@N@Lex(src).Tokens
	if len(toks) < 3 {
		return src
	}
	a, b := toks[r.Intn(len(toks)-1)], toks[r.Intn(len(toks)-1)]
	text := func(t gn.@N@Token) string { return src[t.Start:t.End] }
	switch r.Intn(4) {
	case 0:
		return src[:a.Start] + src[a.End:]
	case 1:
		return src[:a.End] + " " + text(a) + src[a.End:]
	case 2:
		return src[:a.Start] + text(b) + src[a.End:]
	}
	return src[:a.End] + " " + text(b) + " " + src[a.End:]
}

// TestConvertRecoveredTrees converts ANTLR's error-recovered trees of mutants
// it rejects and requires a well-formed tree that prints as ANTLR's.
func TestConvertRecoveredTrees(t *testing.T) {
	srcs := sentences(t)
	r := rand.New(rand.NewSource(1))
	converted, withErrors := 0, 0
	for tries := 0; converted < *mutants && tries < 50**mutants; tries++ {
		src := mutate(r, srcs[r.Intn(len(srcs))])
		if len(gn.@N@Lex(src).Errors) > 0 {
			continue
		}
		var ctx antlr.ParserRuleContext
		var stream *antlr.CommonTokenStream
		var err error
		if crashes(func() { ctx, stream, err = parseANTLR(src) }) || err == nil {
			continue
		}
		converted++
		i := converted
		tree, _, ctxs := ga.@N@ToNativeContexts(ctx, stream, src)
		if msg := checkContexts(tree, ctxs, ctx); msg != "" {
			t.Errorf("mutant %d: @N@ToNativeContexts: %s", i, msg)
		}
		if msg := wellFormed(tree); msg != "" {
			t.Errorf("mutant %d: %s\n%s", i, msg, src)
			continue
		}
		if got, want := tree.Root().ToStringTree(), antlr.TreesStringTree(ctx, gn.@N@RuleNames, nil); got != want {
			t.Errorf("mutant %d: prints\n%s\nwant\n%s", i, got, want)
		}
		if msg := walkAll(tree); msg != "" {
			t.Errorf("mutant %d: %s", i, msg)
		}
		if len(tree.ErrorKids) > 0 {
			withErrors++
		}
	}
	if converted == 0 {
		t.Fatal("no mutant was rejected, so no recovered tree was converted")
	}
	t.Logf("%d recovered trees converted, %d with error tokens", converted, withErrors)
}

// checkContexts checks what @N@ToNativeContexts returns beside tree: one
// context per node, of the node's rule and starting at its first token, the
// root's last, each once.
func checkContexts(tree *gn.@N@Tree, ctxs []antlr.ParserRuleContext, root antlr.ParserRuleContext) string {
	if len(ctxs) != len(tree.Nodes) {
		return fmt.Sprintf("%d contexts for %d nodes", len(ctxs), len(tree.Nodes))
	}
	if ctxs[len(ctxs)-1] != root {
		return "the root node's context is not the root"
	}
	seen := make(map[antlr.ParserRuleContext]bool, len(ctxs))
	for i, c := range ctxs {
		switch {
		case c.GetRuleIndex() != int(tree.Nodes[i].Rule):
			return fmt.Sprintf("node %d is rule %d, its context rule %d", i, tree.Nodes[i].Rule, c.GetRuleIndex())
		case seen[c]:
			return fmt.Sprintf("node %d's context is another node's too", i)
		}
		seen[c] = true
		// GetText takes a slice of the source where it can (spanText);
		// either way it is ANTLR's text, "<EOF>" and conjured tokens included.
		if got, want := tree.Node(i).GetText(), c.GetText(); got != want {
			return fmt.Sprintf("node %d's text is %q, its context's %q", i, got, want)
		}
		if n := tree.Nodes[i]; n.Stop >= n.Start {
			if s, tok := tree.Tokens[n.Start], c.GetStart(); int(s.Line) != tok.GetLine() || int(s.Column) != tok.GetColumn() {
				return fmt.Sprintf("node %d starts at %d:%d, its context at %d:%d", i, s.Line, s.Column, tok.GetLine(), tok.GetColumn())
			}
		}
	}
	return ""
}

// wellFormed describes the first way tree breaks the native tree's
// invariants, or "".
func wellFormed(tree *gn.@N@Tree) string {
	nTokens := len(tree.Tokens) + len(tree.Conjured)
	parents := make([]int, len(tree.Nodes))
	for i := range parents {
		parents[i] = -1
	}
	for i, n := range tree.Nodes {
		if n.Stop < n.Start-1 || n.Start < 0 || int(n.Start) > len(tree.Tokens) || int(n.Stop) >= len(tree.Tokens) {
			return fmt.Sprintf("node %d spans %d..%d of %d tokens", i, n.Start, n.Stop, len(tree.Tokens))
		}
		if n.Kids < 0 || int(n.Kids+n.NKids) > len(tree.Kids) {
			return fmt.Sprintf("node %d's children are out of range", i)
		}
		for _, k := range tree.Kids[n.Kids : n.Kids+n.NKids] {
			switch {
			case k >= int32(i):
				return fmt.Sprintf("node %d has child %d, which does not come before it", i, k)
			case k >= 0 && parents[k] >= 0:
				return fmt.Sprintf("node %d is a child of %d and %d", k, parents[k], i)
			case k >= 0:
				parents[k] = i
			case int(-k-1) >= nTokens:
				return fmt.Sprintf("node %d has token child %d of %d", i, -k-1, nTokens)
			}
		}
	}
	for i, p := range parents[:len(parents)-1] {
		if p < 0 {
			return fmt.Sprintf("node %d has no parent", i)
		}
	}
	for i, p := range tree.ErrorKids {
		if p < 0 || int(p) >= len(tree.Kids) || tree.Kids[p] >= 0 || (i > 0 && p <= tree.ErrorKids[i-1]) {
			return fmt.Sprintf("error token %d is not a token child in order", i)
		}
	}
	return ""
}

// counter counts what Walk reports.
type counter struct {
	gn.@N@BaseListener
	enter, exit, tokens, errs int
}

func (c *counter) EnterEveryRule(gn.@N@NodeRef)  { c.enter++ }
func (c *counter) ExitEveryRule(gn.@N@NodeRef)   { c.exit++ }
func (c *counter) VisitTerminal(gn.@N@Terminal)  { c.tokens++ }
func (c *counter) VisitErrorNode(gn.@N@Terminal) { c.errs++ }

// visitor is the base visitor, which every node is accepted by.
type visitor struct{ gn.@N@BaseVisitor[int] }

// walkAll runs Typed, Accept and Walk over tree and checks what they see.
func walkAll(tree *gn.@N@Tree) string {
	tokens := 0
	for i := range tree.Nodes {
		n := tree.Node(i)
		h := n.Typed()
		if h == nil || h.Ref() != n {
			return fmt.Sprintf("node %d: Typed gives %v", i, h)
		}
		if ty := reflect.TypeOf(h); ty.Kind() != reflect.Pointer || !strings.HasSuffix(ty.Elem().Name(), "Node") {
			return fmt.Sprintf("node %d: Typed gives a %v", i, ty)
		}
		gn.@N@Accept[int](n, visitor{})
		for j := 0; j < n.ChildCount(); j++ {
			if n.Child(j).IsToken() {
				tokens++
			}
		}
	}
	c := &counter{}
	gn.@N@Walk(tree.Root(), c)
	switch {
	case c.enter != len(tree.Nodes) || c.exit != len(tree.Nodes):
		return fmt.Sprintf("Walk entered %d and left %d of %d nodes", c.enter, c.exit, len(tree.Nodes))
	case c.tokens+c.errs != tokens || c.errs != len(tree.ErrorKids):
		return fmt.Sprintf("Walk reported %d tokens and %d error tokens of %d and %d", c.tokens, c.errs, tokens, len(tree.ErrorKids))
	}
	return ""
}

// BenchmarkConvert converts ANTLR's trees of the sentences native parsing
// accepts (built once, outside the timing).
func BenchmarkConvert(b *testing.B) {
	fs, err := corpus.FromSamples(*samples)
	if err != nil {
		b.Fatal(err)
	}
	type parsed struct {
		ctx    antlr.ParserRuleContext
		stream *antlr.CommonTokenStream
		src    string
	}
	var trees []parsed
	for _, f := range fs {
		if ctx, stream, err := parseANTLR(f.Src); err == nil {
			trees = append(trees, parsed{ctx, stream, f.Src})
		}
	}
	b.ReportAllocs()
	b.ResetTimer()
	for range b.N {
		for _, t := range trees {
			ga.@N@ToNative(t.ctx, t.stream, t.src)
		}
	}
}

// allErrors keeps every syntax error ANTLR's parser reports, and the tokens
// its parser expects then (GetExpectedTokens), as an error listener sees them.
type allErrors struct {
	*antlr.DefaultErrorListener
	errs, expected []string
}

func (l *allErrors) SyntaxError(rec antlr.Recognizer, _ interface{}, line, column int, msg string, _ antlr.RecognitionException) {
	l.errs = append(l.errs, fmt.Sprintf("%d:%d: %s", line, column, msg))
	l.expected = append(l.expected, expectedText(rec.(antlr.Parser).GetExpectedTokens()))
}

// expectedText renders an ANTLR token set as the types in it, ascending
// (its intervals end before Stop).
func expectedText(set *antlr.IntervalSet) string {
	var types []int32
	for _, iv := range set.GetIntervals() {
		for t := iv.Start; t < iv.Stop; t++ {
			types = append(types, int32(t))
		}
	}
	return fmt.Sprint(types)
}

// recoverANTLR parses src with ANTLR's parser as a fresh process does (its
// DFA starts empty) and returns every syntax error and the error-recovered
// tree, converted. crashed says ANTLR's runtime panicked: its MatchWildcard
// dereferences the nil token RecoverInline returns for a wildcard at EOF.
func recoverANTLR(src string) ([]string, []string, *gn.@N@Tree, bool) {
	lexer := ga.New@G@Lexer(antlr.NewInputStream(src))
	lexer.RemoveErrorListeners()
	stream := antlr.NewCommonTokenStream(lexer, antlr.TokenDefaultChannel)
	p := ga.New@G@Parser(stream)
	atn := p.GetATN()
	dfa := make([]*antlr.DFA, len(atn.DecisionToState))
	for i, ds := range atn.DecisionToState {
		dfa[i] = antlr.NewDFA(ds, i)
	}
	p.Interpreter = antlr.NewParserATNSimulator(p, atn, dfa, antlr.NewPredictionContextCache())
	listener := &allErrors{DefaultErrorListener: antlr.NewDefaultErrorListener()}
	p.RemoveErrorListeners()
	p.AddErrorListener(listener)
	var ctx antlr.ParserRuleContext
	if crashes(func() { ctx = p.@START@() }) {
		return nil, nil, nil, true
	}
	tree, _ := ga.@N@ToNative(ctx, stream, src)
	return listener.errs, listener.expected, tree, false
}

// recoverGalop is Parse@START@WithRecovery's errors and the tokens expected
// at each, rendered as recoverANTLR renders ANTLR's, and its tree.
func recoverGalop(src string) ([]string, []string, *gn.@N@Tree) {
	root, errs := gn.Parse@START@WithRecovery(gn.@N@Lex(src))
	out := make([]string, len(errs))
	expected := make([]string, len(errs))
	for i, e := range errs {
		out[i] = fmt.Sprintf("%d:%d: %s", e.Line, e.Column, e.Msg)
		expected[i] = fmt.Sprint(e.Expected)
	}
	return out, expected, root.Tree()
}

// sameRecoveredTree describes the first difference between two trees,
// error tokens included, or "".
func sameRecoveredTree(want, got *gn.@N@Tree) string {
	switch {
	case got == nil:
		return "no tree"
	case !reflect.DeepEqual(want.Tokens, got.Tokens):
		return "tokens differ"
	case !slices.Equal(want.Nodes, got.Nodes):
		return fmt.Sprintf("nodes differ:\n%+v\nwant\n%+v", got.Nodes, want.Nodes)
	case !slices.Equal(want.Kids, got.Kids):
		return "child references differ"
	case !slices.Equal(want.ErrorKids, got.ErrorKids):
		return fmt.Sprintf("error tokens %v, want %v", got.ErrorKids, want.ErrorKids)
	case !slices.Equal(want.Conjured, got.Conjured) || !slices.Equal(want.ConjuredText, got.ConjuredText):
		return fmt.Sprintf("conjured tokens %+v %q, want %+v %q", got.Conjured, got.ConjuredText, want.Conjured, want.ConjuredText)
	case !slices.Equal(want.TokenLabels, got.TokenLabels):
		return fmt.Sprintf("token labels %+v, want %+v", got.TokenLabels, want.TokenLabels)
	case want.Next != got.Next:
		return fmt.Sprintf("next token %d, want %d", got.Next, want.Next)
	}
	return ""
}

// TestRecoveryMatchesANTLR compares the native flavor's recovering parse
// with ANTLR's on mutants ANTLR rejects: every syntax error, in order, and
// the error-recovered tree, converted.
func TestRecoveryMatchesANTLR(t *testing.T) {
	srcs := sentences(t)
	r := rand.New(rand.NewSource(2))
	checked, same, multi, crashes := 0, 0, 0, 0
	for tries := 0; checked < *mutants && tries < 50**mutants; tries++ {
		src := mutate(r, srcs[r.Intn(len(srcs))])
		if len(gn.@N@Lex(src).Errors) > 0 {
			continue
		}
		wantErrs, wantExp, wantTree, crashed := recoverANTLR(src)
		if crashed {
			crashes++
			continue
		}
		if len(wantErrs) == 0 {
			continue
		}
		checked++
		if len(wantErrs) > 1 {
			multi++
		}
		gotErrs, gotExp, gotTree := recoverGalop(src)
		d := sameRecoveredTree(wantTree, gotTree)
		if !slices.Equal(wantExp, gotExp) {
			d += fmt.Sprintf("\n expected tokens %v, want %v", gotExp, wantExp)
		}
		if slices.Equal(wantErrs, gotErrs) && d == "" {
			same++
			continue
		}
		t.Errorf("mutant %d:\n ANTLR: %s\n galop: %s\n tree: %s\n ANTLR: %s\n galop: %s\n%s", checked,
			strings.Join(wantErrs, "\n        "), strings.Join(gotErrs, "\n        "), d,
			wantTree.Root().ToStringTree(), gotTree.Root().ToStringTree(), src)
	}
	if checked == 0 {
		t.Fatal("no mutant was rejected")
	}
	t.Logf("%d rejected mutants (%d with several errors), %d recovered as ANTLR recovers; ANTLR crashed on %d more", checked, multi, same, crashes)
}

// observed is everything an error listener sees of a parser, ANTLR's or the
// antlr flavor's: each error's position, message, offending token and
// exception, and the parser's expected tokens, rule stack and context
// (its type and number of children) when the error is reported. ATN state
// numbers are left out: the antlr flavor's are galop's.
type observed struct {
	*antlr.DefaultErrorListener
	reports []string
}

func (l *observed) SyntaxError(rec antlr.Recognizer, offending interface{}, line, column int, msg string, e antlr.RecognitionException) {
	p := rec.(antlr.Parser)
	tok := offending.(antlr.Token)
	ctx := p.GetParserRuleContext()
	var offendingOfE string
	// A NoViableAltException's GetOffendingToken is nil in ANTLR's Go runtime.
	if e != nil && e.GetOffendingToken() != nil {
		offendingOfE = fmt.Sprint(e.GetOffendingToken().GetTokenIndex())
	}
	l.reports = append(l.reports, fmt.Sprintf("%d:%d: %s | token %d | %T %s | expected %s | stack %v | %T with %d children",
		line, column, msg, tok.GetTokenIndex(), e, offendingOfE, expectedText(p.GetExpectedTokens()),
		p.GetRuleInvocationStack(nil), ctx, ctx.GetChildCount()))
}

// dumpTree prints every node of an ANTLR tree: each context's type, start
// and stop tokens and exception, each token's index and text, error nodes
// marked.
func dumpTree(t antlr.Tree) string {
	var b strings.Builder
	var walk func(antlr.Tree, string)
	walk = func(t antlr.Tree, ind string) {
		switch n := t.(type) {
		case antlr.ErrorNode:
			fmt.Fprintf(&b, "%serror %d %q\n", ind, n.GetSymbol().GetTokenIndex(), n.GetText())
		case antlr.TerminalNode:
			fmt.Fprintf(&b, "%stoken %d %q\n", ind, n.GetSymbol().GetTokenIndex(), n.GetText())
		case antlr.ParserRuleContext:
			stop := -2
			if n.GetStop() != nil {
				stop = n.GetStop().GetTokenIndex()
			}
			fmt.Fprintf(&b, "%s%T %d..%d exception %s\n", ind, n, n.GetStart().GetTokenIndex(), stop, exceptionType(n))
			for _, c := range n.GetChildren() {
				walk(c, ind+"  ")
			}
		}
	}
	walk(t, "")
	return b.String()
}

// recoverWith parses src with ANTLR's parser or, with flavor set, galop's
// antlr flavor, as ANTLR's parser is used: through the rule method, with an
// error listener. It returns what the listener saw, the tree as dumpTree
// prints it and converted, and whether ANTLR's runtime crashed.
func recoverWith(src string, flavor bool) ([]string, string, *gn.@N@Tree, bool) {
	l := &observed{DefaultErrorListener: antlr.NewDefaultErrorListener()}
	var stream *antlr.CommonTokenStream
	var ctx antlr.ParserRuleContext
	if flavor {
		lexer := ga.New@G@GalopLexer(antlr.NewInputStream(src))
		lexer.RemoveErrorListeners()
		stream = antlr.NewCommonTokenStream(lexer, antlr.TokenDefaultChannel)
		p := ga.New@G@GalopParser(stream)
		p.RemoveErrorListeners()
		p.AddErrorListener(l)
		ctx = p.@START@()
	} else {
		lexer := ga.New@G@Lexer(antlr.NewInputStream(src))
		lexer.RemoveErrorListeners()
		stream = antlr.NewCommonTokenStream(lexer, antlr.TokenDefaultChannel)
		p := ga.New@G@Parser(stream)
		atn := p.GetATN()
		dfa := make([]*antlr.DFA, len(atn.DecisionToState))
		for i, ds := range atn.DecisionToState {
			dfa[i] = antlr.NewDFA(ds, i)
		}
		p.Interpreter = antlr.NewParserATNSimulator(p, atn, dfa, antlr.NewPredictionContextCache())
		p.RemoveErrorListeners()
		p.AddErrorListener(l)
		if crashes(func() { ctx = p.@START@() }) {
			return nil, "", nil, true
		}
	}
	tree, _ := ga.@N@ToNative(ctx, stream, src)
	return l.reports, dumpTree(ctx) + fmt.Sprintf("stream at %d\n", stream.Index()), tree, false
}

// TestANTLRFlavorRecoversAsANTLR compares the antlr flavor's rule method with
// ANTLR's on mutants ANTLR rejects: every call of the error listener, with
// what it reads of the parser, and the error-recovered tree, node by node
// and converted (which compares the label fields).
func TestANTLRFlavorRecoversAsANTLR(t *testing.T) {
	srcs := sentences(t)
	r := rand.New(rand.NewSource(3))
	checked, multi := 0, 0
	for tries := 0; checked < *mutants && tries < 50**mutants; tries++ {
		src := mutate(r, srcs[r.Intn(len(srcs))])
		if len(gn.@N@Lex(src).Errors) > 0 {
			continue
		}
		want, wantDump, wantTree, crashed := recoverWith(src, false)
		if crashed || len(want) == 0 {
			continue
		}
		checked++
		if len(want) > 1 {
			multi++
		}
		got, gotDump, gotTree, _ := recoverWith(src, true)
		if !slices.Equal(want, got) {
			t.Errorf("mutant %d %q: the listener sees\n %s\nANTLR's sees\n %s", checked, src, strings.Join(got, "\n "), strings.Join(want, "\n "))
			continue
		}
		if gotDump != wantDump {
			t.Errorf("mutant %d %q: tree\n%s\nANTLR's\n%s", checked, src, gotDump, wantDump)
			continue
		}
		if d := sameRecoveredTree(wantTree, gotTree); d != "" {
			t.Errorf("mutant %d %q: converted tree: %s", checked, src, d)
		}
	}
	if checked == 0 {
		t.Fatal("no mutant was rejected")
	}
	t.Logf("%d rejected mutants (%d with several errors) recovered as ANTLR recovers", checked, multi)
}

// TestANTLRFlavorRuleMethodOnValidInput checks that the rule method gives
// ANTLR's tree on the sentences ANTLR accepts, and calls no error listener.
func TestANTLRFlavorRuleMethodOnValidInput(t *testing.T) {
	checked := 0
	for i, src := range sentences(t) {
		want, wantDump, _, crashed := recoverWith(src, false)
		if crashed || len(want) > 0 {
			continue
		}
		checked++
		got, gotDump, _, _ := recoverWith(src, true)
		if len(got) > 0 || gotDump != wantDump {
			t.Fatalf("sentence %d: reports %q, tree\n%s\nANTLR's\n%s", i, got, gotDump, wantDump)
		}
	}
	if checked == 0 {
		t.Fatal("ANTLR accepted no sentence")
	}
}

// exceptionType is the type of a context's exception field, which ANTLR's
// Go runtime sets but has no getter for, or "<nil>".
func exceptionType(ctx antlr.ParserRuleContext) string {
	v := reflect.ValueOf(ctx)
	for v.Kind() == reflect.Pointer || v.Kind() == reflect.Interface {
		v = v.Elem()
	}
	f := v.FieldByName("exception")
	if !f.IsValid() || f.IsNil() {
		return "<nil>"
	}
	return f.Elem().Type().String()
}
