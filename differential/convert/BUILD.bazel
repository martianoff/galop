load(":defs.bzl", "convert_test")

exports_files(glob(["grammars/*.g4"]))

# Each grammar's ANTLR parser, galop's antlr flavor with the converter to the
# native tree and galop's native flavor with its listener and visitor, built
# and run on sentences galop-sample generates: the converted trees must be
# native parsing's (see convert_test.go.tmpl). gala.g4 has the same checks,
# on its corpora too, in //differential/diff.
[convert_test(
    name = name,
    entry = {"cel": "Start_"}.get(name),
    grammar = grammar,
    extra_srcs = {
        "labels": ["labels_getters_test.go"],
        "plan": ["plan_cases_test.go"],
        "recovery": ["recovery_cases_test.go"],
    }.get(name, []),
    grammar_name = grammar_name,
    sample_flags = flags,
    start = start,
) for name, grammar, grammar_name, start, flags in [
    ("expr", "grammars/Expr.g4", "Expr", "prog", "-n 300 -seed 1 -nesting 4 -tokens 200"),
    ("calc", "grammars/Calc.g4", "Calc", "prog", "-n 300 -seed 1 -nesting 4 -tokens 300"),
    ("labels", "grammars/Labels.g4", "Labels", "prog", "-n 400 -seed 1 -nesting 3 -tokens 200"),
    ("errors", "//differential/errors:Errors.g4", "Errors", "prog", "-n 300 -seed 1 -nesting 3 -tokens 300"),
    ("repair", "//differential/repair:Repair.g4", "Repair", "s3", "-n 300 -seed 1 -nesting 4 -tokens 200"),
    ("recovery", "grammars/Recovery.g4", "Recovery", "prog", "-n 300 -seed 1 -nesting 3 -tokens 200"),
    # Each shape of left-recursive alternative ANTLR's rewrite tells apart.
    ("shapes", "grammars/Shapes.g4", "Shapes", "prog", "-n 400 -seed 1 -nesting 4 -tokens 200"),
    # Spaces are a token (GetText takes a slice), and EOF is not the root's last child.
    ("text", "grammars/Text.g4", "Text", "prog", "-n 300 -seed 1 -nesting 4 -tokens 60"),
    # EOF in lexer rules: a line comment or a block may end the input.
    ("lines", "grammars/Lines.g4", "Lines", "prog", "-n 300 -seed 1 -nesting 4 -tokens 60"),
] + [
    # Corpus grammars from other projects (testdata/grammars); all but fileseq have
    # left-recursive rules.
    (name, "//testdata/grammars:%s.g4" % grammar_name, grammar_name, start, flags)
    for name, grammar_name, start, flags in [
        ("plan", "Plan", "expr", "-n 400 -seed 1 -nesting 4 -tokens 200"),
        ("cel", "CEL", "start", "-n 400 -seed 1 -nesting 4 -tokens 200"),
        ("having", "HavingExpression", "query", "-n 400 -seed 1 -nesting 4 -tokens 200"),
        ("grule", "grulev3", "grl", "-n 300 -seed 1 -nesting 3 -tokens 300"),
        # Whitespace is a token, so nodes' tokens are contiguous (GetText takes a slice).
        ("fileseq", "fileseq", "input", "-n 400 -seed 1 -nesting 4 -tokens 60"),
    ]
]]

# A grammar that imports another (`import SemverGrammar;`): ANTLR and galop
# each merge the imported lexer rules into JsonQuery.
convert_test(
    name = "jsonquery",
    grammar = "//testdata/grammars:JsonQuery.g4",
    grammar_name = "JsonQuery",
    imports = ["//testdata/grammars:SemverGrammar.g4"],
    # Spacing is the grammar's own SP token, so tokens are joined with nothing.
    sample_flags = "-n 400 -seed 1 -nesting 4 -tokens 200 -separator ''",
    start = "query",
)
