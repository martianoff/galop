load(":corpus.bzl", "corpus_manifest")

# Every .gala file of the GALA compiler at release 0.92.1 (see MODULE.bazel).
corpus_manifest(
    name = "corpus",
    srcs = ["@gala_corpus//:gala_files"],
    visibility = ["//differential:__subpackages__"],
)

# The held-out corpus (see MODULE.bazel): GALA code galop was not tuned on.
corpus_manifest(
    name = "heldout",
    srcs = [
        "@heldout_gala_server//:gala_files",
        "@heldout_gala_team//:gala_files",
        "@heldout_gala_tui//:gala_files",
    ],
    visibility = ["//differential:__subpackages__"],
)

# Random sentences of gala.g4, written by galop-sample (see //sample): random
# derivations of the grammar with a fixed seed, so every run checks the same
# input. The diff tests compare galop with ANTLR on them and on mutated copies
# of them. `samples` holds many short sentences, `samples_deep` fewer that nest
# expressions four deep and run to 800 tokens, and `samples_large_1` to `_4`
# (for the runs on main) 4,000 in between, in four sets so that each test
# process stays in memory: ANTLR's caches grow with every deep sentence. Deeper nesting makes ANTLR's own prediction
# blow up: at six levels some 2 KB sentences take ANTLR minutes (galop: 0.1 s).
# galop-sample is a source, not a tool, like galop in the genrules that run it
# (see testdata/grammars).
[genrule(
    name = name,
    srcs = [
        "//cmd/galop-sample",
        "//testdata/grammars:gala.g4",
    ],
    outs = [name + ".txt"],
    cmd = "$(location //cmd/galop-sample) %s -o $@ $(location //testdata/grammars:gala.g4)" % flags,
    # Only the large runs on main read the large sets.
    tags = ["manual"] if name.startswith("samples_large") else [],
    visibility = ["//differential:__subpackages__"],
) for name, flags in [
    ("samples", "-n 600 -seed 1 -nesting 2 -tokens 300"),
    ("samples_deep", "-n 200 -seed 2 -nesting 4 -tokens 800"),
] + [
    ("samples_large_%d" % i, "-n 1000 -seed %d -nesting 3 -tokens 600" % (i + 2))
    for i in range(1, 5)
]]
