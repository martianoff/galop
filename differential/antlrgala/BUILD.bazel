load("@rules_go//go:def.bzl", "go_library")

# ANTLR 4.13.1's Go parser for gala.g4: the reference the harness compares
# galop against. Generated at build time and never checked in. ANTLR also
# writes .interp and .tokens files; only the Go sources are kept.
genrule(
    name = "antlr_go",
    srcs = ["//testdata/grammars:gala.g4"],
    outs = [
        "gala_base_listener.go",
        "gala_lexer.go",
        "gala_listener.go",
        "gala_parser.go",
    ],
    cmd = """
        set -e
        out=$(RULEDIR)/antlr_out
        "$(JAVA)" -jar $(location @antlr4_tool//jar) -Dlanguage=Go -Dflavor=antlr -package antlrgala \
            -Xexact-output-dir -o "$$out" $(location //testdata/grammars:gala.g4)
        cp "$$out"/*.go $(RULEDIR)/
        rm -rf "$$out"
    """,
    toolchains = ["@bazel_tools//tools/jdk:current_host_java_runtime"],
    tools = ["@antlr4_tool//jar"],
)

# galop's lexer and parser for gala.g4 (the Go target's antlr flavor), generated at
# build time by the galop CLI built from this repository, like ANTLR's. galop is a
# source, not a tool, so it is built once (see testdata/grammars).
genrule(
    name = "galop_go",
    srcs = [
        "//cmd/galop",
        "//testdata/grammars:gala.g4",
    ],
    outs = [
        "gala_galop_lexer.go",
        "gala_galop_parser.go",
    ],
    cmd = "$(location //cmd/galop) -Dlanguage=Go -Dflavor=antlr -package antlrgala -Xexact-output-dir -o $(RULEDIR) $(location //testdata/grammars:gala.g4)",
)

# The same parser generated with -Xno-brackets, so prediction reads tokens
# only. The mutation tests compare the two on trees and first errors. It must
# live in this package, next to the ANTLR context types it builds, so its names
# are renamed from galaGalop to galaGalopTok: galop has no option for the name
# prefix (it derives it from the grammar name, which also names ANTLR's types),
# and every top-level name in the generated parser starts with that prefix.
genrule(
    name = "galop_tokens_go",
    srcs = [
        "//cmd/galop",
        "//testdata/grammars:gala.g4",
    ],
    outs = ["gala_galop_tokens_parser.go"],
    cmd = """
        set -e
        out=$(RULEDIR)/galop_tokens_out
        $(location //cmd/galop) -Dlanguage=Go -Dflavor=antlr -Xno-brackets -package antlrgala \
            -Xexact-output-dir -o "$$out" $(location //testdata/grammars:gala.g4)
        sed 's/galaGalop/galaGalopTok/g' "$$out"/gala_galop_parser.go > $@
        rm -rf "$$out"
    """,
)

go_library(
    name = "antlrgala",
    srcs = [
        "registry.go",
        ":antlr_go",
        "galop_antlr.go",
        ":galop_go",
        ":galop_tokens_go",
    ],
    importpath = "github.com/martianoff/galop/differential/antlrgala",
    visibility = ["//differential:__subpackages__"],
    deps = ["@com_github_antlr4_go_antlr_v4//:antlr"],
)
